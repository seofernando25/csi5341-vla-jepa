+def _prune_language_mlp(language, calibration, keep: float) -> int:
+    """Drop the language-MLP intermediate neurons with the smallest estimated contribution.
+
+    For neuron ``i`` of layer ``l`` the residual update is
+    ``down[:, i] * silu(gate[i] . x) * (up[i] . x)``.  The calibration's
+    ``linear_inputs`` gives ``E[x_j^2]`` for the gate/up input and ``E[h_i^2]`` for the
+    down-projection input ``h = silu(gate(x)) * up(x)``, so the expected squared
+    contribution is proportional to
+    ``||gate[i] * sqrt(E[x^2])||^2 * ||up[i] * sqrt(E[x^2])||^2 * ||down[:, i] * sqrt(E[h^2])||^2``.
+    Keeping the top ``keep`` fraction by that score removes the neurons that barely move
+    the residual stream on the calibration distribution, and physically shrinks all three
+    projections (so the saved bytes are really gone).
+    """
+    inputs = calibration.get("linear_inputs") or {}
+    if keep >= 1.0 or not inputs:
+        return 0
+    removed = 0
+    for index, layer in enumerate(language.layers):
+        if index in _LANGUAGE_MLP_SKIP:
+            continue
+        mlp = layer.mlp
+        gate, up, down = mlp.gate_proj, mlp.up_proj, mlp.down_proj
+        if not all(isinstance(item, nn.Linear) for item in (gate, up, down)):
+            continue
+        key_gate = f"text.layers.{index}.mlp.gate_proj"
+        key_down = f"text.layers.{index}.mlp.down_proj"
+        if key_gate not in inputs or key_down not in inputs:
+            continue
+        device = gate.weight.device
+        dtype = gate.weight.dtype
+        scale_gate = inputs[key_gate].to(device=device, dtype=torch.float32).clamp_min(1e-12).sqrt()
+        scale_down = inputs[key_down].to(device=device, dtype=torch.float32).clamp_min(1e-12).sqrt()
+        gate_eff = gate.weight.detach().float() * scale_gate.unsqueeze(0)
+        up_eff = up.weight.detach().float() * scale_gate.unsqueeze(0)
+        down_eff = down.weight.detach().float() * scale_down.unsqueeze(0)
+        score = gate_eff.norm(dim=1) * up_eff.norm(dim=1) * down_eff.norm(dim=0)
+        total = int(score.numel())
+        chosen = max(1, int(round(total * keep)))
+        if chosen >= total:
+            continue
+        keep_index = torch.topk(score, chosen, largest=True, sorted=False).indices
+        keep_index, _ = torch.sort(keep_index)
+
+        new_gate = nn.Linear(gate.in_features, chosen, bias=gate.bias is not None, device=device, dtype=dtype)
+        new_gate.weight = nn.Parameter(gate.weight.detach()[keep_index].clone(), requires_grad=False)
+        if gate.bias is not None:
+            new_gate.bias = nn.Parameter(gate.bias.detach()[keep_index].clone(), requires_grad=False)
+        new_up = nn.Linear(up.in_features, chosen, bias=up.bias is not None, device=device, dtype=dtype)
+        new_up.weight = nn.Parameter(up.weight.detach()[keep_index].clone(), requires_grad=False)
+        if up.bias is not None:
+            new_up.bias = nn.Parameter(up.bias.detach()[keep_index].clone(), requires_grad=False)
+        new_down = nn.Linear(chosen, down.out_features, bias=down.bias is not None, device=device, dtype=dtype)
+        new_down.weight = nn.Parameter(down.weight.detach()[:, keep_index].clone(), requires_grad=False)
+        if down.bias is not None:
+            new_down.bias = nn.Parameter(down.bias.detach().clone(), requires_grad=False)
+        mlp.gate_proj = new_gate.eval()
+        mlp.up_proj = new_up.eval()
+        mlp.down_proj = new_down.eval()
+        removed += total - chosen
+        del gate_eff, up_eff, down_eff, score
+    return removed
+
+
