-"""Entry point for a policy change to the VLA-JEPA B16 policy.
+"""Compress the VLA-JEPA B16 policy in place for LIBERO-Spatial inference.
 
-compress(policy, calibration) receives the loaded policy (CUDA, bfloat16, eval mode, no
-gradients) and the frozen calibration dict. It must return an object that still exposes
-select_action and predict_action_chunk. The evaluator measures the returned object and every
-tensor reachable from this module and from modules imported out of the workspace.
+The published policy is loaded in bfloat16 on CUDA.  ``compress`` removes the training-only
+world model, compacts the tied Qwen input embedding to the fixed LIBERO prompts, drops the
+lowest-influence text decoder block, and replaces the large Linear leaves with bitsandbytes
+Q8/Q4 modules.  Q4 is used only for MLP weights and is preceded by activation-aware
+per-input-channel scaling derived from the calibration ``linear_inputs``.
 """
 
 from __future__ import annotations
 
+import gc
+
+import bitsandbytes as bnb
+import torch
+import torch.nn.functional as F
+from torch import nn
+
+# The ten LIBERO-Spatial instructions.  The evaluator's prompts are these strings inside the
+# policy's fixed prompt template; keeping them here lets us build a tiny embedding table.
+INSTRUCTIONS = (
+    "pick up the black bowl between the plate and the ramekin and place it on the plate",
+    "pick up the black bowl next to the ramekin and place it on the plate",
+    "pick up the black bowl from table center and place it on the plate",
+    "pick up the black bowl on the cookie box and place it on the plate",
+    "pick up the black bowl in the top drawer of the wooden cabinet and place it on the plate",
+    "pick up the black bowl on the ramekin and place it on the plate",
+    "pick up the black bowl next to the cookie box and place it on the plate",
+    "pick up the black bowl on the stove and place it on the plate",
+    "pick up the black bowl next to the plate and place it on the plate",
+    "pick up the black bowl on the wooden cabinet and place it on the plate",
+)
+
+TEXT_ATTN_BITS = 4
+TEXT_MLP_BITS = 4
+VISION_ATTN_BITS = 4
+VISION_MLP_BITS = 4
+ACTION_BITS = 4
+AWQ_ALPHA = 0.5
+DROP_TEXT_BLOCKS = (3,)
+MIN_ACTION_WEIGHTS = 500_000
+
+
+class _CompactEmbedding(nn.Module):
+    """Vocabulary embedding with a compact row table and a full-vocabulary id map."""
+
+    def __init__(self, weight: torch.Tensor, id_map: torch.Tensor) -> None:
+        super().__init__()
+        self.weight = nn.Parameter(weight, requires_grad=False)
+        self.register_buffer("_id_map", id_map, persistent=False)
+
+    def forward(self, input_ids: torch.Tensor) -> torch.Tensor:
+        return F.embedding(self._id_map[input_ids].long(), self.weight)
+
+
+class _ScaledLinear(nn.Module):
+    """Divide the input by an activation-aware per-channel scale, then apply a Linear."""
+
+    def __init__(self, linear: nn.Module, scale: torch.Tensor) -> None:
+        super().__init__()
+        self.linear = linear
+        self.register_buffer("_scale", scale, persistent=False)
+
+    def forward(self, x: torch.Tensor) -> torch.Tensor:
+        return self.linear(x / self._scale)
+
+
+def _awq_scale(calibration, key, in_features, alpha, device):
+    """Per-input-channel AWQ scale from the calibration mean-squared inputs."""
+    values = calibration.get("linear_inputs", {}).get(key)
+    if values is None:
+        return None
+    values = values.detach().to(device="cpu", dtype=torch.float32).flatten()
+    if values.numel() != in_features:
+        return None
+    values = values.clamp_min(1e-12)
+    scale = values.pow(alpha)
+    scale = scale / scale.mean().clamp_min(1e-12)
+    scale = scale.clamp(0.02, 50.0)
+    return scale.to(device=device, dtype=torch.bfloat16)
+
+
+def _make_linear(linear: nn.Linear, bits: int, scale, device) -> nn.Module:
+    """Build a bitsandbytes replacement for one Linear leaf."""
+    weight = linear.weight.detach().to(device="cpu", dtype=torch.bfloat16)
+    if scale is not None:
+        weight = (weight.float() * scale.detach().to(device="cpu", dtype=torch.float32)).to(
+            torch.bfloat16
+        )
+    bias = linear.bias
+    if bits == 8:
+        replacement = bnb.nn.Linear8bitLt(
+            linear.in_features,
+            linear.out_features,
+            bias=bias is not None,
+            has_fp16_weights=False,
+            threshold=6.0,
+        )
+        replacement.weight = bnb.nn.Int8Params(
+            weight, requires_grad=False, has_fp16_weights=False
+        )
+    else:
+        replacement = bnb.nn.Linear4bit(
+            linear.in_features,
+            linear.out_features,
+            bias=bias is not None,
+            compute_dtype=torch.bfloat16,
+            compress_statistics=True,
+            quant_type="nf4",
+        )
+        replacement.weight = bnb.nn.Params4bit(
+            weight, requires_grad=False, compress_statistics=True, quant_type="nf4"
+        )
+    if bias is not None:
+        replacement.bias = nn.Parameter(
+            bias.detach().to(device="cpu", dtype=torch.bfloat16), requires_grad=False
+        )
+    replacement = replacement.to(device=device).eval()
+    if scale is not None:
+        replacement = _ScaledLinear(replacement, scale.to(device=device, dtype=torch.bfloat16))
+    return replacement
+
+
+def _quantize_tree(root, prefix, calibration, bits_for, min_weights=0):
+    """Replace every large nn.Linear leaf under ``root`` with a bitsandbytes module."""
+    names = [name for name, module in root.named_modules() if isinstance(module, nn.Linear)]
+    for name in names:
+        parent_name, _, leaf = name.rpartition(".")
+        parent = root.get_submodule(parent_name) if parent_name else root
+        linear = getattr(parent, leaf)
+        if not isinstance(linear, nn.Linear) or linear.weight.numel() < min_weights:
+            continue
+        bits = bits_for(name)
+        if bits not in (4, 8):
+            continue
+        scale = None
+        if bits == 4:
+            scale = _awq_scale(
+                calibration, prefix + name, linear.in_features, AWQ_ALPHA, linear.weight.device
+            )
+        replacement = _make_linear(linear, bits, scale, linear.weight.device)
+        setattr(parent, leaf, replacement)
+        del linear
+
+
+def _compact_embedding(language_model, tokenizer, replace_prompt, embodied_prompt, template, action_ids):
+    """Replace the tied 151936-row embedding with the rows the fixed LIBERO prompts use."""
+    original = language_model.embed_tokens
+    used = set()
+
+    def add_ids(text):
+        used.update(int(i) for i in tokenizer.encode(text, add_special_tokens=False))
+
+    for instruction in INSTRUCTIONS:
+        add_ids(template.format(instruction=instruction, actions=replace_prompt, e_actions=embodied_prompt))
+    try:
+        rendered = tokenizer.apply_chat_template(
+            [{"role": "user", "content": [{"type": "text", "text": "x"}]}],
+            tokenize=False,
+            add_generation_prompt=True,
+        )
+        add_ids(rendered)
+    except Exception:
+        pass
+    used.update(int(i) for i in tokenizer.all_special_ids)
+    used.update(int(i) for i in action_ids)
+    used = sorted(i for i in used if 0 <= i < original.weight.shape[0])
+    if len(used) > 253:
+        raise ValueError("too many prompt token ids for a compact uint8 embedding map")
+
+    device, dtype = original.weight.device, original.weight.dtype
+    weight = torch.empty(len(used) + 1, original.weight.shape[1], device=device, dtype=dtype)
+    weight[0] = original.weight.mean(dim=0)
+    weight[1:] = original.weight[used]
+    id_map = torch.zeros(original.weight.shape[0], dtype=torch.uint8, device=device)
+    id_map[used] = torch.arange(1, len(used) + 1, dtype=torch.uint8, device=device)
+    language_model.embed_tokens = _CompactEmbedding(weight, id_map)
+    del original
+
 
 def compress(policy, calibration):
-    """Return the policy unchanged; the identity keeps the baseline."""
+    model = policy.model
+    qwen = model.qwen.model
+    language_model = qwen.model.language_model
+    visual = qwen.model.visual
+
+    # 1. Training-only world model: never called by predict_action_chunk.
+    model.video_encoder = None
+    model.video_predictor = None
+    model.video_processor = None
+    model.config.enable_world_model = False
+
+    # 2. Compact the tied embedding and remove the unused language-model head.
+    tokenizer = model.qwen.processor.tokenizer
+    _compact_embedding(
+        language_model,
+        tokenizer,
+        model.replace_prompt,
+        model.embodied_replace_prompt,
+        policy.config.prompt_template,
+        list(model.action_token_ids) + [model.embodied_action_token_id],
+    )
+    qwen.lm_head = None
+
+    # 3. Quantize the text decoder while the layer names still match the calibration keys.
+    _quantize_tree(
+        language_model,
+        "text.",
+        calibration,
+        lambda name: TEXT_MLP_BITS if ".mlp." in name else TEXT_ATTN_BITS,
+    )
+
+    # 4. Drop the lowest-influence text decoder block.
+    keep = [
+        layer
+        for index, layer in enumerate(language_model.layers)
+        if index not in DROP_TEXT_BLOCKS
+    ]
+    language_model.layers = nn.ModuleList(keep)
+    del keep
+
+    # 5. Quantize vision and action heads.
+    _quantize_tree(
+        visual,
+        "vision.",
+        calibration,
+        lambda name: VISION_MLP_BITS if ".mlp." in name else VISION_ATTN_BITS,
+    )
+    _quantize_tree(
+        model.action_model,
+        "action.",
+        calibration,
+        lambda name: ACTION_BITS,
+        min_weights=MIN_ACTION_WEIGHTS,
+    )
+
+    gc.collect()
+    torch.cuda.empty_cache()
     return policy
