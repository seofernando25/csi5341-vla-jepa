@@ -0,0 +1,46 @@
+"""Try clearing ShapeEnv.tracked_fakes after compress, then run the evaluator's live walk."""
+
+from __future__ import annotations
+
+import gc
+
+import torch
+
+from evaluation.compression import calibration as calib
+from evaluation.compression.inventory import live_cuda_bytes
+from evaluation.models import load_policy
+
+import solution
+
+
+def check(label):
+    try:
+        print(label, live_cuda_bytes(), flush=True)
+    except Exception as error:  # noqa: BLE001
+        print(label, "FAILED", type(error).__name__, str(error)[:200], flush=True)
+
+
+calib.setup()
+calibration = calib.load()
+policy, _ = load_policy("B16")
+returned = solution.compress(policy, calibration)
+check("after compress")
+
+from torch.fx.experimental.symbolic_shapes import ShapeEnv
+
+count = 0
+for obj in gc.get_objects():
+    if isinstance(obj, ShapeEnv):
+        count += 1
+        try:
+            obj.tracked_fakes = None
+        except Exception:  # noqa: BLE001
+            pass
+print("shape envs", count, flush=True)
+gc.collect()
+check("after shape env clear")
+
+# Also drop Dynamo's frame/guard caches again.
+torch._dynamo.reset()
+gc.collect()
+check("after second dynamo reset")
