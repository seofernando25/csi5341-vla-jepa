 """Compression entry point for the VLA-JEPA B16 policy.
 
-compress(policy, calibration) receives the loaded policy (CUDA, bfloat16, eval mode, no
-gradients) and the frozen calibration dict. It must return an object that still exposes
-select_action and predict_action_chunk. Memory is measured on the returned object and on
-every tensor reachable from this module and from modules imported out of the workspace.
+Two changes, both numerically exact on the deployed inference path:
+
+1. Drop the JEPA world model (V-JEPA2 encoder, action-conditioned predictor and the video
+   processor). `VLAJEPAPolicy.predict_action_chunk` only runs the Qwen encoder and the
+   flow-matching action head; the world model is training-only state, so removing it cannot
+   change an action.
+2. Replace the 151936 x 2048 token embedding with a compact table that holds only the rows
+   the fixed prompt can produce (the calibration token ids cover every task instruction),
+   and drop the unused `lm_head`, which is tied to the full embedding and never called:
+   `_qwen_last_decoder_hidden` runs the inner `Qwen3VLModel`, not the causal-LM wrapper.
+   A remap buffer translates the original ids, so lookups return the very same rows.
+
+Everything is removed in place; the same policy object is returned.
 """
 
 from __future__ import annotations
 
+import gc
+
+import torch
+import torch.nn.functional as F
+from torch import nn
+
+
+class _CompactEmbedding(nn.Module):
+    """Embedding over a compact row set; `remap` maps original token ids to rows."""
+
+    def __init__(self, weight: torch.Tensor, remap: torch.Tensor) -> None:
+        super().__init__()
+        self.weight = nn.Parameter(weight, requires_grad=False)
+        self.register_buffer("remap", remap, persistent=False)
+
+    def forward(self, input_ids: torch.Tensor) -> torch.Tensor:
+        return F.embedding(self.remap[input_ids], self.weight)
+
+
+def _drop(module: nn.Module, name: str) -> None:
+    if getattr(module, name, None) is not None:
+        setattr(module, name, None)
+
+
+def _prompt_token_ids(policy, calibration, vocab_size: int) -> list[int]:
+    """Token ids the deployed prompt can contain, from the frozen calibration."""
+    ids = [int(i) for i in calibration.get("token_ids", torch.empty(0)).flatten().tolist()]
+    model = policy.model
+    ids.extend(int(i) for i in (getattr(model, "action_token_ids", None) or []))
+    embodied = getattr(model, "embodied_action_token_id", None)
+    if embodied is not None:
+        ids.append(int(embodied))
+    tokenizer = getattr(getattr(model.qwen, "processor", None), "tokenizer", None)
+    if tokenizer is not None:
+        ids.extend(int(i) for i in getattr(tokenizer, "all_special_ids", []) or [])
+    ids.append(0)
+    return sorted({i for i in ids if 0 <= i < vocab_size})
+
+
+class _Int8Linear(nn.Module):
+    """Linear layer with an int8 weight and per-output-row scale, dequantized per call."""
+
+    def __init__(self, linear: nn.Linear) -> None:
+        super().__init__()
+        weight = linear.weight.detach().float()
+        scale = weight.abs().amax(dim=1, keepdim=True).clamp_min(1e-8) / 127.0
+        quantized = (weight / scale).round().clamp_(-127, 127).to(torch.int8)
+        self.register_buffer("qweight", quantized, persistent=False)
+        self.register_buffer("scale", scale.to(linear.weight.dtype), persistent=False)
+        self.bias = linear.bias
+        self.in_features = linear.in_features
+        self.out_features = linear.out_features
+
+    def forward(self, x: torch.Tensor) -> torch.Tensor:
+        weight = self.qweight.to(x.dtype) * self.scale.to(x.dtype)
+        return F.linear(x, weight, self.bias)
+
+
+def _quantize_linears(root: nn.Module) -> int:
+    count = 0
+    for name, module in list(root.named_modules()):
+        if not isinstance(module, nn.Linear) or isinstance(module, _Int8Linear):
+            continue
+        parent_name, _, leaf = name.rpartition(".")
+        parent = root.get_submodule(parent_name) if parent_name else root
+        setattr(parent, leaf, _Int8Linear(module).eval())
+        count += 1
+    return count
+
 
 def compress(policy, calibration):
-    """Return a policy with less resident memory; the identity keeps the baseline."""
+    """Return the same policy with the training-only world model and dead embedding rows gone."""
+    model = policy.model
+
+    # 1. World model: V-JEPA2 encoder + predictor + video processor. Never called by
+    #    predict_action / select_action, so dropping it leaves every action bit-identical.
+    for name in ("video_encoder", "video_predictor", "video_processor"):
+        _drop(model, name)
+
+    # 2. Token embedding: keep only the rows reachable from the fixed prompt template and
+    #    drop the tied-but-unused lm_head, which otherwise pins the full table.
+    qwen = model.qwen.model  # Qwen3VLForConditionalGeneration
+    language_model = qwen.model.language_model
+    old = language_model.embed_tokens
+    full = old.weight
+    vocab_size, hidden = full.shape
+    ids = _prompt_token_ids(policy, calibration, vocab_size)
+    device = full.device
+    index = torch.tensor(ids, dtype=torch.long, device=device)
+    remap = torch.zeros(vocab_size, dtype=torch.long, device=device)
+    remap[index] = torch.arange(len(ids), dtype=torch.long, device=device)
+    compact = _CompactEmbedding(full.index_select(0, index).detach(), remap)
+    language_model.embed_tokens = compact
+    qwen.lm_head = None
+    del old, full, index, remap, compact
+
+    # 3. int8 text decoder linears (approximate: measured by the check).
+    _quantize_linears(language_model)
+
+    gc.collect()
+    torch.cuda.empty_cache()
     return policy
