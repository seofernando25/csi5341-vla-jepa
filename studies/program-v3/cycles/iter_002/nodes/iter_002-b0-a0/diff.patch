-"""Entry point for a policy change to the VLA-JEPA B16 policy.
-
-compress(policy, calibration) receives the loaded policy (CUDA, bfloat16, eval mode, no
-gradients) and the frozen calibration dict. It must return an object that still exposes
-select_action and predict_action_chunk. The evaluator measures the returned object and every
-tensor reachable from this module and from modules imported out of the workspace.
-"""
+"""In-place compression for the VLA-JEPA B16 LIBERO policy (Q8 experiment)."""
 
 from __future__ import annotations
 
+import torch
+import torch.nn.functional as F
+from torch import nn
+
+_TOKEN_IDS = (
+    13, 198, 220, 279, 304, 311, 315, 323, 373, 374, 389, 432, 435, 504, 705, 872,
+    1790, 1909, 1948, 1965, 1992, 3383, 3691, 3735, 3745, 4126, 4842, 6168, 7771,
+    7989, 8193, 11968, 12159, 12544, 14087, 19212, 21921, 22360, 26482, 29195,
+    35915, 44015, 62658, 77091, 151644, 151645, 151652, 151653, 151655, 151669,
+    151670, 151671, 151697,
+)
+
+
+class _CompactEmbedding(torch.nn.Module):
+    def __init__(self, weight: torch.Tensor, mapping: torch.Tensor) -> None:
+        super().__init__()
+        self.weight = torch.nn.Parameter(weight, requires_grad=False)
+        self.register_buffer("mapping", mapping, persistent=False)
+
+    def forward(self, input_ids: torch.Tensor) -> torch.Tensor:
+        return F.embedding(self.mapping[input_ids], self.weight)
+
+
+def _quantize_q8(decoder):
+    import bitsandbytes as bnb
+
+    converted = []
+    for name, linear in list(decoder.named_modules()):
+        if not isinstance(linear, nn.Linear):
+            continue
+        parent_name, _, leaf = name.rpartition(".")
+        parent = decoder.get_submodule(parent_name) if parent_name else decoder
+        weight = linear.weight.detach().cpu()
+        replacement = bnb.nn.Linear8bitLt(
+            linear.in_features,
+            linear.out_features,
+            bias=linear.bias is not None,
+            has_fp16_weights=False,
+            threshold=6.0,
+        )
+        replacement.weight = bnb.nn.Int8Params(
+            weight, requires_grad=False, has_fp16_weights=False
+        )
+        if linear.bias is not None:
+            replacement.bias = nn.Parameter(linear.bias.detach().cpu(), requires_grad=False)
+        replacement = replacement.to(device=linear.weight.device).eval()
+        setattr(parent, leaf, replacement)
+        converted.append(name)
+    return converted
+
 
 def compress(policy, calibration):
-    """Return the policy unchanged; the identity keeps the baseline."""
+    model = policy.model
+    for name in ("video_encoder", "video_predictor", "video_processor"):
+        if getattr(model, name, None) is not None:
+            setattr(model, name, None)
+
+    language_model = model.qwen.model.model.language_model
+    old_embedding = language_model.embed_tokens
+    old_weight = old_embedding.weight.detach()
+    ids = torch.tensor(_TOKEN_IDS, dtype=torch.long, device=old_weight.device)
+    rows = old_weight.index_select(0, ids).clone()
+    fallback = rows.float().mean(dim=0, keepdim=True).to(old_weight.dtype)
+    compact_weight = torch.cat((rows, fallback), dim=0)
+    mapping = torch.full(
+        (old_weight.shape[0],), len(ids), dtype=torch.long, device=old_weight.device
+    )
+    mapping[ids] = torch.arange(len(ids), dtype=torch.long, device=old_weight.device)
+    language_model.embed_tokens = _CompactEmbedding(compact_weight, mapping)
+    model.qwen.model.lm_head = None
+    del old_embedding, old_weight, rows, fallback
+
+    _quantize_q8(language_model)
+    _quantize_q8(model.qwen.model.model.visual)
+
+    # Drop one low-influence decoder block (block 3 has the smallest measured
+    # residual influence in the calibration).
+    language_model.layers = torch.nn.ModuleList(
+        layer for index, layer in enumerate(language_model.layers) if index != 3
+    )
+
+    torch.cuda.empty_cache()
     return policy
