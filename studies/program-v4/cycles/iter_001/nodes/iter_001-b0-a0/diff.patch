 """Entry point for a policy change to the VLA-JEPA B16 policy.
 
-compress(policy, calibration) receives the loaded policy (CUDA, bfloat16, eval mode, no
-gradients) and the frozen calibration dict. It must return an object that still exposes
-select_action and predict_action_chunk. The evaluator measures the returned object and every
-tensor reachable from this module and from modules imported out of the workspace.
+The stock inference path launches thousands of small kernels and synchronizes with the host
+inside the vision tower and decoder mask code, so one observation-to-action call is launch bound.
+`fastpath.GraphedPolicy` precomputes the instruction-dependent constants, composes the same
+sub-modules without host synchronization and replays one captured CUDA graph per instruction.
+With `use_compile=False` the graph reproduces the stock forward exactly (verified bit for bit on
+bank frames from every task), so the equivalence, arm-action, perturbation and episode-success
+guards see the untouched policy; only the launch overhead is removed.
+
+The V-JEPA world model and the tied vocabulary output head are never called by inference. They
+are dropped so the candidate's peak CUDA stays below the reference's, which includes them.
 """
 
 from __future__ import annotations
 
+import torch
+
+from fastpath import GraphedPolicy
+
 
 def compress(policy, calibration):
-    """Return the policy unchanged; the identity keeps the baseline."""
+    """Drop inference-dead modules, then route prediction through captured CUDA graphs."""
+    model = policy.model
+    model.video_encoder = None
+    model.video_predictor = None
+    model.video_processor = None
+    # The policy calls the inner Qwen3VLModel, never the conditional-generation wrapper, so the
+    # vocabulary output head is dead at inference. Identity keeps the attribute well formed.
+    policy.model.qwen.model.lm_head = torch.nn.Identity()
+    graphed = GraphedPolicy(policy, use_compile=False, dense=True)
+    policy.predict_action_chunk = graphed.predict_action_chunk
+    policy.graphed = graphed
     return policy
