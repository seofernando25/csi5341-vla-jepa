+class PackedInt2(nn.Module):
+    """Groupwise affine int2 with real 2-bit packing, dequantized per forward.
+
+    Four consecutive input columns are packed into one uint8 byte.  Stored weight is
+    1/4 byte per parameter.
+    """
+
+    def __init__(self, source, values, scales, zeros, group_size=128, input_scale=None):
+        super().__init__()
+        self.in_features = source.in_features
+        self.out_features = source.out_features
+        self.group_size = group_size
+        q = values.to(torch.uint8).reshape(self.out_features, self.in_features // 4, 4)
+        q0, q1, q2, q3 = (q[..., i].to(torch.int16) for i in range(4))
+        packed = ((q0 << 6) | (q1 << 4) | (q2 << 2) | q3).to(torch.uint8)
+        self.register_buffer("packed_weight", packed.contiguous())
+        self.register_buffer("scales", scales.to(torch.bfloat16))
+        # Zero points are small integers; uint8 is exact and half the bytes of bf16.
+        self.register_buffer("zeros", zeros.to(torch.uint8))
+        self.bias = (
+            nn.Parameter(source.bias.detach().clone(), requires_grad=False)
+            if source.bias is not None
+            else None
+        )
+        if input_scale is not None:
+            self.register_buffer("input_scale", input_scale.to(torch.bfloat16))
+        else:
+            self.input_scale = None
+
+    def _unpack(self):
+        b = self.packed_weight.reshape(self.out_features, self.in_features // 4, 1)
+        b = b[..., 0].to(torch.int16)
+        q0 = (b >> 6) & 3
+        q1 = (b >> 4) & 3
+        q2 = (b >> 2) & 3
+        q3 = b & 3
+        return torch.stack((q0, q1, q2, q3), dim=-1).reshape(
+            self.out_features, self.in_features
+        )
+
+    def forward(self, x):
+        if self.input_scale is not None:
+            x = x / self.input_scale
+        q = self._unpack().to(torch.bfloat16)
+        groups = self.in_features // self.group_size
+        scale = self.scales[:, :groups].repeat_interleave(self.group_size, dim=1)
+        zero = self.zeros[:, :groups].to(torch.bfloat16).repeat_interleave(
+            self.group_size, dim=1
+        )
         weight = (q - zero) * scale
         return F.linear(x.to(torch.bfloat16), weight, self.bias)
 
 
