+    # Alias for backward compatibility
+    PYTORCH_BACKPROP = "forward_pytorch_backprop"
+    PYTORCH_BACKPROP_COMPILE = "forward_pytorch_backprop_compile"
+    ATEN_BACKPROP = "forward_aten_backprop"
