+# Packed 3-bit quantization.  `_CODEBOOK_3` is the 8-level normal-quantile codebook
+# normalized to [-1, 1]; it keeps an exact zero, which the k-means codebooks did not.
+_PACK_BITS = 3
+_PACK_GROUP = 64
+_PACK_CHUNK = 256
+_CODEBOOK_3 = (
+    -1.0,
+    -0.478629,
+    -0.217142,
+    0.0,
+    0.16093,
+    0.337915,
+    0.562617,
+    1.0,
+)
+# Shapes of the text MLP projections (gate/up and down).
+_PACK_TEXT_MLP = {(6144, 2048), (2048, 6144)}
+# Shapes of the action DiT attention and feed-forward projections.
+_PACK_ACTION = {(3072, 768), (768, 3072), (768, 768)}
+_PACK_ACTION_ENABLED = True
+
