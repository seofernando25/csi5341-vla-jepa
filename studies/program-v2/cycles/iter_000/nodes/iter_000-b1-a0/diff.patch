-"""Compression entry point for the VLA-JEPA B16 policy.
+"""In-place compression for the VLA-JEPA LIBERO policy.
 
-compress(policy, calibration) receives the loaded policy (CUDA, bfloat16, eval mode, no
-gradients) and the frozen calibration dict. It must return an object that still exposes
-select_action and predict_action_chunk. Memory is measured on the returned object and on
-every tensor reachable from this module and from modules imported out of the workspace.
+Exact trims (the deployed inference path never touches these):
+  * drop the V-JEPA2 world model (`video_encoder`, `video_predictor`, `video_processor`),
+  * keep only the prompt-token rows of the text embedding and drop the tied `lm_head`.
+
+Approximate (weights only, activations stay bf16):
+  * text decoder, vision tower and action head: groupwise INT4 packed with the Ampere
+    tinygemm kernel (`torch._weight_int4pack_mm`), using an activation-aware
+    per-input-channel scale derived from the frozen calibration.
+
+Tiny linears (<64K elements, e.g. the 7-wide decoder) keep their bf16 weights.
+
+Everything is rewritten in place on the same policy object; no bf16 copy is kept.
 """
 
 from __future__ import annotations
 
+import gc
+
+import torch
+from torch import nn
+from torch.nn import functional as F
+
+# ---- scheme knobs ---------------------------------------------------------
+TEXT_BITS = 4  # 4 (tinygemm int4) or 8 (row-wise int8)
+VISION_BITS = 4
+ACTION_BITS = 4
+GROUP = 128
+ALPHA = 0.5  # activation-aware smoothing exponent
+MIN_ELEMENTS = 1 << 16  # leave tiny linears alone
+
+
+def _empty_cache() -> None:
+    gc.collect()
+    if torch.cuda.is_available():
+        torch.cuda.empty_cache()
+
+
+def _smooth(weight: torch.Tensor, activation: torch.Tensor | None) -> torch.Tensor | None:
+    """AWQ-style per-input-channel scale from the calibration mean squared input."""
+    if activation is None or ALPHA <= 0:
+        return None
+    energy = activation.to(weight.device, torch.float32).clamp_min(1e-12)
+    scale = energy.pow(ALPHA)
+    return scale / (scale.amin() * scale.amax()).sqrt().clamp_min(1e-12)
+
+
+class _Int8Linear(nn.Module):
+    """Row-wise symmetric INT8 weight, dequantized one layer at a time."""
+
+    def __init__(self, source: nn.Linear, activation: torch.Tensor | None) -> None:
+        super().__init__()
+        self.in_features, self.out_features = source.in_features, source.out_features
+        weight = source.weight.detach().float()
+        smooth = _smooth(weight, activation)
+        if smooth is not None:
+            weight = weight * smooth[None, :]
+        scale = weight.abs().amax(1).clamp_min(1e-12) / 127.0
+        quantized = (weight / scale[:, None]).round().clamp_(-127, 127).to(torch.int8)
+        self.register_buffer("q", quantized)
+        self.register_buffer("scale", scale.to(torch.bfloat16))
+        if smooth is not None:
+            self.register_buffer("inv_smooth", (1.0 / smooth).to(torch.bfloat16))
+        else:
+            self.inv_smooth = None
+        self.bias = (
+            nn.Parameter(source.bias.detach().clone(), requires_grad=False)
+            if source.bias is not None
+            else None
+        )
+
+    def forward(self, x: torch.Tensor) -> torch.Tensor:
+        weight = self.q.to(torch.bfloat16) * self.scale[:, None]
+        if self.inv_smooth is not None:
+            weight = weight * self.inv_smooth[None, :]
+        return F.linear(x, weight, self.bias)
+
+
+class _Int4Linear(nn.Module):
+    """Groupwise affine INT4 packed for `torch._weight_int4pack_mm` (tinygemm)."""
+
+    def __init__(self, source: nn.Linear, activation: torch.Tensor | None) -> None:
+        super().__init__()
+        self.in_features, self.out_features = source.in_features, source.out_features
+        self.group_size = GROUP
+        weight = source.weight.detach().float()
+        smooth = _smooth(weight, activation)
+        if smooth is not None:
+            weight = weight * smooth[None, :]
+        rows, columns = weight.shape
+        groups = weight.reshape(rows, -1, GROUP)
+        low = groups.amin(-1)
+        high = groups.amax(-1)
+        scale = ((high - low) / 15).clamp_min(1e-12)
+        zero_q = (-low / scale).round().clamp(0, 15)
+        q = (
+            (groups / scale[..., None] + zero_q[..., None])
+            .round()
+            .clamp_(0, 15)
+            .to(torch.uint8)
+            .reshape(rows, columns)
+        )
+        packed = ((q[:, ::2] << 4) | q[:, 1::2]).contiguous()
+        self.register_buffer("packed", torch._convert_weight_to_int4pack(packed, 8))
+        # tinygemm dequantizes as (q - 8) * scale + zero, so store the real-valued zero.
+        scales_zeros = (
+            torch.stack((scale, scale * (8 - zero_q)), -1)
+            .transpose(0, 1)
+            .contiguous()
+            .to(torch.bfloat16)
+        )
+        self.register_buffer("scales_zeros", scales_zeros)
+        if smooth is not None:
+            self.register_buffer("inv_smooth", (1.0 / smooth).to(torch.bfloat16))
+        else:
+            self.inv_smooth = None
+        self.bias = (
+            nn.Parameter(source.bias.detach().clone(), requires_grad=False)
+            if source.bias is not None
+            else None
+        )
+
+    def forward(self, x: torch.Tensor) -> torch.Tensor:
+        shape = x.shape[:-1]
+        flat = x.reshape(-1, self.in_features)
+        if self.inv_smooth is not None:
+            flat = flat * self.inv_smooth
+        out = torch._weight_int4pack_mm(
+            flat.to(torch.bfloat16), self.packed, self.group_size, self.scales_zeros
+        )
+        out = out.reshape(*shape, self.out_features)
+        return out if self.bias is None else out + self.bias
+
+
+class _CompactEmbedding(nn.Module):
+    """Only the prompt token rows; a small lookup maps original ids to compact rows."""
+
+    def __init__(self, source: nn.Embedding, token_ids: torch.Tensor) -> None:
+        super().__init__()
+        device = source.weight.device
+        ids = torch.unique(token_ids.to(device)).sort().values
+        lookup = torch.full(
+            (source.num_embeddings,), -1, dtype=torch.int32, device=device
+        )
+        lookup[ids] = torch.arange(len(ids), device=device, dtype=torch.int32)
+        self.register_buffer("lookup", lookup)
+        self.weight = nn.Parameter(source.weight.detach()[ids].clone(), requires_grad=False)
+        self.num_embeddings, self.embedding_dim = self.weight.shape
+
+    def forward(self, ids: torch.Tensor) -> torch.Tensor:
+        mapped = self.lookup[ids].long().clamp_min(0)
+        return F.embedding(mapped, self.weight)
+
+
+def _quantize_root(root: nn.Module, prefix: str, bits: int, linear_inputs: dict) -> int:
+    """Replace every nn.Linear leaf of `root`; returns the number converted."""
+    snapshot = [(name, module) for name, module in root.named_modules() if isinstance(module, nn.Linear)]
+    converted = 0
+    for name, module in snapshot:
+        if module.in_features * module.out_features < MIN_ELEMENTS:
+            continue
+        key = f"{prefix}.{name}"
+        activation = linear_inputs.get(key)
+        if bits == 4:
+            if module.in_features % GROUP or module.out_features % 8:
+                replacement = _Int8Linear(module, activation)
+            else:
+                replacement = _Int4Linear(module, activation)
+        elif bits == 8:
+            replacement = _Int8Linear(module, activation)
+        else:
+            continue
+        parent_name, _, leaf = name.rpartition(".")
+        parent = root.get_submodule(parent_name) if parent_name else root
+        setattr(parent, leaf, replacement)
+        converted += 1
+    del snapshot
+    return converted
+
 
 def compress(policy, calibration):
-    """Return a policy with less resident memory; the identity keeps the baseline."""
+    """Shrink the loaded policy in place and return the same object."""
+    model = policy.model
+    inner = model.qwen.model.model  # Qwen3VLModel
+    text = inner.language_model
+    vision = inner.visual
+    action = model.action_model
+
+    # 1. World model is training-only.
+    model.video_encoder = None
+    model.video_predictor = None
+    model.video_processor = None
+    _empty_cache()
+
+    # 2. Drop the tied vocabulary head before compacting the shared embedding table.
+    model.qwen.model.lm_head = nn.Identity()
+    text.embed_tokens = _CompactEmbedding(text.embed_tokens, calibration["token_ids"])
+    _empty_cache()
+
+    # 3. Weight-only quantization of the deployed graph.
+    inputs = calibration["linear_inputs"]
+    with torch.inference_mode():
+        _quantize_root(text, "text", TEXT_BITS, inputs)
+        _empty_cache()
+        _quantize_root(vision, "vision", VISION_BITS, inputs)
+        _empty_cache()
+        _quantize_root(action, "action", ACTION_BITS, inputs)
+    _empty_cache()
     return policy
