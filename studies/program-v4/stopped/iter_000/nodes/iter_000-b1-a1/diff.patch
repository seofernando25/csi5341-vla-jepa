+"""Probe: how much of the task-0 model can be dropped while staying inside the arm guard."""
+from __future__ import annotations
+
+import statistics
+import time
+
+import torch
+
+from evaluation.compression import calibration as calib
+from evaluation.compression.latency_timing import FrameCollector
+from evaluation.models import load_policy
+from evaluation.pipeline import Pipeline, inference_autocast, observation_bank
+from evaluation.rollout import rollout
+import fastpath_local
+
+
+def seeded_chunk(policy, batch, seed):
+    policy.reset()
+    torch.manual_seed(seed)
+    with torch.inference_mode(), inference_autocast():
+        return policy.predict_action_chunk(batch).float().clone()
+
+
+def main():
+    calib.setup()
+    bank = observation_bank()
+    policy, _ = load_policy("B16")
+    pipeline = Pipeline(policy)
+    collector = FrameCollector(70, 4)
+    started = time.time()
+    out_dir = __import__("pathlib").Path("/tmp/work/.probe3")
+    out_dir.mkdir(parents=True, exist_ok=True)
+    summary = rollout("probe", [0], "development", 1, policy, pipeline, out_dir, trace=collector)
+    print("episode", summary, "seconds", round(time.time() - started, 1), "frames", len(collector.frames))
+    frames = collector.frames
+    # reference arm actions on frames 8..39
+    ref = []
+    for i in range(32):
+        ref.append(seeded_chunk(policy, frames[8 + i], 1000 + 8 + i))
+    ref_phys = [pipeline.post(x.clone()).float() for x in ref]
+
+    # plan for task 0
+    fastpath_local.attach(policy, max_plans=1)
+    g = policy.graphed
+    inputs = policy._prepare_model_inputs(frames[0], training=False)
+    plan = g._plan(inputs["instructions"][0], inputs["images"][0], inputs["state"])
+
+    # original modules
+    dec_layers = g.decoder.layers
+    vis_blocks = g.vision.blocks
+    head_blocks = g.head.model.transformer_blocks
+    head_steps = g.head.num_inference_timesteps
+
+    def set_config(dl, vb, hb, steps):
+        g.decoder.layers = dec_layers[:dl]
+        g.vision.blocks = vis_blocks[:vb]
+        g.head.model.transformer_blocks = head_blocks[:hb]
+        g.head.num_inference_timesteps = steps
+
+    def run_body(batch, seed):
+        with torch.inference_mode(), torch.autocast("cuda", dtype=torch.bfloat16):
+            inp = policy._prepare_model_inputs(batch, training=False)
+            plan.images.copy_(torch.stack(inp["images"][0]))
+            plan.state.copy_(inp["state"])
+            torch.manual_seed(seed)
+            plan.noise.copy_(
+                torch.randn(
+                    1,
+                    plan.noise.shape[1],
+                    plan.noise.shape[2],
+                    dtype=torch.float32,
+                    device=plan.noise.device,
+                )
+            )
+            return g._body(plan).float().clone()
+
+    configs = [
+        (28, 24, 16, 4),
+        (20, 24, 16, 4),
+        (14, 24, 16, 4),
+        (10, 24, 16, 4),
+        (7, 24, 16, 4),
+        (14, 12, 16, 4),
+        (14, 16, 16, 4),
+        (10, 12, 16, 4),
+        (14, 12, 8, 4),
+        (14, 12, 8, 1),
+        (10, 12, 8, 1),
+        (7, 12, 8, 1),
+    ]
+    results = {}
+    for cfg in configs:
+        set_config(*cfg)
+        arms = []
+        maxdiff = []
+        for i in range(32):
+            out = run_body(frames[8 + i], 1000 + 8 + i)
+            phys = pipeline.post(out.clone()).float()
+            arms.append(float((phys[..., :6] - ref_phys[i][..., :6]).square().mean()))
+            maxdiff.append(float((phys - ref_phys[i]).abs().max()))
+        # observation spread on frames 0..7
+        acts = []
+        for i in range(8):
+            acts.append(run_body(frames[i], 1000 + i).flatten())
+        spread = 0.0
+        for a in range(8):
+            for b in range(a + 1, 8):
+                spread = max(spread, float((acts[a] - acts[b]).abs().max()))
+        # perturbation on bank index 0 (task 0)
+        from evaluation.compression.latency_guards import perturbation_pairs, perturbation_deltas
+        pairs = perturbation_pairs(bank, [0], 8, 1000 + 7000)
+        orig = pipeline.sample(pairs[0][0])
+        pert = pipeline.sample(pairs[0][1])
+        before = seeded_chunk(policy, orig, 1000 + 900)
+        after = seeded_chunk(policy, pert, 1000 + 900)
+        ref_delta = (pipeline.post(after.clone()).float() - pipeline.post(before.clone()).float()).flatten()
+        # candidate deltas via body
+        def body_chunk(batch, seed):
+            return run_body(batch, seed)
+        cb = body_chunk(orig, 1000 + 900)
+        ca = body_chunk(pert, 1000 + 900)
+        cand_delta = (pipeline.post(ca.clone()).float() - pipeline.post(cb.clone()).float()).flatten()
+        l = ref_delta.double() - ref_delta.double().mean()
+        r = cand_delta.double() - cand_delta.double().mean()
+        corr = float((l * r).sum() / (l.norm() * r.norm()))
+        results[cfg] = (statistics.fmean(arms), max(arms), max(maxdiff), spread, corr)
+        print(
+            f"cfg dec{cfg[0]} vis{cfg[1]} head{cfg[2]} steps{cfg[3]}: "
+            f"arm mean {statistics.fmean(arms):.5f} max {max(arms):.5f} "
+            f"maxdiff {max(maxdiff):.4f} spread {spread:.4f} corr {corr:.3f}",
+            flush=True,
+        )
+    set_config(28, 24, 16, 4)
+
+
+if __name__ == "__main__":
+    main()
