+"""Timing and accuracy of graph + pruning/quantization variants."""
+
+import collections
+import time
+
+import torch
+
+from evaluation.compression import calibration as calib
+from evaluation.compression.topology import SkipBlock, blocks, replace, selected_linears
+from evaluation.models import load_policy
+from evaluation.pipeline import Pipeline, observation_bank
+from evaluation.fastpath import GraphedPolicy
+
+
+def physical(pipeline, chunk):
+    return pipeline.post(chunk.float().clone()).float()[..., :6]
+
+
+def main():
+    calib.setup()
+    torch.manual_seed(0)
+    bank = observation_bank()
+    refs = torch.load(calib.REFERENCES, weights_only=True)
+    policy, _ = load_policy("B16")
+    pipeline = Pipeline(policy)
+    indices = []
+    seen = collections.Counter()
+    for i, sample in enumerate(bank):
+        task = sample["task_id"]
+        seen[task] += 1
+        if 2 < seen[task] <= 5:
+            indices.append(i)
+
+    text_blocks = blocks(policy, "text")
+    vision_blocks = blocks(policy, "vision")
+    originals_text = list(text_blocks)
+    originals_vision = list(vision_blocks)
+    text_linears = selected_linears(policy, "text")
+    saved_linears = {k: (root, name, module) for k, (root, name, module) in text_linears.items()}
+
+    def restore():
+        for i, b in enumerate(originals_text):
+            text_blocks[i] = b
+        for i, b in enumerate(originals_vision):
+            vision_blocks[i] = b
+        for key, (root, name, module) in saved_linears.items():
+            replace(root, name, module)
+        policy.model.action_model.num_inference_timesteps = 4
+        policy.graphed = None
+        torch.cuda.empty_cache()
+
+    def skip(which, indices_to_skip):
+        target = text_blocks if which == "text" else vision_blocks
+        for i in indices_to_skip:
+            target[i] = SkipBlock()
+
+    def int4_text(group=128):
+        from evaluation.compression.quantization import PackedInt4, affine_quantize
+
+        for key, (root, name, linear) in selected_linears(policy, "text").items():
+            values, scales, zeros, _ = affine_quantize(linear.weight.detach(), group)
+            replace(root, name, PackedInt4(linear, values, scales, zeros, group))
+
+    def evaluate(name, use_compile=False):
+        started = time.perf_counter()
+        graphed = GraphedPolicy(policy, use_compile=use_compile, dense=True)
+        policy.predict_action_chunk = graphed.predict_action_chunk
+        # accuracy on bank frames
+        errs = collections.defaultdict(list)
+        maxdiff = 0.0
+        with torch.inference_mode(), torch.autocast("cuda", dtype=torch.bfloat16):
+            for index in indices:
+                policy.reset()
+                torch.manual_seed(1000 + index)
+                out = policy.predict_action_chunk(pipeline.sample(bank[index])).float()
+                ref = refs[index : index + 1].to("cuda")
+                errs[bank[index]["task_id"]].append(
+                    float((physical(pipeline, out) - physical(pipeline, ref)).square().mean())
+                )
+                maxdiff = max(maxdiff, float((out - ref).abs().max()))
+        # timing on the first instruction
+        instruction = bank[indices[0]]["instruction"]
+        plan = graphed.plans[instruction]
+        warm = bank[indices[0]]
+        batch = pipeline.sample(warm)
+        for _ in range(10):
+            policy.reset()
+            torch.manual_seed(1234)
+            policy.select_action(batch)
+        torch.cuda.synchronize()
+        start = torch.cuda.Event(enable_timing=True)
+        end = torch.cuda.Event(enable_timing=True)
+        start.record()
+        for _ in range(50):
+            policy.reset()
+            torch.manual_seed(1234)
+            policy.select_action(batch)
+        end.record()
+        torch.cuda.synchronize()
+        ms = start.elapsed_time(end) / 50
+        worst = max(sum(v) / len(v) for v in errs.values())
+        print(
+            f"{name:34s} ms {ms:7.2f} worst {worst:.6f} maxdiff {maxdiff:.4f} "
+            f"total {time.perf_counter()-started:.1f}s",
+            flush=True,
+        )
+        print("   ", " ".join(f"{t}:{sum(v)/len(v):.4f}" for t, v in sorted(errs.items())), flush=True)
+        return ms
+
+    variants = []
+    variants.append(("stock", lambda: None, False))
+    variants.append(("flow2", lambda: setattr(policy.model.action_model, "num_inference_timesteps", 2), False))
+    variants.append(("vision_skip_16_22", lambda: skip("vision", range(16, 23)), False))
+    variants.append(("int4_text", lambda: int4_text(), False))
+    variants.append(("int4_text_flow2_vision", lambda: (int4_text(), setattr(policy.model.action_model, "num_inference_timesteps", 2), skip("vision", range(16, 23))), False))
+    variants.append(("stock_compile", lambda: None, True))
+    variants.append(("int4_text_compile", lambda: int4_text(), True))
+
+    for name, apply, compiled in variants:
+        restore()
+        apply()
+        try:
+            evaluate(name, compiled)
+        except Exception as error:
+            print(f"{name}: FAILED {type(error).__name__}: {error}", flush=True)
+        finally:
+            restore()
+
+
+if __name__ == "__main__":
+    main()
