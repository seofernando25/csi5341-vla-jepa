+"""Experiment: exact unused-module removal + compact embedding; verify bit-exact outputs."""
+import gc
+import sys
+
+import torch
+from torch import nn
+import torch.nn.functional as F
+
+from evaluation.compression import calibration as calib
+from evaluation.compression.inventory import ResidentWalk, live_cuda_bytes
+from evaluation.models import load_policy
+from evaluation.pipeline import Pipeline, observation_bank
+
+calib.setup()
+policy, meta = load_policy("B16")
+calibration = calib.load()
+bank = observation_bank()
+pipeline = Pipeline(policy)
+print("loaded", flush=True)
+
+# --- which modules are called during predict_action_chunk ---
+called = set()
+handles = []
+for name, module in policy.named_modules():
+    def hook(m, args, kwargs, output, _name=name):
+        called.add(_name)
+    handles.append(module.register_forward_hook(hook, with_kwargs=True))
+
+with torch.inference_mode(), torch.autocast("cuda", dtype=torch.bfloat16):
+    policy.reset()
+    torch.manual_seed(1000)
+    out = policy.predict_action_chunk(pipeline.sample(bank[0]))
+for h in handles:
+    h.remove()
+leaf_names = [n for n, m in policy.named_modules() if not list(m.children())]
+uncalled = [n for n in leaf_names if n not in called and n != ""]
+print("leaf modules:", len(leaf_names), "uncalled leaves:", len(uncalled), flush=True)
+for n in uncalled[:80]:
+    print("  uncalled:", n, flush=True)
+
+# --- token id coverage ---
+cal_ids = set(int(x) for x in calibration["token_ids"].flatten().tolist())
+used = set()
+from evaluation.core_benchmark import prepared_inputs
+with torch.inference_mode():
+    for i, sample in enumerate(bank):
+        enc, _ = prepared_inputs(policy, pipeline.sample(sample))
+        used.update(int(x) for x in enc["input_ids"].detach().cpu().flatten().tolist())
+print("cal ids", len(cal_ids), "bank used ids", len(used), "missing", len(used - cal_ids), flush=True)
+print("missing ids", sorted(used - cal_ids)[:50], flush=True)
+
+# --- reference outputs on a spread of samples ---
+refs = {}
+with torch.inference_mode(), torch.autocast("cuda", dtype=torch.bfloat16):
+    for index in [0, 7, 13, 21, 34, 48, 55, 66, 79, 91]:
+        policy.reset()
+        torch.manual_seed(1000 + index)
+        refs[index] = policy.predict_action_chunk(pipeline.sample(bank[index])).clone()
+print("refs done", flush=True)
+
+
+class CompactEmbedding(nn.Module):
+    def __init__(self, source, ids):
+        super().__init__()
+        ids = torch.unique(ids.to(source.weight.device)).sort().values
+        lookup = torch.full((source.num_embeddings,), -1, device=ids.device, dtype=torch.int32)
+        lookup[ids] = torch.arange(len(ids), device=ids.device, dtype=torch.int32)
+        self.register_buffer("lookup", lookup)
+        self.register_buffer("original_ids", ids)
+        self.weight = nn.Parameter(source.weight.detach()[ids].clone(), requires_grad=False)
+        self.num_embeddings, self.embedding_dim = self.weight.shape
+
+    def forward(self, ids):
+        mapped = self.lookup[ids].long()
+        if bool((mapped < 0).any()):
+            raise ValueError("Unseen token ID")
+        return F.embedding(mapped, self.weight)
+
+
+def walk_bytes(root, extra=()):
+    walk = ResidentWalk("cuda")
+    walk.add(root, *extra)
+    return walk.nbytes, walk.violations
+
+b0, v0 = walk_bytes(policy)
+print("before walk bytes", b0 / 1e6, "MB violations", len(v0), flush=True)
+print("before live cuda", live_cuda_bytes() / 1e6, "MB", flush=True)
+
+# --- surgery ---
+policy.model.video_encoder = None
+policy.model.video_predictor = None
+policy.model.video_processor = None
+lm = policy.model.qwen.model.lm_head
+emb = policy.model.qwen.model.model.language_model.embed_tokens
+policy.model.qwen.model.lm_head = None
+policy.model.qwen.model.model.language_model.embed_tokens = CompactEmbedding(emb, calibration["token_ids"])
+del lm, emb
+gc.collect()
+torch.cuda.empty_cache()
+
+b1, v1 = walk_bytes(policy)
+print("after walk bytes", b1 / 1e6, "MB violations", len(v1), flush=True)
+print("after live cuda", live_cuda_bytes() / 1e6, "MB", flush=True)
+
+# --- equivalence ---
+maxdiff = 0.0
+with torch.inference_mode(), torch.autocast("cuda", dtype=torch.bfloat16):
+    for index, ref in refs.items():
+        policy.reset()
+        torch.manual_seed(1000 + index)
+        out = policy.predict_action_chunk(pipeline.sample(bank[index]))
+        diff = (out - ref).abs().max().item()
+        maxdiff = max(maxdiff, diff)
+        print("index", index, "maxdiff", diff, "exact", torch.equal(out, ref), flush=True)
+print("MAXDIFF", maxdiff, flush=True)
