+def _quantize_text(policy) -> None:
+    """NF4 for the text decoder, packed 2/3-bit for the projections that tolerate it."""
+    language_model = policy.model.qwen.model.model.language_model
+    for layer in language_model.layers:
+        for path in (
+            "self_attn.q_proj",
+            "self_attn.k_proj",
+            "self_attn.v_proj",
+            "self_attn.o_proj",
+            "mlp.gate_proj",
+            "mlp.up_proj",
+            "mlp.down_proj",
+        ):
+            parent_path, _, leaf = path.rpartition(".")
+            parent = layer.get_submodule(parent_path)
+            linear = parent._modules[leaf]
+            if path in TEXT_PACKED:
+                bits, group = TEXT_PACKED[path]
+                parent._modules[leaf] = PackedLinear.from_linear(linear, bits, group).eval()
+                continue
+            replacement = bnb.nn.Linear4bit(
+                linear.in_features,
+                linear.out_features,
+                bias=linear.bias is not None,
+                compute_dtype=torch.bfloat16,
+                compress_statistics=True,
+                quant_type="nf4",
+            )
+            replacement.weight = bnb.nn.Params4bit(
+                linear.weight.detach().cpu(),
+                requires_grad=False,
+                compress_statistics=True,
+                quant_type="nf4",
+            )
+            if linear.bias is not None:
+                replacement.bias = nn.Parameter(linear.bias.detach().cpu(), requires_grad=False)
+            parent._modules[leaf] = replacement.to(device=linear.weight.device).eval()
+
