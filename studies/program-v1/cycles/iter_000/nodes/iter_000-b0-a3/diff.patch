+def _slice_linear(linear, keep, dim):
+    """Keep the selected output rows (dim=0) or input columns (dim=1) of a Linear."""
+    weight = linear.weight.detach()
+    if dim == 0:
+        weight = weight[keep].contiguous()
+        linear.out_features = len(keep)
+        if linear.bias is not None:
+            linear.bias = nn.Parameter(
+                linear.bias.detach()[keep].contiguous(), requires_grad=False
+            )
+    else:
+        weight = weight[:, keep].contiguous()
+        linear.in_features = len(keep)
+    linear.weight = nn.Parameter(weight, requires_grad=False)
