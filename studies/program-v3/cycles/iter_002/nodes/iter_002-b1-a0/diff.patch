+"""Development smoke: one LIBERO-Spatial episode per task, with this workspace's compress."""
+
+from __future__ import annotations
+
+import sys
+from pathlib import Path
+
+import torch
+
+REPO = Path("/tmp/repo")
+WORK = Path("/tmp/work")
+sys.path.insert(0, str(REPO))
+sys.path.insert(0, str(WORK))
+
+from evaluation.common import episode_seed  # noqa: E402
+from evaluation.models import load_policy  # noqa: E402
+from evaluation.pipeline import Pipeline  # noqa: E402
+from evaluation.rollout import run_episode  # noqa: E402
+from evaluation.simulator import make_environment  # noqa: E402
+from solution import compress  # noqa: E402
+
+
+def main() -> int:
+    calibration = torch.load(
+        REPO / "outputs/compression/calibration-v3.pt", weights_only=True
+    )
+    policy, _ = load_policy("B16")
+    pipeline = Pipeline(policy)
+    policy = compress(policy, calibration)
+    successes = 0
+    for task_id in range(10):
+        env, task = make_environment(task_id, "development")
+        try:
+            success, steps = run_episode(
+                policy, pipeline, env, task, episode_seed(task_id, 0, "development")
+            )
+        finally:
+            env.close()
+        successes += int(success)
+        print(f"task={task_id} success={int(success)} steps={steps}", flush=True)
+    print(f"successes={successes}/10", flush=True)
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
