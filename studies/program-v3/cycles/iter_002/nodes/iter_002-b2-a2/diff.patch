+def _pack(codes: torch.Tensor, bits: int) -> torch.Tensor:
+    """Pack integer codes in the last dimension; 8 codes per 3 bytes for 3-bit."""
+    if bits == 2:
+        c = codes.to(torch.uint8)
+        c = c.view(*c.shape[:-1], c.shape[-1] // 4, 4)
+        return (
+            (c[..., 0] | (c[..., 1] << 2) | (c[..., 2] << 4) | (c[..., 3] << 6))
+            .to(torch.uint8)
+            .contiguous()
+        )
+    if bits == 4:
+        c = codes.to(torch.uint8)
+        c = c.view(*c.shape[:-1], c.shape[-1] // 2, 2)
+        return (c[..., 0] | (c[..., 1] << 4)).to(torch.uint8).contiguous()
+    if bits == 3:
+        c = codes.to(torch.int32)
+        c = c.view(*c.shape[:-1], c.shape[-1] // 8, 8)
+        shifts = torch.arange(8, device=codes.device, dtype=torch.int32) * 3
+        word = (c << shifts).sum(-1)
+        b = torch.stack([word & 0xFF, (word >> 8) & 0xFF, (word >> 16) & 0xFF], dim=-1)
+        return b.to(torch.uint8).reshape(*codes.shape[:-1], codes.shape[-1] // 8 * 3).contiguous()
+    raise ValueError(bits)
+
+
+def _unpack(packed: torch.Tensor, bits: int, count: int) -> torch.Tensor:
+    """Unpack integer codes; returns a (rows, count) int32 tensor."""
+    if bits == 2:
+        b = packed.to(torch.int32)
+        return torch.stack(
+            [(b >> 0) & 3, (b >> 2) & 3, (b >> 4) & 3, (b >> 6) & 3], dim=-1
+        ).reshape(packed.shape[0], count)
+    if bits == 4:
+        b = packed.to(torch.int32)
+        return torch.stack([(b >> 0) & 15, (b >> 4) & 15], dim=-1).reshape(
+            packed.shape[0], count
+        )
+    if bits == 3:
+        b = packed.to(torch.int32).view(*packed.shape[:-1], packed.shape[-1] // 3, 3)
+        word = b[..., 0] | (b[..., 1] << 8) | (b[..., 2] << 16)
+        shifts = torch.arange(8, device=packed.device, dtype=torch.int32) * 3
+        codes = (word.unsqueeze(-1) >> shifts) & 7
+        return codes.reshape(packed.shape[0], count)
+    raise ValueError(bits)
+
+
+class PackedLinear(nn.Module):
+    """A Linear whose weight is stored as packed low-bit codes with per-group scales.
+
+    The AWQ input-channel scale is folded into the stored weight and divided out in forward.
+    `chunk_rows` bounds the transient bf16 weight during dequantization.
+    """
+
+    def __init__(
+        self,
+        weight: torch.Tensor,
+        bias: torch.Tensor | None,
+        scale: torch.Tensor | None,
+        bits: int = 3,
+        group_size: int = 64,
+        chunk_rows: int = 0,
+    ) -> None:
+        super().__init__()
+        out_features, in_features = weight.shape
+        self.bits = bits
+        self.group_size = group_size
+        self.in_features = in_features
+        self.out_features = out_features
+        self.chunk_rows = chunk_rows
+        self.padded = (group_size - in_features % group_size) % group_size
+        width = in_features + self.padded
+        w = weight.detach().float()
+        if self.padded:
+            w = F.pad(w, (0, self.padded))
+        w = w.view(out_features, width // group_size, group_size)
+        absmax = w.abs().amax(-1, keepdim=True).clamp_min(1e-8)
+        wn = w / absmax
+        codebook = torch.tensor(_CODEBOOK_3, device=w.device, dtype=torch.float32)
+        boundaries = (codebook[:-1] + codebook[1:]) / 2
+        codes = torch.bucketize(wn.contiguous(), boundaries)
+        self.register_buffer("codebook", codebook.to(torch.bfloat16), persistent=False)
+        self.register_buffer("scales", absmax.squeeze(-1).to(torch.bfloat16), persistent=False)
+        self.register_buffer("packed", _pack(codes, bits), persistent=False)
+        if scale is not None:
+            self.register_buffer(
+                "awq_scale",
+                scale.detach().to(device=weight.device, dtype=torch.bfloat16),
+                persistent=False,
+            )
+        else:
+            self.awq_scale = None
+        if bias is not None:
+            self.bias = nn.Parameter(bias.detach().to(weight.device), requires_grad=False)
+        else:
+            self.register_parameter("bias", None)
+        del w, wn, codes, absmax, codebook, boundaries
+
+    def _dequant(self, row_start: int, row_end: int) -> torch.Tensor:
+        packed = self.packed[row_start:row_end]
+        width = self.in_features + self.padded
+        codes = _unpack(packed, self.bits, width)
+        w = self.codebook[codes].view(
+            row_end - row_start, width // self.group_size, self.group_size
+        )
+        w = w * self.scales[row_start:row_end].unsqueeze(-1)
+        w = w.reshape(row_end - row_start, width)
+        if self.padded:
+            w = w[:, : self.in_features]
+        return w
+
+    def forward(self, x: torch.Tensor) -> torch.Tensor:
+        if self.awq_scale is not None:
+            x = x / self.awq_scale
+        if self.chunk_rows and self.out_features > self.chunk_rows:
+            outs = []
+            for start in range(0, self.out_features, self.chunk_rows):
+                end = min(start + self.chunk_rows, self.out_features)
+                w = self._dequant(start, end).to(x.dtype)
+                outs.append(F.linear(x, w, None))
+            out = torch.cat(outs, dim=-1)
+        else:
+            w = self._dequant(0, self.out_features).to(x.dtype)
+            out = F.linear(x, w, None)
+        if self.bias is not None:
+            out = out + self.bias.to(out.dtype)
+        return out
+
 
