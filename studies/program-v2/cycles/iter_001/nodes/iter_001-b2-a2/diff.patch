@@ -0,0 +1,248 @@
+"""Compression entry point for the VLA-JEPA B16 policy.
+
+The deployed inference path uses only the Qwen text/vision backbone and the action
+head.  This solution keeps the parent's exact structural removals (V-JEPA world
+model, tied ``lm_head``, unused prompt-embedding rows) and adds weight-only
+quantization of the large Linear layers, which is the only remaining large
+payload.  Quantized weights are stored packed in place; the original bf16
+storages are released.
+"""
+
+from __future__ import annotations
+
+import math
+
+import torch
+import torch.nn.functional as F
+from torch import nn
+
+# "int8" stores one signed byte per weight with per-group scales; "int4" uses
+# PyTorch's tinygemm 4-bit packing with affine group scales/zeros.
+MODE = "int4_all"
+
+# Calibration block influence says text decoder layers 3..26 change the residual
+# stream by only ~1e-4 relative energy, i.e. they are effectively identity on the
+# frozen calibration states.  Layers 0..2 receive DeepStack visual features and
+# layer 27 is the final decoder layer, so those stay.  Skipping the rest removes
+# most of the text decoder's 1.4B parameters instead of merely packing them.
+KEEP_TEXT_LAYERS = (0, 1, 2, 27)
+
+
+class CompactEmbedding(nn.Module):
+    """Embedding table restricted to token ids the frozen policy can actually receive."""
+
+    def __init__(self, source: nn.Embedding, token_ids: torch.Tensor) -> None:
+        super().__init__()
+        device = source.weight.device
+        ids = torch.unique(token_ids.to(device=device, dtype=torch.long))
+        if source.padding_idx is not None:
+            ids = torch.unique(
+                torch.cat([ids, torch.tensor([source.padding_idx], device=device, dtype=torch.long)])
+            )
+        ids = ids.sort().values
+        lookup = torch.full((source.num_embeddings,), -1, device=device, dtype=torch.int32)
+        lookup[ids] = torch.arange(len(ids), device=device, dtype=torch.int32)
+        self.register_buffer("lookup", lookup)
+        self.weight = nn.Parameter(source.weight.detach()[ids].clone(), requires_grad=False)
+        self.num_embeddings, self.embedding_dim = self.weight.shape
+        self.padding_idx = None
+        if source.padding_idx is not None:
+            position = (ids == source.padding_idx).nonzero(as_tuple=True)[0]
+            if len(position):
+                self.padding_idx = int(position[0])
+
+    def forward(self, ids: torch.Tensor) -> torch.Tensor:
+        return F.embedding(self.lookup[ids].long(), self.weight, self.padding_idx)
+
+
+class Int8Linear(nn.Module):
+    """Weight-only INT8 Linear with symmetric per-group scales; bf16 activations."""
+
+    def __init__(self, source: nn.Linear, group_size: int = 64) -> None:
+        super().__init__()
+        self.in_features = source.in_features
+        self.out_features = source.out_features
+        self.group_size = group_size
+        weight = source.weight.detach().float()
+        out_features, in_features = weight.shape
+        if in_features % group_size:
+            groups = 1
+            reshaped = weight.reshape(out_features, 1, in_features)
+        else:
+            groups = in_features // group_size
+            reshaped = weight.reshape(out_features, groups, group_size)
+        scales = reshaped.abs().amax(-1, keepdim=True).clamp_min(1e-8) / 127
+        quantized = (reshaped / scales).round().clamp(-127, 127).to(torch.int8)
+        self.register_buffer("qweight", quantized.reshape(out_features, in_features))
+        self.register_buffer("scales", scales.squeeze(-1).to(torch.bfloat16))
+        self.bias = (
+            nn.Parameter(source.bias.detach().clone(), requires_grad=False)
+            if source.bias is not None
+            else None
+        )
+
+    def forward(self, x: torch.Tensor) -> torch.Tensor:
+        weight = self.qweight.to(x.dtype)
+        if self.group_size and self.in_features % self.group_size == 0:
+            weight = weight.reshape(self.out_features, -1, self.group_size)
+            weight = weight * self.scales.to(x.dtype)[:, :, None]
+            weight = weight.reshape(self.out_features, self.in_features)
+        else:
+            weight = weight * self.scales.to(x.dtype)[:, None]
+        return F.linear(x, weight, self.bias)
+
+
+def affine_quantize(weight: torch.Tensor, group_size: int = 128):
+    groups = weight.float().reshape(weight.shape[0], -1, group_size)
+    low = torch.minimum(groups.amin(-1), torch.zeros_like(groups[..., 0]))
+    high = torch.maximum(groups.amax(-1), torch.zeros_like(groups[..., 0]))
+    scales = ((high - low) / 15).clamp_min(1e-8)
+    zeros = (-low / scales).round().clamp(0, 15)
+    quantized = (groups / scales[..., None] + zeros[..., None]).round().clamp(0, 15)
+    return quantized.reshape_as(weight).to(torch.uint8), scales, zeros
+
+
+class PackedInt4(nn.Module):
+    """Groupwise affine INT4 using PyTorch's Ampere-compatible tinygemm kernel."""
+
+    def __init__(self, source: nn.Linear, group_size: int = 128) -> None:
+        super().__init__()
+        self.in_features = source.in_features
+        self.out_features = source.out_features
+        self.group_size = group_size
+        values, scales, zeros = affine_quantize(source.weight.detach(), group_size)
+        k = math.ceil(self.in_features / 1024) * 1024
+        n = math.ceil(self.out_features / 8) * 8
+        self.padded_k, self.padded_n = k, n
+        packed_input = torch.full((n, k), 8, device=values.device, dtype=torch.uint8)
+        packed_input[: self.out_features, : self.in_features] = values.to(torch.uint8)
+        packed = (packed_input[:, ::2] << 4) | packed_input[:, 1::2]
+        self.register_buffer(
+            "packed_weight", torch._convert_weight_to_int4pack(packed.contiguous(), 8)
+        )
+        scale = torch.ones((n, k // group_size), device=values.device, dtype=torch.float32)
+        zero = torch.zeros_like(scale)
+        groups = self.in_features // group_size
+        scale[: self.out_features, :groups] = scales
+        zero[: self.out_features, :groups] = scales * (8 - zeros)
+        self.register_buffer(
+            "scales_zeros",
+            torch.stack((scale, zero), -1).transpose(0, 1).contiguous().to(torch.bfloat16),
+        )
+        self.bias = (
+            nn.Parameter(source.bias.detach().clone(), requires_grad=False)
+            if source.bias is not None
+            else None
+        )
+
+    def forward(self, x: torch.Tensor) -> torch.Tensor:
+        flat = x.reshape(-1, self.in_features).to(torch.bfloat16)
+        if self.padded_k != self.in_features:
+            flat = F.pad(flat, (0, self.padded_k - self.in_features))
+        output = torch._weight_int4pack_mm(
+            flat, self.packed_weight, self.group_size, self.scales_zeros
+        )
+        output = output[:, : self.out_features].reshape(*x.shape[:-1], self.out_features)
+        return output if self.bias is None else output + self.bias
+
+
+def _wants(name: str, mode: str) -> str | None:
+    """Return the requested storage for one Linear path, or None to keep bf16."""
+    if mode == "int8_tv":
+        return "int8" if not name.startswith("action.") else None
+    if mode == "int8_all":
+        return "int8"
+    if mode == "int4_tv":
+        return "int4" if not name.startswith("action.") else None
+    if mode == "int4_all":
+        return "int4"
+    if mode == "int4_mlp":
+        # 4-bit only for the MLP feed-forward matrices; attention stays INT8.
+        return "int4" if ".mlp." in name or ".ff." in name else "int8"
+    if mode == "int4_text_mlp":
+        return "int4" if name.startswith("text.") and ".mlp." in name else "int8"
+    raise ValueError(f"unknown compression mode {mode!r}")
+
+
+def quantize_module(module: nn.Module, prefix: str, mode: str) -> None:
+    for name, child in list(module.named_children()):
+        full = f"{prefix}.{name}" if prefix else name
+        if isinstance(child, nn.Linear):
+            requested = _wants(full, mode)
+            if requested is None:
+                continue
+            if requested == "int4":
+                if child.in_features % 128 or child.out_features % 8:
+                    # The tinygemm packing requires these alignments; the few tiny
+                    # interface layers that miss them stay bf16 (a few MB).
+                    continue
+                replacement = PackedInt4(child)
+            else:
+                if child.in_features < 64:
+                    continue
+                replacement = Int8Linear(child)
+            setattr(module, name, replacement)
+        else:
+            quantize_module(child, full, mode)
+
+
+class SkipBlock(nn.Module):
+    """Identity placeholder that preserves layer indices and DeepStack positions."""
+
+    def forward(self, hidden_states=None, *args, **kwargs):
+        return hidden_states if hidden_states is not None else args[0]
+
+
+def skip_dead_text_layers(policy, keep=KEEP_TEXT_LAYERS) -> None:
+    """Replace calibration-identity text decoder blocks with identity modules."""
+    layers = policy.model.qwen.model.model.language_model.layers
+    keep = set(keep)
+    for index in range(len(layers)):
+        if index not in keep:
+            layers[index] = SkipBlock()
+
+
+def compact_action_positions(policy) -> None:
+    """The action head only ever indexes positions 0..action_horizon-1."""
+    action = policy.model.action_model
+    source = action.position_embedding
+    rows = action.action_horizon
+    if source.num_embeddings <= rows:
+        return
+    replacement = nn.Embedding(rows, source.embedding_dim, device=source.weight.device, dtype=source.weight.dtype)
+    replacement.weight = nn.Parameter(source.weight.detach()[:rows].clone(), requires_grad=False)
+    action.position_embedding = replacement
+
+
+def compress(policy, calibration):
+    """Drop training-only / bypassed weights in place and quantize the large Linears."""
+    model = policy.model
+
+    # V-JEPA world model is only consumed by the training loss; predict_action never
+    # touches it.  Clear the modules, not just their parameters, so no tensors remain.
+    model.video_encoder = None
+    model.video_predictor = None
+    model.video_processor = None
+
+    # The inner Qwen3VLModel is called directly, so the vocabulary output head is dead.
+    # It is tied to embed_tokens, so it must be dropped before the embedding is compacted.
+    qwen = model.qwen
+    qwen.model.lm_head = nn.Identity()
+
+    text = qwen.model.model.language_model
+    text.embed_tokens = CompactEmbedding(text.embed_tokens, calibration["token_ids"])
+
+    # Remove the near-identity decoder blocks before quantizing what remains.
+    skip_dead_text_layers(policy)
+
+    compact_action_positions(policy)
+
+    # Quantize the remaining large Linear payloads in place.  The original bf16
+    # storages are released as each module is replaced.
+    quantize_module(text, "text", MODE)
+    quantize_module(qwen.model.model.visual, "vision", MODE)
+    if MODE.endswith("_all") or MODE in {"int4_mlp"}:
+        quantize_module(model.action_model, "action", MODE)
+
+    torch.cuda.empty_cache()
+    return policy
