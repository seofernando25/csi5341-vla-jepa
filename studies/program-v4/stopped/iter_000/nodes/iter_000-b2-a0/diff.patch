+            except Exception:  # noqa: BLE001
+                pass
+            cache = getattr(obj, "fake_tensor_cache", None)
+            if cache is not None and hasattr(cache, "clear"):
+                try:
+                    cache.clear()
+                except Exception:  # noqa: BLE001
+                    pass
