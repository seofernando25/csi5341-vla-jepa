.venv/
.venv-*/
.tools/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/

# Models, data, runs, simulator outputs
models/
data/
runs/
outputs/
checkpoints/
*.pt
*.pth
*.safetensors
*.mp4
wandb/

.env
.env.*
!.env.example
.DS_Store

# Keep compact evaluation evidence despite the generic runtime-directory rule.
!studies/evaluation/runs/
!studies/evaluation/runs/*/
!studies/evaluation/runs/*/run.json
!studies/evaluation/runs/*/*.csv
!report/data/

# LaTeX build files
report/*.aux
report/*.bbl
report/*.blg
report/*.fdb_latexmk
report/*.fls
report/*.log
report/*.out

# Raw per-batch diagnostic streams and unread machine-generated dumps stay local; compact summaries are published.
studies/evaluation/training/*/metrics.jsonl
studies/evaluation/training/*/metrics_summary.json
studies/compression/measurements/*/*/serialized.json
studies/compression/measurements/*/*/tensor_layout.json

# Required presentation clips, explicitly retained for the offline viewer.
!/web/presentation/assets/droid-demonstration.mp4
!/web/presentation/assets/human-demonstration.mp4
