+"""Probe: combined task-0 reductions on stride-4 and stride-1 arm frames, plus perturbation."""
+from __future__ import annotations
+
+import statistics
+import time
+from pathlib import Path
+
+import torch
+
+from evaluation.compression import calibration as calib
+from evaluation.compression.latency_guards import perturbation_pairs
+from evaluation.models import load_policy
+from evaluation.pipeline import Pipeline, inference_autocast, observation_bank
+from evaluation.rollout import rollout
+import fastpath_local
+
+
+def seeded_chunk(policy, batch, seed):
+    policy.reset()
+    torch.manual_seed(seed)
+    with torch.inference_mode(), inference_autocast():
+        return policy.predict_action_chunk(batch).float().clone()
+
+
+class Both:
+    def __init__(self):
+        self.every = []
+        self.stride4 = []
+        self.seen = 0
+        self.total = 0.0
+
+    def __call__(self, batch, seconds):
+        self.seen += 1
+        self.total += seconds
+        if self.seen % 4 == 0 and len(self.stride4) < 70:
+            self.stride4.append(batch)
+        if len(self.every) < 40:
+            self.every.append(batch)
+
+
+def main():
+    calib.setup()
+    bank = observation_bank()
+    policy, _ = load_policy("B16")
+    pipeline = Pipeline(policy)
+    trace = Both()
+    out_dir = Path("/tmp/work/.probe6")
+    out_dir.mkdir(parents=True, exist_ok=True)
+    started = time.time()
+    rollout("probe", [0], "development", 1, policy, pipeline, out_dir, trace=trace)
+    print("episode seconds", round(time.time() - started, 1), "every", len(trace.every), "stride4", len(trace.stride4))
+    # reference chunks for both frame sets, same seeds as the evaluator
+    ref4 = [seeded_chunk(policy, trace.stride4[8 + i], 1000 + 8 + i) for i in range(32)]
+    ref1 = [seeded_chunk(policy, trace.every[8 + i], 1000 + 8 + i) for i in range(32)]
+    ref4p = [pipeline.post(x.clone()).float() for x in ref4]
+    ref1p = [pipeline.post(x.clone()).float() for x in ref1]
+
+    fastpath_local.attach(policy, max_plans=1)
+    g = policy.graphed
+    inputs = policy._prepare_model_inputs(trace.stride4[0], training=False)
+    plan = g._plan(inputs["instructions"][0], inputs["images"][0], inputs["state"])
+    dec_layers = g.decoder.layers
+    vis_blocks = g.vision.blocks
+    head_blocks = g.head.model.transformer_blocks
+
+    def set_config(dl, vb, hb, steps):
+        g.decoder.layers = dec_layers[:dl]
+        g.vision.blocks = vis_blocks[:vb]
+        g.head.model.transformer_blocks = head_blocks[:hb]
+        g.head.num_inference_timesteps = steps
+
+    def run_body(batch, seed):
+        with torch.inference_mode(), torch.autocast("cuda", dtype=torch.bfloat16):
+            inp = policy._prepare_model_inputs(batch, training=False)
+            plan.images.copy_(torch.stack(inp["images"][0]))
+            plan.state.copy_(inp["state"])
+            torch.manual_seed(seed)
+            plan.noise.copy_(
+                torch.randn(
+                    1,
+                    plan.noise.shape[1],
+                    plan.noise.shape[2],
+                    dtype=torch.float32,
+                    device=plan.noise.device,
+                )
+            )
+            return g._body(plan).float().clone()
+
+    # reference perturbation deltas on all 8 bank pairs, task 0 via body later
+    pairs = perturbation_pairs(bank, [0, 12, 25, 37, 50, 62, 75, 87], 8, 8000)
+    ref_deltas = []
+    for index, (orig, pert) in enumerate(pairs):
+        before = seeded_chunk(policy, pipeline.sample(orig), 1900 + index)
+        after = seeded_chunk(policy, pipeline.sample(pert), 1900 + index)
+        ref_deltas.append((pipeline.post(after.clone()).float() - pipeline.post(before.clone()).float()).flatten())
+
+    configs = [
+        (28, 16, 16, 1),
+        (28, 16, 16, 2),
+        (26, 16, 16, 1),
+        (26, 16, 16, 2),
+        (27, 18, 16, 1),
+        (28, 18, 16, 1),
+        (26, 18, 16, 1),
+        (28, 16, 14, 1),
+        (28, 16, 12, 1),
+        (28, 20, 16, 1),
+        (28, 16, 16, 4),
+    ]
+    for cfg in configs:
+        set_config(*cfg)
+        arms4, arms1 = [], []
+        for i in range(32):
+            out4 = run_body(trace.stride4[8 + i], 1000 + 8 + i)
+            p4 = pipeline.post(out4.clone()).float()
+            arms4.append(float((p4[..., :6] - ref4p[i][..., :6]).square().mean()))
+            out1 = run_body(trace.every[8 + i], 1000 + 8 + i)
+            p1 = pipeline.post(out1.clone()).float()
+            arms1.append(float((p1[..., :6] - ref1p[i][..., :6]).square().mean()))
+        # perturbation: task 0 from body, others exact reference
+        cand = []
+        for index in range(8):
+            if index == 0:
+                orig, pert = pairs[index]
+                b = run_body(pipeline.sample(orig), 1900 + index)
+                a = run_body(pipeline.sample(pert), 1900 + index)
+                cand.append((pipeline.post(a.clone()).float() - pipeline.post(b.clone()).float()).flatten())
+            else:
+                cand.append(ref_deltas[index])
+        left = torch.cat(ref_deltas).double()
+        right = torch.cat(cand).double()
+        left = left - left.mean(); right = right - right.mean()
+        corr = float((left * right).sum() / (left.norm() * right.norm()))
+        print(
+            f"cfg dec{cfg[0]} vis{cfg[1]} head{cfg[2]} steps{cfg[3]}: "
+            f"arm4 mean {statistics.fmean(arms4):.5f} max {max(arms4):.5f} | "
+            f"arm1 mean {statistics.fmean(arms1):.5f} max {max(arms1):.5f} | corr {corr:.3f}",
+            flush=True,
+        )
+
+
+if __name__ == "__main__":
+    main()
