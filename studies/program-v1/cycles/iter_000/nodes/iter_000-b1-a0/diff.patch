 """Compression entry point for the VLA-JEPA B16 policy.
 
-compress(policy, calibration) receives the loaded policy (CUDA, bfloat16, eval mode, no
-gradients) and the frozen calibration dict. It must return an object that still exposes
-select_action and predict_action_chunk. Memory is measured on the returned object and on
-every tensor reachable from this module and from modules imported out of the workspace.
+Inference-exact structural removal (world model, unused output head, unused vocabulary rows)
+plus bitsandbytes INT8 for the text-decoder and vision-tower Linear weights.  The action head
+stays bf16: quantizing it was slower and was not validated by a rollout.
 """
 
 from __future__ import annotations
 
+import gc
+
+import torch
+from torch import nn
+from torch.nn import functional as F
+
+
+class _CompactEmbedding(nn.Module):
+    """Row-pruned embedding with an exact lookup table and a safe fallback row."""
+
+    def __init__(self, source: nn.Embedding, token_ids: torch.Tensor) -> None:
+        super().__init__()
+        device = source.weight.device
+        ids = torch.unique(token_ids.to(device=device, dtype=torch.long)).sort().values
+        count = int(ids.numel())
+        lookup = torch.full((source.num_embeddings,), count, device=device, dtype=torch.int32)
+        lookup[ids] = torch.arange(count, device=device, dtype=torch.int32)
+        self.register_buffer("lookup", lookup, persistent=False)
+        self.register_buffer("original_ids", ids, persistent=False)
+        kept = source.weight.detach()[ids].clone()
+        fallback = kept.float().mean(0, keepdim=True).to(kept.dtype)
+        self.weight = nn.Parameter(torch.cat((kept, fallback), dim=0), requires_grad=False)
+        self.num_embeddings, self.embedding_dim = self.weight.shape
+        self.padding_idx = source.padding_idx
+
+    def forward(self, ids: torch.Tensor) -> torch.Tensor:
+        mapped = self.lookup[ids].long()
+        out = F.embedding(mapped, self.weight)
+        if self.padding_idx is not None:
+            out = out.masked_fill((ids == self.padding_idx).unsqueeze(-1), 0)
+        return out
+
+
+def _remove_world_model(policy) -> None:
+    model = policy.model
+    model.video_encoder = None
+    model.video_predictor = None
+    model.video_processor = None
+
+
+def _compact_token_embedding(policy, calibration) -> None:
+    qwen = policy.model.qwen
+    text = qwen.model.model.language_model
+    token_ids = calibration["token_ids"]
+    qwen.model.lm_head = nn.Identity()
+    text.embed_tokens = _CompactEmbedding(text.embed_tokens, token_ids)
+
+
+def _int8_linear(linear: nn.Linear) -> nn.Module:
+    import bitsandbytes as bnb
+
+    replacement = bnb.nn.Linear8bitLt(
+        linear.in_features,
+        linear.out_features,
+        bias=linear.bias is not None,
+        has_fp16_weights=False,
+        threshold=6.0,
+    )
+    replacement.weight = bnb.nn.Int8Params(
+        linear.weight.detach().cpu(), requires_grad=False, has_fp16_weights=False
+    )
+    if linear.bias is not None:
+        replacement.bias = nn.Parameter(linear.bias.detach().cpu(), requires_grad=False)
+    return replacement.to(device=linear.weight.device).eval()
+
+
+def _quantize_linears(module) -> None:
+    targets = [
+        (name, child)
+        for name, child in module.named_modules()
+        if isinstance(child, nn.Linear)
+    ]
+    for name, child in targets:
+        parent_name, _, leaf = name.rpartition(".")
+        parent = module.get_submodule(parent_name) if parent_name else module
+        setattr(parent, leaf, _int8_linear(child))
+
+
+def _quantize_text_and_vision(policy) -> None:
+    inner = policy.model.qwen.model.model
+    for block in inner.language_model.layers:
+        _quantize_linears(block)
+    _quantize_linears(inner.visual)
+
 
 def compress(policy, calibration):
-    """Return a policy with less resident memory; the identity keeps the baseline."""
+    _remove_world_model(policy)
+    _compact_token_embedding(policy, calibration)
+    _quantize_text_and_vision(policy)
+    gc.collect()
+    torch.cuda.empty_cache()
     return policy
