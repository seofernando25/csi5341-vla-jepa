 """Compression entry point for the VLA-JEPA B16 policy.
 
-compress(policy, calibration) receives the loaded policy (CUDA, bfloat16, eval mode, no
-gradients) and the frozen calibration dict. It must return an object that still exposes
-select_action and predict_action_chunk. Memory is measured on the returned object and on
-every tensor reachable from this module and from modules imported out of the workspace.
+The policy is mutated in place: inference-unused modules are dropped, the text
+embedding table is replaced by the handful of rows the fixed LIBERO prompts use,
+and (optionally) the large Linear weights are stored as int8 with per-output-channel
+scales.  Nothing is copied beside the original policy.
 """
 
 from __future__ import annotations
 
+import torch
+import torch.nn as nn
+import torch.nn.functional as F
+
+# Token ids observed for the ten LIBERO-Spatial instructions, the prompt template,
+# the chat template, the two image placeholders and the action / embodied-action
+# tokens.  Collected from the real processor over all ten instructions.
+_TOKEN_IDS = (
+    13, 198, 220, 279, 304, 311, 315, 323, 373, 374, 389, 432, 435, 504, 705,
+    872, 1790, 1909, 1948, 1965, 1992, 3383, 3691, 3735, 3745, 4126, 4842,
+    6168, 7771, 7989, 8193, 11968, 12159, 12544, 14087, 19212, 21921, 22360,
+    26482, 29195, 35915, 44015, 62658, 77091, 151644, 151645, 151652, 151653,
+    151655, 151669, 151670, 151671, 151697,
+)
+
+# 0 = exact removal only, 1 = also int8-quantise the Linear weights.
+_QUANT = 0
+
+
+class _CompactEmbedding(nn.Module):
+    """Embedding with only the rows the fixed prompt vocabulary can reach."""
+
+    def __init__(self, weight: torch.Tensor, id_map: torch.Tensor) -> None:
+        super().__init__()
+        self.weight = nn.Parameter(weight, requires_grad=False)
+        self.register_buffer("_id_map", id_map, persistent=False)
+
+    def forward(self, input_ids: torch.Tensor) -> torch.Tensor:
+        return F.embedding(self._id_map[input_ids], self.weight)
+
+
+class _Int8Linear(nn.Module):
+    """Linear whose weight is stored as int8 plus one bf16 scale per output row."""
+
+    def __init__(self, weight: torch.Tensor, bias: torch.Tensor | None) -> None:
+        super().__init__()
+        out_features, in_features = weight.shape
+        w = weight.detach().float()
+        scale = w.abs().amax(dim=1, keepdim=True).clamp_min(1e-8) / 127.0
+        q = torch.round(w / scale).clamp(-127, 127).to(torch.int8)
+        self.in_features = in_features
+        self.out_features = out_features
+        self.register_buffer("_qweight", q, persistent=False)
+        self.register_buffer("_scale", scale.to(weight.dtype), persistent=False)
+        if bias is not None:
+            self.register_buffer("_bias", bias.detach().clone(), persistent=False)
+        else:
+            self._bias = None
+
+    def forward(self, x: torch.Tensor) -> torch.Tensor:
+        w = self._qweight.to(x.dtype) * self._scale.to(x.dtype)
+        return F.linear(x, w, self._bias)
+
+
+def _drop_world_model(model) -> None:
+    model.video_encoder = None
+    model.video_predictor = None
+    model.video_processor = None
+
+
+def _compact_text_embedding(policy) -> None:
+    qwen = policy.model.qwen
+    lm = qwen.model.model.language_model
+    old = lm.embed_tokens
+    weight = old.weight.detach()
+    ids = torch.tensor(_TOKEN_IDS, dtype=torch.long, device=weight.device)
+    rows = weight.index_select(0, ids).clone()
+    zero = torch.zeros_like(rows[:1])
+    rows = torch.cat([rows, zero], dim=0)
+    id_map = torch.full(
+        (weight.shape[0],), len(_TOKEN_IDS), dtype=torch.long, device=weight.device
+    )
+    id_map[ids] = torch.arange(len(_TOKEN_IDS), device=weight.device)
+    lm.embed_tokens = _CompactEmbedding(rows, id_map)
+    qwen.model.lm_head = None
+    del old, weight, rows, zero, id_map
+
+
+def _compact_action_positions(action_model) -> None:
+    old = action_model.position_embedding
+    weight = old.weight.detach()
+    # The DiT only indexes positions 0 .. chunk_size-1.
+    rows = weight[: action_model.action_horizon].clone()
+    action_model.position_embedding = nn.Embedding.from_pretrained(rows, freeze=True)
+    del old, weight, rows
+
+
+def _quantize_linears(module: nn.Module) -> int:
+    converted = 0
+    for name, child in list(module.named_children()):
+        if isinstance(child, nn.Linear):
+            replacement = _Int8Linear(child.weight, child.bias)
+            setattr(module, name, replacement)
+            converted += 1
+        else:
+            converted += _quantize_linears(child)
+    return converted
+
 
 def compress(policy, calibration):
-    """Return a policy with less resident memory; the identity keeps the baseline."""
+    """Shrink the policy in place and return it."""
+    model = policy.model
+    _drop_world_model(model)
+    _compact_text_embedding(policy)
+    _compact_action_positions(model.action_model)
+
+    if _QUANT:
+        qwen = policy.model.qwen.model.model
+        _quantize_linears(qwen.language_model)
+        _quantize_linears(qwen.visual)
+        _quantize_linears(model.action_model)
+
+    torch.cuda.empty_cache()
     return policy
