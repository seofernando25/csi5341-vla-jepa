+def _fit_codebook(values: torch.Tensor, levels: int) -> torch.Tensor:
+    """Lloyd-Max codebook of `levels` points fitted to `values` (normalized to [-1, 1])."""
+    sample = values.flatten()
+    if sample.numel() > 1_000_000:
+        step = sample.numel() // 1_000_000 + 1
+        sample = sample[::step]
+    quantiles = (torch.arange(levels, device=sample.device, dtype=torch.float32) + 0.5) / levels
+    codebook = torch.quantile(sample.float(), quantiles)
+    for _ in range(12):
+        midpoints = (codebook[1:] + codebook[:-1]) * 0.5
+        index = torch.bucketize(sample.float(), midpoints)
+        total = torch.zeros(levels, device=sample.device, dtype=torch.float32)
+        count = torch.zeros(levels, device=sample.device, dtype=torch.float32)
+        total.index_add_(0, index, sample.float())
+        count.index_add_(0, index, torch.ones_like(sample, dtype=torch.float32))
+        codebook = torch.where(count > 0, total / count.clamp_min(1.0), codebook)
+    return codebook.sort().values
+
