-"""Entry point for a policy change to the VLA-JEPA B16 policy.
+"""In-place compression for the VLA-JEPA B16 policy.
 
-compress(policy, calibration) receives the loaded policy (CUDA, bfloat16, eval mode, no
-gradients) and the frozen calibration dict. It must return an object that still exposes
-select_action and predict_action_chunk. The evaluator measures the returned object and every
-tensor reachable from this module and from modules imported out of the workspace.
+Two reductions, both applied to the evaluator's own policy object:
+
+1. The JEPA world model (V-JEPA2 video encoder + action-conditioned video predictor) is used
+   only by the training losses.  Action inference runs the Qwen backbone and the flow-matching
+   action head, so the branch is dead weight and is deleted.
+2. The Qwen language-decoder Linear leaves are replaced by bitsandbytes LLM.int8 modules
+   (`has_fp16_weights=False`, threshold 6.0).  Int8 is nearly lossless for this decoder and
+   halves those weights; the original bf16 modules are released as they are replaced.
+
+No copy of any weight is kept: `compress` mutates the object it is given and returns it.
 """
 
 from __future__ import annotations
 
+import gc
+
+import torch
+from torch import nn
+
+
+def _drop_world_model(policy) -> None:
+    """Detach the training-only world model so its storage can be freed."""
+    model = policy.model
+    model.video_encoder = None
+    model.video_predictor = None
+    model.video_processor = None
+    model.config.enable_world_model = False
+    policy.config.enable_world_model = False
+
+
+def _replace_linear(linear: nn.Linear):
+    """An int8 drop-in for one decoder Linear, quantized on the target device."""
+    import bitsandbytes as bnb
+
+    device = linear.weight.device
+    weight = linear.weight.detach().cpu()
+    replacement = bnb.nn.Linear8bitLt(
+        linear.in_features,
+        linear.out_features,
+        bias=linear.bias is not None,
+        has_fp16_weights=False,
+        threshold=6.0,
+    )
+    replacement.weight = bnb.nn.Int8Params(
+        weight, requires_grad=False, has_fp16_weights=False
+    )
+    if linear.bias is not None:
+        replacement.bias = nn.Parameter(linear.bias.detach().cpu(), requires_grad=False)
+    return replacement.to(device=device).eval()
+
+
+def _quantize_decoder(decoder) -> None:
+    for name, linear in list(decoder.named_modules()):
+        if not isinstance(linear, nn.Linear):
+            continue
+        parent_name, _, leaf = name.rpartition(".")
+        parent = decoder.get_submodule(parent_name) if parent_name else decoder
+        setattr(parent, leaf, _replace_linear(linear))
+
 
 def compress(policy, calibration):
-    """Return the policy unchanged; the identity keeps the baseline."""
+    """Remove the dead world model and int8-quantize the language decoder, in place."""
+    _drop_world_model(policy)
+    _quantize_decoder(policy.model.qwen.model.model.language_model)
+    gc.collect()
+    torch.cuda.empty_cache()
     return policy
