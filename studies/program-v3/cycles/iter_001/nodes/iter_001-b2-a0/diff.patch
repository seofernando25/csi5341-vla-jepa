-"""Entry point for a policy change to the VLA-JEPA B16 policy.
+"""In-place compression of the VLA-JEPA B16 policy.
 
-compress(policy, calibration) receives the loaded policy (CUDA, bfloat16, eval mode, no
-gradients) and the frozen calibration dict. It must return an object that still exposes
-select_action and predict_action_chunk. The evaluator measures the returned object and every
-tensor reachable from this module and from modules imported out of the workspace.
+The evaluator holds the original policy while it measures, so everything here replaces
+weights in place and drops the originals.  The training-only JEPA world model is deleted;
+the Qwen language decoder, the Qwen visual tower and the flow-matching action head are
+converted to bitsandbytes low-bit modules; the token embedding is stored int8 with one
+scale per row and the unused tied ``lm_head`` is dropped with it.
+
+Recipe (chosen by the development episodes, not by action error alone):
+  * language-decoder attention projections: int8 (LLM.int8, threshold 6.0)
+  * language-decoder MLP projections: NF4
+  * visual tower and action head: NF4
+  * token embedding: int8, one absmax scale per row
+  * action-head timestep encoder: bf16 (it reads next(self.parameters()).dtype)
 """
 
 from __future__ import annotations
 
+import gc
+
+import torch
+from torch import nn
+
+
+def _int8_linear(linear: nn.Linear) -> nn.Module:
+    """Replace one nn.Linear by an int8 module, releasing the bf16 weight."""
+    import bitsandbytes as bnb
+
+    weight = linear.weight.detach().cpu()
+    replacement = bnb.nn.Linear8bitLt(
+        linear.in_features,
+        linear.out_features,
+        bias=linear.bias is not None,
+        has_fp16_weights=False,
+        threshold=6.0,
+    )
+    replacement.weight = bnb.nn.Int8Params(
+        weight, requires_grad=False, has_fp16_weights=False
+    )
+    if linear.bias is not None:
+        replacement.bias = nn.Parameter(linear.bias.detach().cpu(), requires_grad=False)
+    return replacement.to(device=linear.weight.device).eval()
+
+
+def _nf4_linear(linear: nn.Linear) -> nn.Module:
+    """Replace one nn.Linear by an NF4 module, releasing the bf16 weight."""
+    import bitsandbytes as bnb
+
+    weight = linear.weight.detach().cpu()
+    replacement = bnb.nn.Linear4bit(
+        linear.in_features,
+        linear.out_features,
+        bias=linear.bias is not None,
+        compute_dtype=torch.bfloat16,
+        compress_statistics=True,
+        quant_type="nf4",
+    )
+    replacement.weight = bnb.nn.Params4bit(
+        weight, requires_grad=False, compress_statistics=True, quant_type="nf4"
+    )
+    if linear.bias is not None:
+        replacement.bias = nn.Parameter(linear.bias.detach().cpu(), requires_grad=False)
+    return replacement.to(device=linear.weight.device).eval()
+
+
+def _convert_linears(root: nn.Module, choose, skip: tuple[str, ...] = ()) -> int:
+    """Convert every nn.Linear leaf under root in place; ``choose(name)`` picks the module."""
+    converted = 0
+    for name, module in list(root.named_modules()):
+        if not isinstance(module, nn.Linear):
+            continue
+        if any(name == prefix or name.startswith(prefix + ".") for prefix in skip):
+            continue
+        parent_name, _, leaf = name.rpartition(".")
+        parent = root.get_submodule(parent_name) if parent_name else root
+        setattr(parent, leaf, choose(name, module))
+        converted += 1
+    return converted
+
+
+def _quantize_embedding(embedding: nn.Embedding) -> nn.Module:
+    """Store the token table int8 with one scale per row; output stays bf16."""
+    import bitsandbytes as bnb
+
+    replacement = bnb.nn.Embedding8bit(
+        embedding.num_embeddings,
+        embedding.embedding_dim,
+        device="cpu",
+        dtype=embedding.weight.dtype,
+    )
+    replacement.weight = bnb.nn.Int8Params(
+        embedding.weight.detach().cpu(),
+        requires_grad=False,
+        has_fp16_weights=False,
+    )
+    return replacement.to(device=embedding.weight.device).eval()
+
 
 def compress(policy, calibration):
-    """Return the policy unchanged; the identity keeps the baseline."""
+    """Mutate the loaded policy in place and return it."""
+    model = policy.model
+
+    # 1. The JEPA world model is used only by the training forward; inference never
+    #    touches it.  Drop all three pieces before quantizing anything else.
+    model.video_encoder = None
+    model.video_predictor = None
+    model.video_processor = None
+    for config in (getattr(model, "config", None), getattr(policy, "config", None)):
+        if config is not None and hasattr(config, "enable_world_model"):
+            config.enable_world_model = False
+
+    qwen = model.qwen.model
+    inner = qwen.model
+    language = inner.language_model
+
+    # 2. The tied lm_head is never called: `_qwen_last_decoder_hidden` runs the inner
+    #    Qwen3VLModel and reads a decoder hidden state.  Dropping it lets the bf16
+    #    embedding table go when the int8 table replaces it.
+    qwen.lm_head = None
+
+    # 3. Int8 token embedding (row-wise scales in Embedding8bit).
+    language.embed_tokens = _quantize_embedding(language.embed_tokens)
+
+    # 4. Language decoder: NF4 the MLP projections, int8 the attention projections.
+    def _language_choice(name, module):
+        return _nf4_linear(module) if ".mlp." in f".{name}." else _int8_linear(module)
+
+    _convert_linears(language, _language_choice)
+
+    # 5. Visual tower and action head: NF4.  The action head's timestep encoder reads
+    #    `next(self.parameters()).dtype`; an int8/NF4 first parameter would cast the
+    #    sinusoidal input to an integer dtype.  It is under 1 MB and stays bf16.
+    _convert_linears(inner.visual, lambda name, module: _nf4_linear(module))
+    _convert_linears(
+        model.action_model,
+        lambda name, module: _nf4_linear(module),
+        skip=("model.timestep_encoder",),
+    )
+
+    gc.collect()
+    torch.cuda.empty_cache()
     return policy
