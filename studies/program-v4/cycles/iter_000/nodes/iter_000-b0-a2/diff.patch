+"""Development probe: compare a compiled graph body against the stored bank references."""
+
+import os
+import sys
+import time
+
+import torch
+
+from evaluation.compression import calibration as calib
+from evaluation.compression.study import screen
+from evaluation.models import load_policy
+
+import graphed
+
+MODE = os.environ.get("MODE", "compile")
+EMULATE = os.environ.get("EMULATE", "1") == "1"
+PREDICTIONS = int(os.environ.get("PREDICTIONS", "20"))
+
+
+def main():
+    calib.setup()
+    calibration = calib.load()
+    policy, _ = load_policy("B16")
+    started = time.perf_counter()
+    g = graphed.attach(
+        policy,
+        use_compile=MODE == "compile",
+        emulate=EMULATE,
+        compile_flow=MODE == "flowcompile",
+    )
+    # Drop the training-only world model exactly as the submitted solution does.
+    for name in ("video_encoder", "video_predictor", "video_processor"):
+        setattr(policy.model, name, None)
+    from solution import INSTRUCTIONS, _dummy_batch
+
+    for instruction in INSTRUCTIONS:
+        g.predict_action_chunk(_dummy_batch(policy, instruction))
+    torch.cuda.synchronize()
+    summary, rows = screen(policy, calibration, predictions=PREDICTIONS)
+    print(
+        {
+            "mode": MODE,
+            "emulate": EMULATE,
+            "setup_seconds": round(time.perf_counter() - started, 1),
+            "max_norm_diff": summary["maximum_normalized_action_difference"],
+            "max_arm_mse": summary["maximum_physical_arm_change_mse"],
+            "mean_arm_mse": summary["mean_physical_arm_change_mse"],
+            "median_ms": summary["pipeline_median_ms"],
+            "p95_ms": summary["pipeline_p95_ms"],
+            "peak_alloc": summary["peak_allocated_bytes"],
+        }
+    )
+    print("plans", len(g.plans), "graphs", len(g.graph_plans))
+
+
+if __name__ == "__main__":
+    main()
