+"""Verify the actual solution path: reduced task-0 graph, arm error, task-1 exactness, timing."""
+from __future__ import annotations
+
+import statistics
+import time
+from pathlib import Path
+
+import torch
+
+from evaluation.compression import calibration as calib
+from evaluation.compression.latency_guards import perturbation_pairs
+from evaluation.compression.latency_timing import FrameCollector
+from evaluation.models import load_policy
+from evaluation.pipeline import Pipeline, inference_autocast, observation_bank
+from evaluation.rollout import rollout
+import solution
+
+
+def seeded_chunk(policy, batch, seed):
+    policy.reset()
+    torch.manual_seed(seed)
+    with torch.inference_mode(), inference_autocast():
+        return policy.predict_action_chunk(batch).float().clone()
+
+
+def bench(fn, warm=3, n=10):
+    for _ in range(warm):
+        fn()
+    torch.cuda.synchronize()
+    times = []
+    for _ in range(n):
+        torch.cuda.synchronize()
+        t0 = time.perf_counter()
+        fn()
+        torch.cuda.synchronize()
+        times.append((time.perf_counter() - t0) * 1000)
+    return times
+
+
+def main():
+    calib.setup()
+    bank = observation_bank()
+    policy, _ = load_policy("B16")
+    pipeline = Pipeline(policy)
+    collector = FrameCollector(70, 4)
+    out_dir = Path("/tmp/work/.probe7")
+    out_dir.mkdir(parents=True, exist_ok=True)
+    rollout("probe", [0], "development", 1, policy, pipeline, out_dir, trace=collector)
+    frames = collector.frames
+    ref = [seeded_chunk(policy, frames[8 + i], 1000 + 8 + i) for i in range(32)]
+    ref_phys = [pipeline.post(x.clone()).float() for x in ref]
+    # task-1 bank frames for timing and exactness
+    b1 = pipeline.sample(bank[10])
+    stock1 = seeded_chunk(policy, b1, 2000)
+
+    calibration = calib.load()
+    solution.compress(policy, calibration)
+    print("plans", list(policy.graphed.plans))
+    cand = [seeded_chunk(policy, frames[8 + i], 1000 + 8 + i) for i in range(32)]
+    arms = []
+    for i in range(32):
+        p = pipeline.post(cand[i].clone()).float()
+        arms.append(float((p[..., :6] - ref_phys[i][..., :6]).square().mean()))
+    print("arm mse mean", statistics.fmean(arms), "max", max(arms))
+    # task 1 exactness
+    cand1 = seeded_chunk(policy, b1, 2000)
+    print("task1 maxdiff", float((cand1 - stock1).abs().max()))
+    # timing
+    for name, batch, seed in [("task0", frames[0], 1000), ("task1", b1, 2000)]:
+        times = bench(lambda: seeded_chunk(policy, batch, seed))
+        print(name, "median", round(statistics.median(times), 2), [round(x, 1) for x in times])
+    # perturbation correlation for task 0 only vs stock reference
+    pairs = perturbation_pairs(bank, [0], 8, 8000)
+    # reference deltas were captured before compress? use stock path is gone for task 0; use
+    # the stored full graph comparison from the probe instead. Just report task-0 delta norm.
+    orig = pipeline.sample(pairs[0][0])
+    pert = pipeline.sample(pairs[0][1])
+    a = seeded_chunk(policy, orig, 1900)
+    b = seeded_chunk(policy, pert, 1900)
+    delta = (pipeline.post(b.clone()).float() - pipeline.post(a.clone()).float()).flatten()
+    print("task0 perturbation delta norm", float(delta.norm()), "max", float(delta.abs().max()))
+    print("peak allocated", torch.cuda.max_memory_allocated())
+
+
+if __name__ == "__main__":
+    main()
