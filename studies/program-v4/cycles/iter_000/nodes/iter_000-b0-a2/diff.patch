+"""Development probe: time the vision, decoder and flow stages of the graph body."""
+
+import torch
+
+from evaluation.compression import calibration as calib
+from evaluation.models import load_policy
+from evaluation.pipeline import Pipeline, observation_bank
+
+import graphed
+
+
+def timed(fn, warm=3, reps=10):
+    for _ in range(warm):
+        fn()
+    torch.cuda.synchronize()
+    start = torch.cuda.Event(enable_timing=True)
+    end = torch.cuda.Event(enable_timing=True)
+    start.record()
+    for _ in range(reps):
+        fn()
+    end.record()
+    torch.cuda.synchronize()
+    return start.elapsed_time(end) / reps
+
+
+def main():
+    calib.setup()
+    calibration = calib.load()
+    policy, _ = load_policy("B16")
+    for name in ("video_encoder", "video_predictor", "video_processor"):
+        setattr(policy.model, name, None)
+    graphed_policy = graphed.attach(policy)
+    bank = observation_bank()
+    pipeline = Pipeline(policy)
+    batch = pipeline.sample(bank[0])
+    with torch.inference_mode(), torch.autocast("cuda", dtype=torch.bfloat16):
+        # First call builds the plan and captures a graph.
+        policy.predict_action_chunk(batch)
+    source = next(iter(graphed_policy.plans.values()))
+
+    class Shim:
+        pass
+
+    plan = Shim()
+    plan.input_ids = source.input_ids
+    plan.position_ids = source.position_ids
+    plan.visual_index = source.visual_index
+    plan.action_index = source.action_index
+    plan.lengths = source.graph_plan.lengths
+    plan.shared = source.graph_plan.shared
+    plan.rope = source.graph_plan.rope
+    body = graphed_policy
+    vision, decoder, head = body.vision, body.decoder, body.head
+
+    def pixels():
+        return body._pixels(plan)
+
+    def vision_only():
+        shared = plan.shared
+        x = body._pixels(plan).to(vision.dtype)
+        hidden = vision.patch_embed(x) + shared.vision_position
+        deep = []
+        for number, block in enumerate(vision.blocks):
+            hidden = block(hidden, cu_seqlens=None, position_embeddings=shared.vision_rope)
+            if number in vision.deepstack_visual_indexes:
+                position = vision.deepstack_visual_indexes.index(number)
+                deep.append(vision.deepstack_merger_list[position](hidden))
+        image_embeds = vision.merger(hidden)
+        return image_embeds, deep
+
+    def decoder_only():
+        shared = plan.shared
+        image_embeds, deep = vision_only()
+        hidden = decoder.embed_tokens(plan.input_ids)
+        hidden[0, plan.visual_index] = image_embeds.to(hidden.dtype)
+        for number, layer in enumerate(decoder.layers):
+            hidden = layer(
+                hidden,
+                attention_mask=None,
+                position_ids=None,
+                position_embeddings=plan.rope,
+            )
+            if number < len(deep):
+                hidden = hidden.clone()
+                hidden[0, plan.visual_index] = hidden[0, plan.visual_index] + deep[number].to(
+                    hidden.dtype
+                )
+        return hidden[:, plan.action_index].float()
+
+    def flow_only():
+        tokens = decoder_only()
+        return body._flow(tokens, plan)
+
+    with torch.inference_mode(), torch.autocast("cuda", dtype=torch.bfloat16):
+        print("pixels", round(timed(pixels), 3))
+        print("vision", round(timed(vision_only), 3))
+        print("vision+decoder", round(timed(decoder_only), 3))
+        print("full body", round(timed(lambda: body._body(plan)), 3))
+        print("flow only", round(timed(flow_only), 3))
+        print("graph replay", round(timed(lambda: source.graph_plan.graph.replay()), 3))
+        print("predict", round(timed(lambda: policy.predict_action_chunk(batch)), 3))
+        print("select", round(timed(lambda: policy.select_action(batch)), 3))
+
+
+if __name__ == "__main__":
+    main()
