+def _prune_text_mlp(text, calibration, keep_count):
+    """Prune text-MLP intermediate channels by expected output contribution.
+
+    The down-projection input energy in the frozen calibration is the mean squared
+    activation of each intermediate channel; multiplying it by the squared norm of
+    that channel's down-projection column gives the expected squared contribution to
+    the layer output.  The lowest-scoring channels are removed from gate/up outputs
+    and down inputs.  The calibration vector for down_proj is sliced to match, so the
+    activation-aware quantizer sees the pruned channel set.
+    """
+    pruned = 0
+    for index, layer in enumerate(text.layers):
+        mlp = layer.mlp
+        full = f"text.layers.{index}.mlp.down_proj"
+        activation = calibration["linear_inputs"].get(full)
+        if activation is None or keep_count >= mlp.intermediate_size:
+            continue
+        down = mlp.down_proj
+        weight = down.weight.detach().float()
+        score = activation.to(weight.device).float() * weight.square().sum(dim=0)
+        keep = torch.topk(score, keep_count, largest=True).indices.sort().values
+        _slice_linear(mlp.gate_proj, keep, 0)
+        _slice_linear(mlp.up_proj, keep, 0)
+        _slice_linear(mlp.down_proj, keep, 1)
+        mlp.intermediate_size = keep_count
+        calibration["linear_inputs"][full] = activation[keep.cpu()].clone()
+        pruned += 1
+    return pruned
+
