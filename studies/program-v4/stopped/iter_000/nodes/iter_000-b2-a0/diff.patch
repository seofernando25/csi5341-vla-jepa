+                except Exception:  # noqa: BLE001
+                    pass
+    for obj in gc.get_objects():
+        try:
+            is_shape_env = isinstance(obj, ShapeEnv)
+        except Exception:  # noqa: BLE001 - a dead weak proxy in the GC list
+            continue
+        if is_shape_env:
