+
+def _drop_fake_tensor_state():
+    """Remove Dynamo's FakeTensor bookkeeping after the graphs are captured.
+
+    The evaluator's live-CUDA walk calls data_ptr() on every live CUDA tensor; FakeTensors
+    left in Dynamo's guard/shape caches raise there.  The captured CUDA graphs do not need
+    those caches, so drop the tracked fakes and the shape-env caches.
