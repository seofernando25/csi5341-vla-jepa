+"""Profile the current graph: host prep vs replay, and vision/decoder/head GPU split."""
+
+from __future__ import annotations
+
+import statistics
+import time
+
+import torch
+
+from evaluation.compression import calibration as calib
+from evaluation.models import load_policy
+from evaluation.pipeline import Pipeline, observation_bank
+from fastpath import GraphedPolicy
+
+
+def timed(fn, count=30, warm=5):
+    for _ in range(warm):
+        fn()
+    torch.cuda.synchronize()
+    wall = []
+    for _ in range(count):
+        torch.cuda.synchronize()
+        t0 = time.perf_counter_ns()
+        fn()
+        torch.cuda.synchronize()
+        wall.append((time.perf_counter_ns() - t0) / 1e6)
+    return round(statistics.median(wall), 3)
+
+
+def main():
+    calib.setup()
+    torch.manual_seed(0)
+    bank = observation_bank()
+    policy, _ = load_policy("B16")
+    pipeline = Pipeline(policy)
+    batch = pipeline.sample(bank[3])
+    instruction = batch["task"][0]
+
+    model = policy.model
+    model.video_encoder = None
+    model.video_predictor = None
+    model.video_processor = None
+    policy.model.qwen.model.lm_head = torch.nn.Identity()
+    model.action_model.num_inference_timesteps = 2
+
+    graphed = GraphedPolicy(policy, use_compile=True, dense=True)
+    graphed.fuse_decoder()
+    policy.predict_action_chunk = graphed.predict_action_chunk
+    policy.graphed = graphed
+
+    def chunk():
+        policy.reset()
+        torch.manual_seed(1000)
+        return policy.predict_action_chunk(batch)
+
+    chunk()
+    plan = graphed.plans[instruction]
+    print("plan images", tuple(plan.images.shape), plan.images.dtype)
+    print("lengths", plan.lengths, "text tokens", tuple(plan.text_embeds.shape),
+          "action index", tuple(plan.action_index.shape))
+    print("decoder layers", len(graphed.decoder.layers), "vision blocks", len(graphed.vision.blocks),
+          "head blocks", len(graphed.head.model.transformer_blocks))
+    print("hidden", graphed.decoder.config.hidden_size, "vision hidden", graphed.vision.config.hidden_size)
+
+    def prepare():
+        return policy._prepare_model_inputs(batch, training=False)
+
+    with torch.inference_mode():
+        inputs = prepare()
+        images, state = inputs["images"][0], inputs["state"]
+
+        def copies():
+            plan.images.copy_(torch.stack(images))
+            plan.state.copy_(state)
+            plan.noise.copy_(
+                torch.randn(1, plan.noise.shape[1], plan.noise.shape[2],
+                            dtype=torch.float32, device=plan.noise.device)
+            )
+
+        print("prepare_inputs ms", timed(prepare))
+        print("copies+noise   ms", timed(copies))
+        print("replay only    ms", timed(plan.graph.replay))
+        print("predict_chunk  ms", timed(chunk))
+
+        # GPU split with events around sections of the eager body.
+        def sectioned():
+            vision, decoder = graphed.vision, graphed.decoder
+            ev = [torch.cuda.Event(enable_timing=True) for _ in range(5)]
+            ev[0].record()
+            pixels = graphed._pixels(plan).to(vision.dtype)
+            hidden = vision.patch_embed(pixels) + plan.vision_position
+            deep = []
+            for number, block in enumerate(vision.blocks):
+                hidden = block(hidden, cu_seqlens=None, position_embeddings=plan.vision_rope)
+                if number in vision.deepstack_visual_indexes:
+                    position = vision.deepstack_visual_indexes.index(number)
+                    deep.append(vision.deepstack_merger_list[position](hidden))
+            image_embeds = vision.merger(hidden)
+            ev[1].record()
+            hidden = plan.text_embeds.clone()
+            hidden[0, plan.visual_index] = image_embeds.to(hidden.dtype)
+            for number, layer in enumerate(decoder.layers):
+                hidden = layer(hidden, attention_mask=None, position_ids=plan.text_position_ids,
+                               position_embeddings=plan.rope)
+                if number < len(deep):
+                    hidden = hidden.clone()
+                    hidden[0, plan.visual_index] = hidden[0, plan.visual_index] + deep[number].to(hidden.dtype)
+            tokens = hidden[:, plan.action_index].float()
+            ev[2].record()
+            actions = graphed._flow(tokens, plan)
+            ev[3].record()
+            return actions
+
+        for _ in range(3):
+            with torch.autocast("cuda", dtype=torch.bfloat16):
+                sectioned()
+        torch.cuda.synchronize()
+        with torch.autocast("cuda", dtype=torch.bfloat16):
+            evs = [torch.cuda.Event(enable_timing=True) for _ in range(4)]
+            evs[0].record()
+            pixels = graphed._pixels(plan).to(graphed.vision.dtype)
+            hidden = graphed.vision.patch_embed(pixels) + plan.vision_position
+            deep = []
+            for number, block in enumerate(graphed.vision.blocks):
+                hidden = block(hidden, cu_seqlens=None, position_embeddings=plan.vision_rope)
+                if number in graphed.vision.deepstack_visual_indexes:
+                    position = graphed.vision.deepstack_visual_indexes.index(number)
+                    deep.append(graphed.vision.deepstack_merger_list[position](hidden))
+            image_embeds = graphed.vision.merger(hidden)
+            evs[1].record()
+            hidden = plan.text_embeds.clone()
+            hidden[0, plan.visual_index] = image_embeds.to(hidden.dtype)
+            for number, layer in enumerate(graphed.decoder.layers):
+                hidden = layer(hidden, attention_mask=None, position_ids=plan.text_position_ids,
+                               position_embeddings=plan.rope)
+                if number < len(deep):
+                    hidden = hidden.clone()
+                    hidden[0, plan.visual_index] = hidden[0, plan.visual_index] + deep[number].to(hidden.dtype)
+            tokens = hidden[:, plan.action_index].float()
+            evs[2].record()
+            actions = graphed._flow(tokens, plan)
+            evs[3].record()
+        torch.cuda.synchronize()
+        print("eager split ms: vision", evs[0].elapsed_time(evs[1]),
+              "decoder", evs[1].elapsed_time(evs[2]), "head", evs[2].elapsed_time(evs[3]))
+
+        # Kernel profile of one replay.
+        from torch.profiler import ProfilerActivity, profile
+
+        for _ in range(3):
+            plan.graph.replay()
+        torch.cuda.synchronize()
+        with profile(activities=[ProfilerActivity.CUDA]) as prof:
+            for _ in range(5):
+                plan.graph.replay()
+            torch.cuda.synchronize()
+        rows = []
+        for event in prof.key_averages():
+            if event.device_time_total > 0:
+                rows.append((event.device_time_total / 5.0, event.key, event.count // 5))
+        rows.sort(reverse=True)
+        print("top kernels (us per replay):")
+        for us, key, count in rows[:30]:
+            print(f"  {us:9.1f}  x{count:<4d} {key[:100]}")
+        print("total kernel us", sum(r[0] for r in rows))
+
+
+if __name__ == "__main__":
+    main()
