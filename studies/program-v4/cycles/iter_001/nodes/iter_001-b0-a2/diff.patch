+"""Time the final candidate: flow1 + one-step action prompt + fast select."""
+
+from __future__ import annotations
+
+import statistics
+import time
+
+import torch
+
+from evaluation.compression import calibration as calib
+from evaluation.models import load_policy
+from evaluation.pipeline import Pipeline, observation_bank
+from fastpath import GraphedPolicy
+from lerobot.utils.constants import ACTION
+
+
+def timed(fn, count=40, warm=8):
+    for _ in range(warm):
+        fn()
+    torch.cuda.synchronize()
+    wall = []
+    gpu = []
+    for _ in range(count):
+        start = torch.cuda.Event(enable_timing=True)
+        end = torch.cuda.Event(enable_timing=True)
+        torch.cuda.synchronize()
+        start.record()
+        t0 = time.perf_counter_ns()
+        fn()
+        torch.cuda.synchronize()
+        wall.append((time.perf_counter_ns() - t0) / 1e6)
+        end.record()
+        torch.cuda.synchronize()
+        gpu.append(start.elapsed_time(end))
+    return round(statistics.median(wall), 3), round(statistics.median(gpu), 3)
+
+
+def main():
+    calib.setup()
+    torch.manual_seed(0)
+    bank = observation_bank()
+    policy, _ = load_policy("B16")
+    pipeline = Pipeline(policy)
+    batch = pipeline.sample(bank[3])
+
+    model = policy.model
+    model.video_encoder = None
+    model.video_predictor = None
+    model.video_processor = None
+    policy.model.qwen.model.lm_head = torch.nn.Identity()
+    model.action_model.num_inference_timesteps = 1
+    model.replace_prompt = "".join(t * 8 for t in model.action_tokens[:1])
+
+    graphed = GraphedPolicy(policy, use_compile=True, dense=True)
+    policy.predict_action_chunk = graphed.predict_action_chunk
+    policy.graphed = graphed
+
+    def fast_select():
+        queue = policy._queues[ACTION]
+        if len(queue) == 0:
+            actions = policy.predict_action_chunk(batch)
+            queue.extend(actions.transpose(0, 1)[: policy.config.n_action_steps])
+        return queue.popleft()
+
+    def stock_select():
+        policy.reset()
+        torch.manual_seed(1000)
+        return policy.select_action(batch)
+
+    def fast_full():
+        policy.reset()
+        torch.manual_seed(1000)
+        return fast_select()
+
+    def chunk():
+        policy.reset()
+        torch.manual_seed(1000)
+        return policy.predict_action_chunk(batch)
+
+    chunk()
+    print("stock select (flow1+prompt1) wall/gpu", timed(stock_select))
+    print("fast select  (flow1+prompt1) wall/gpu", timed(fast_full))
+    print("predict_chunk                wall/gpu", timed(chunk))
+
+    # Also compare flow2 + prompt1 + action skip 3-11.
+    from evaluation.compression.topology import SkipBlock, blocks
+
+    action_blocks = blocks(policy, "action")
+    originals = list(action_blocks)
+    for i in range(3, 12):
+        action_blocks[i] = SkipBlock()
+    model.action_model.num_inference_timesteps = 2
+    graphed.plans.clear()
+    chunk()
+    print("flow2+prompt1+askip fast     wall/gpu", timed(fast_full))
+    for i, block in enumerate(originals):
+        action_blocks[i] = block
+
+
+if __name__ == "__main__":
+    main()
diff --git a/probe_skip.py b/probe_skip.py
new file mode 100644
index 0000000..2e2bf75
--- /dev/null
+++ b/probe_skip.py
@@ -0,0 +1,175 @@
+"""Measure per-task arm MSE and perturbation correlation for block-skip variants.
+
+Mirrors the evaluator's guard frames: arm frames are 8 bank frames per task; perturbation
+pairs are the exact `bank_indices`/`perturbation_pairs` frames with the protocol seed.
+"""
+
+from __future__ import annotations
+
+import collections
+import sys
+import time
+
+import torch
+
+from evaluation.compression import calibration as calib
+from evaluation.compression.latency_guards import bank_indices, perturbation_pairs
+from evaluation.compression.topology import SkipBlock, blocks
+from evaluation.models import load_policy
+from evaluation.pipeline import Pipeline, observation_bank
+
+
+def physical(pipeline, chunk):
+    return pipeline.post(chunk.float().clone()).float()[..., :6]
+
+
+def chunk_for(policy, pipeline, sample, seed):
+    policy.reset()
+    torch.manual_seed(seed)
+    with torch.inference_mode(), torch.autocast("cuda", dtype=torch.bfloat16):
+        return policy.predict_action_chunk(pipeline.sample(sample))
+
+
+def main():
+    calib.setup()
+    torch.manual_seed(0)
+    bank = observation_bank()
+    refs = torch.load(calib.REFERENCES, weights_only=True)
+    policy, _ = load_policy("B16")
+    pipeline = Pipeline(policy)
+    tasks = list(range(10))
+    seed = 1000
+
+    # Arm frames: 8 per task, skipping the two calibration frames.
+    arm_indices = []
+    seen = collections.Counter()
+    for i, sample in enumerate(bank):
+        task = sample["task_id"]
+        seen[task] += 1
+        if 2 <= seen[task] <= 9:
+            arm_indices.append(i)
+    print("arm frames", len(arm_indices), flush=True)
+
+    # Perturbation pairs exactly as the evaluator builds them.
+    p_indices = bank_indices(bank, 4, tuple(tasks))
+    pairs = perturbation_pairs(bank, p_indices, 8, seed + 7000)
+    p_labels = [int(bank[i]["task_id"]) for i in p_indices]
+    print("perturbation frames", len(pairs), flush=True)
+
+    original_replace = policy.model.replace_prompt
+    original_embodied = policy.model.embodied_replace_prompt
+    text_blocks = blocks(policy, "text")
+    vision_blocks = blocks(policy, "vision")
+    action_blocks = blocks(policy, "action")
+    originals = {
+        "text": list(text_blocks),
+        "vision": list(vision_blocks),
+        "action": list(action_blocks),
+    }
+
+    def restore():
+        for name, target in (("text", text_blocks), ("vision", vision_blocks), ("action", action_blocks)):
+            for i, b in enumerate(originals[name]):
+                target[i] = b
+        policy.model.action_model.num_inference_timesteps = 4
+        policy.model.replace_prompt = original_replace
+        policy.model.embodied_replace_prompt = original_embodied
+
+    def skip(which, indices_to_skip):
+        target = {"text": text_blocks, "vision": vision_blocks, "action": action_blocks}[which]
+        for i in indices_to_skip:
+            target[i] = SkipBlock()
+
+    # Reference perturbation deltas from the untouched policy.
+    started = time.perf_counter()
+    reference_deltas = []
+    with torch.inference_mode(), torch.autocast("cuda", dtype=torch.bfloat16):
+        for index, (original, changed) in enumerate(pairs):
+            before = physical(pipeline, chunk_for(policy, pipeline, original, seed + 900 + index))
+            after = physical(pipeline, chunk_for(policy, pipeline, changed, seed + 900 + index))
+            reference_deltas.append((after - before).flatten())
+    print(f"reference deltas {time.perf_counter()-started:.1f}s", flush=True)
+
+    def correlation(left, right):
+        left = torch.cat(left).double()
+        right = torch.cat(right).double()
+        left = left - left.mean()
+        right = right - right.mean()
+        denom = float(left.norm() * right.norm())
+        return float((left * right).sum() / denom) if denom else 0.0
+
+    def evaluate(name):
+        started = time.perf_counter()
+        errs = collections.defaultdict(list)
+        with torch.inference_mode(), torch.autocast("cuda", dtype=torch.bfloat16):
+            for index in arm_indices:
+                out = chunk_for(policy, pipeline, bank[index], seed + index)
+                ref = refs[index : index + 1].to("cuda")
+                errs[bank[index]["task_id"]].append(
+                    float((physical(pipeline, out) - physical(pipeline, ref)).square().mean())
+                )
+            deltas = []
+            for index, (original, changed) in enumerate(pairs):
+                before = physical(pipeline, chunk_for(policy, pipeline, original, seed + 900 + index))
+                after = physical(pipeline, chunk_for(policy, pipeline, changed, seed + 900 + index))
+                deltas.append((after - before).flatten())
+        per_task = {task: sum(v) / len(v) for task, v in sorted(errs.items())}
+        by_task = {}
+        for task in tasks:
+            own = [d for d, label in zip(deltas, p_labels) if label == task]
+            ref_own = [d for d, label in zip(reference_deltas, p_labels) if label == task]
+            by_task[task] = correlation(ref_own, own)
+        print(
+            f"{name:44s} arm {max(per_task.values()):.6f} corr {min(by_task.values()):.3f} "
+            f"secs {time.perf_counter()-started:.1f}",
+            flush=True,
+        )
+        print("    arm ", " ".join(f"{t}:{v:.4f}" for t, v in per_task.items()), flush=True)
+        print("    corr", " ".join(f"{t}:{v:.3f}" for t, v in by_task.items()), flush=True)
+
+    variants = [
+        ("stock", lambda: None),
+        ("flow2", lambda: setattr(policy.model.action_model, "num_inference_timesteps", 2)),
+        ("flow1", lambda: setattr(policy.model.action_model, "num_inference_timesteps", 1)),
+        ("text_skip_3_5", lambda: skip("text", range(3, 6))),
+        ("text_skip_3_8", lambda: skip("text", range(3, 9))),
+        ("text_skip_3_14", lambda: skip("text", range(3, 15))),
+        ("text_skip_3_20", lambda: skip("text", range(3, 21))),
+        ("text_skip_3_26", lambda: skip("text", range(3, 27))),
+        ("vision_skip_16_22", lambda: skip("vision", range(16, 23))),
+        ("vision_skip_12_22", lambda: skip("vision", range(12, 23))),
+        ("action_skip_3_11", lambda: skip("action", range(3, 12))),
+        ("text3_20_vision16_22", lambda: (skip("text", range(3, 21)), skip("vision", range(16, 23)))),
+        ("text3_26_vision16_22", lambda: (skip("text", range(3, 27)), skip("vision", range(16, 23)))),
+        ("text3_26_vision12_22", lambda: (skip("text", range(3, 27)), skip("vision", range(12, 23)))),
+        ("text3_26_vision16_22_flow2", lambda: (skip("text", range(3, 27)), skip("vision", range(16, 23)), setattr(policy.model.action_model, "num_inference_timesteps", 2))),
+        ("action_skip_3_11", lambda: skip("action", range(3, 12))),
+        ("action_skip_3_15", lambda: skip("action", range(3, 16))),
+        ("no_action_prompt", lambda: setattr(policy.model, "replace_prompt", "")),
+        ("action_prompt_1step", lambda: setattr(policy.model, "replace_prompt", "".join(t * 8 for t in policy.model.action_tokens[:1]))),
+        ("flow1_action_skip_3_11", lambda: (setattr(policy.model.action_model, "num_inference_timesteps", 1), skip("action", range(3, 12)))),
+        ("flow1_no_action_prompt", lambda: (setattr(policy.model.action_model, "num_inference_timesteps", 1), setattr(policy.model, "replace_prompt", ""))),
+        ("flow1_embodied_16", lambda: (setattr(policy.model.action_model, "num_inference_timesteps", 1), setattr(policy.model, "embodied_replace_prompt", policy.model.config.embodied_action_token * 16))),
+        ("flow1_prompt1", lambda: (setattr(policy.model.action_model, "num_inference_timesteps", 1), setattr(policy.model, "replace_prompt", "".join(t * 8 for t in policy.model.action_tokens[:1])))),
+        ("flow1_prompt1_actionskip", lambda: (setattr(policy.model.action_model, "num_inference_timesteps", 1), setattr(policy.model, "replace_prompt", "".join(t * 8 for t in policy.model.action_tokens[:1])), skip("action", range(3, 12)))),
+        ("flow2_prompt1_actionskip", lambda: (setattr(policy.model, "replace_prompt", "".join(t * 8 for t in policy.model.action_tokens[:1])), skip("action", range(3, 12)))),
+        ("flow1_prompt0", lambda: (setattr(policy.model.action_model, "num_inference_timesteps", 1), setattr(policy.model, "replace_prompt", ""))),
+        ("embodied_16", lambda: setattr(policy.model, "embodied_replace_prompt", policy.model.config.embodied_action_token * 16)),
+    ]
+
+    only = sys.argv[1:] if len(sys.argv) > 1 else None
+    for name, apply in variants:
+        if only and name not in only:
+            continue
+        restore()
+        apply()
+        try:
+            evaluate(name)
+        except Exception as error:
+            print(f"{name}: FAILED {type(error).__name__}: {error}", flush=True)
+        finally:
+            restore()
+
+
+if __name__ == "__main__":
+    main()
