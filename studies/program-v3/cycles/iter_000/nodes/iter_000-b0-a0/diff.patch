-"""Compression entry point for the VLA-JEPA B16 policy.
+"""Exact inference-time compression for the VLA-JEPA B16 policy.
 
-compress(policy, calibration) receives the loaded policy (CUDA, bfloat16, eval mode, no
-gradients) and the frozen calibration dict. It must return an object that still exposes
-select_action and predict_action_chunk. Memory is measured on the returned object and on
-every tensor reachable from this module and from modules imported out of the workspace.
+The published policy contains two large pieces that inference never touches:
+
+* the JEPA video encoder / predictor, used only by the training-time world-model loss;
+* the Qwen text embedding rows for tokens outside the fixed LIBERO prompt vocabulary.
+
+Both are removed in place so the evaluator's original policy object stops holding them.
+The action path (Qwen decoder + flow-matching action head) is untouched, so predictions are
+bit-identical to the uncompressed policy.
 """
 
 from __future__ import annotations
 
+import gc
+
+import torch
+import torch.nn.functional as F
+from torch import nn
+
+
+# Token ids that occur in the LIBERO-Spatial inference prompts: the ten task instructions,
+# the prompt template, chat/image/vision markers, and the action/embodied-action tokens.
+_USED_TOKEN_IDS = (
+    13, 198, 220, 279, 304, 311, 315, 323, 373, 374, 389, 432, 435, 504, 705, 872, 1790,
+    1909, 1948, 1965, 1992, 3383, 3691, 3735, 3745, 4126, 4842, 6168, 7771, 7989, 8193,
+    11968, 12159, 12544, 14087, 19212, 21921, 22360, 26482, 29195, 35915, 44015, 62658,
+    77091, 151644, 151645, 151652, 151653, 151655, 151669, 151670, 151671, 151697,
+)
+
+
+class _CompactEmbedding(nn.Module):
+    """Embedding with a compact weight table and an id -> row remap buffer."""
+
+    def __init__(self, weight: torch.Tensor, id_map: torch.Tensor) -> None:
+        super().__init__()
+        self.weight = nn.Parameter(weight, requires_grad=False)
+        self.register_buffer("id_map", id_map, persistent=False)
+
+    def forward(self, input_ids: torch.Tensor) -> torch.Tensor:
+        return F.embedding(self.id_map[input_ids], self.weight)
+
+
+def _drop_world_model(policy) -> None:
+    """Remove the training-only JEPA video encoder/predictor from the policy."""
+    model = policy.model
+    for name in ("video_encoder", "video_predictor", "video_processor"):
+        if hasattr(model, name):
+            setattr(model, name, None)
+
+
+def _compact_text_embedding(policy) -> None:
+    """Replace the full Qwen text embedding (and unused tied lm_head) with used rows only."""
+    qwen = policy.model.qwen.model
+    language_model = qwen.model.language_model
+    if isinstance(language_model.embed_tokens, _CompactEmbedding):
+        return
+    old = language_model.embed_tokens
+    weight = old.weight
+    vocab, hidden = weight.shape
+
+    ids = {int(i) for i in _USED_TOKEN_IDS if 0 <= int(i) < vocab}
+    try:
+        tokenizer = policy.model.qwen.processor.tokenizer
+        for token_id in list(tokenizer.all_special_ids):
+            if token_id is not None and 0 <= int(token_id) < vocab:
+                ids.add(int(token_id))
+        for token_id in (tokenizer.pad_token_id, tokenizer.eos_token_id, tokenizer.bos_token_id):
+            if token_id is not None and 0 <= int(token_id) < vocab:
+                ids.add(int(token_id))
+    except Exception:  # noqa: BLE001 - tokenizer metadata is optional; the literal ids suffice
+        pass
+
+    ordered = sorted(ids)
+    compact = torch.zeros(
+        (len(ordered) + 1, hidden), dtype=weight.dtype, device=weight.device
+    )
+    if ordered:
+        index = torch.tensor(ordered, dtype=torch.long, device=weight.device)
+        compact[1:] = weight.index_select(0, index)
+    id_map = torch.zeros(vocab, dtype=torch.int32, device=weight.device)
+    if ordered:
+        rows = torch.arange(1, len(ordered) + 1, dtype=torch.int32, device=weight.device)
+        id_map[index] = rows
+
+    language_model.embed_tokens = _CompactEmbedding(compact, id_map)
+    # lm_head is tied to the old embedding and is never called by predict_action.
+    qwen.lm_head = None
+
+    del old, weight, compact, id_map
+
 
 def compress(policy, calibration):
-    """Return a policy with less resident memory; the identity keeps the baseline."""
+    """Remove inference-unused weights in place and return the same policy object."""
+    _drop_world_model(policy)
+    _compact_text_embedding(policy)
+    gc.collect()
+    if torch.cuda.is_available():
+        torch.cuda.empty_cache()
     return policy
