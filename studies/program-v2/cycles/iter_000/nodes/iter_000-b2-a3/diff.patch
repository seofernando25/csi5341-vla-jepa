+def _compact_action_position(policy):
+    """Only the first ``chunk_size`` position rows are ever indexed by the action head."""
+    head = policy.model.action_model
+    rows = int(policy.config.chunk_size)
+    source = head.position_embedding
+    if rows >= source.num_embeddings:
+        return
+    compact = nn.Embedding(rows, source.embedding_dim, device=source.weight.device,
+                           dtype=source.weight.dtype)
+    compact.weight = nn.Parameter(source.weight.detach()[:rows].clone(), requires_grad=False)
+    head.position_embedding = compact
+
+
+class _CompactPosEmbed(nn.Module):
+    """Vision positional table restricted to the rows the fixed 14x14 patch grid indexes."""
+
+    def __init__(self, source, grids=(14, 16), num_grid_per_side=48):
+        super().__init__()
+        device = source.weight.device
+        indices = []
+        for grid in grids:
+            h_idxs = torch.linspace(0, num_grid_per_side - 1, grid, device=device)
+            w_idxs = torch.linspace(0, num_grid_per_side - 1, grid, device=device)
+            h_floor, w_floor = h_idxs.int(), w_idxs.int()
+            h_ceil = (h_idxs.int() + 1).clip(max=num_grid_per_side - 1)
+            w_ceil = (w_idxs.int() + 1).clip(max=num_grid_per_side - 1)
+            base_h, base_h_ceil = h_floor * num_grid_per_side, h_ceil * num_grid_per_side
+            indices.append(
+                torch.cat(
+                    [
+                        (base_h[:, None] + w_floor[None]).flatten(),
+                        (base_h[:, None] + w_ceil[None]).flatten(),
+                        (base_h_ceil[:, None] + w_floor[None]).flatten(),
+                        (base_h_ceil[:, None] + w_ceil[None]).flatten(),
+                    ]
+                )
+            )
+        unique = torch.unique(torch.cat(indices)).sort().values
+        lookup = torch.full(
+            (num_grid_per_side * num_grid_per_side,), -1, dtype=torch.int16, device=device
+        )
+        lookup[unique] = torch.arange(len(unique), dtype=torch.int16, device=unique.device)
+        self.register_buffer("lookup", lookup)
+        self.weight = nn.Parameter(source.weight.detach()[unique].clone(), requires_grad=False)
+        self.num_embeddings, self.embedding_dim = self.weight.shape
+
+    def forward(self, ids):
+        mapped = self.lookup[ids].long()
+        if bool((mapped < 0).any()):
+            raise ValueError("Vision grid uses a positional row outside the compact table")
+        return F.embedding(mapped, self.weight)
+
+
+def _compact_vision_position(policy):
+    vision = _roots(policy)["vision"]
+    vision.pos_embed = _CompactPosEmbed(vision.pos_embed)
+
