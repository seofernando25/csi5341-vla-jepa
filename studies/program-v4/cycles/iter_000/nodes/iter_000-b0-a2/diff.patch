@@ -0,0 +1,49 @@
+"""Development probe: kernel-time breakdown of the captured graph replay."""
+
+from collections import defaultdict
+
+import torch
+
+from evaluation.compression import calibration as calib
+from evaluation.models import load_policy
+from evaluation.pipeline import Pipeline, observation_bank
+
+import graphed
+
+
+def main():
+    calib.setup()
+    calibration = calib.load()
+    policy, _ = load_policy("B16")
+    for name in ("video_encoder", "video_predictor", "video_processor"):
+        setattr(policy.model, name, None)
+    g = graphed.attach(policy)
+    bank = observation_bank()
+    pipeline = Pipeline(policy)
+    batch = pipeline.sample(bank[0])
+    with torch.inference_mode(), torch.autocast("cuda", dtype=torch.bfloat16):
+        policy.predict_action_chunk(batch)
+    plan = next(iter(g.plans.values())).graph_plan
+    for _ in range(5):
+        plan.graph.replay()
+    torch.cuda.synchronize()
+    from torch.profiler import ProfilerActivity, profile
+
+    with profile(activities=[ProfilerActivity.CUDA]) as prof:
+        for _ in range(5):
+            plan.graph.replay()
+        torch.cuda.synchronize()
+    totals = defaultdict(float)
+    counts = defaultdict(int)
+    for event in prof.key_averages():
+        if event.device_time_total > 0:
+            totals[event.key] += event.device_time_total
+            counts[event.key] += event.count
+    total = sum(totals.values())
+    print("total us", round(total / 5, 1), "kernels", sum(counts.values()) // 5)
+    for name, value in sorted(totals.items(), key=lambda item: -item[1])[:30]:
+        print(f"{value / 5:9.1f} us  x{counts[name] // 5:5d}  {name[:90]}")
+
+
+if __name__ == "__main__":
+    main()
