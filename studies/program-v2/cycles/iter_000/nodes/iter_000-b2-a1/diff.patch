+# ---------------------------------------------------------------------------
+# structured MLP pruning (Wanda-style channel ranking)
+# ---------------------------------------------------------------------------
+
+
+def _keep_channels(linear, fraction, importance, multiple=64):
+    """Indices of the least important MLP hidden channels, kept in ascending order."""
+    scores = linear.weight.detach().float().abs().sum(0)
+    scores *= importance.to(scores.device).clamp_min(0).sqrt()
+    keep = max(multiple, int(linear.in_features * (1 - fraction)) // multiple * multiple)
+    keep = min(keep, linear.in_features)
+    return scores.argsort(descending=True, stable=True)[:keep].sort().values
+
+
+def _slice_linear(linear, rows=None, columns=None):
+    """Frozen copy of `linear` keeping only the given output rows and input columns."""
+    weight = linear.weight.detach()
+    if rows is not None:
+        weight = weight[rows]
+    if columns is not None:
+        weight = weight[:, columns]
+    result = nn.Linear(
+        weight.shape[1],
+        weight.shape[0],
+        bias=linear.bias is not None,
+        device=weight.device,
+        dtype=weight.dtype,
+    )
+    result.weight = nn.Parameter(weight.clone(), requires_grad=False)
+    if linear.bias is not None:
+        bias = linear.bias.detach() if rows is None else linear.bias.detach()[rows]
+        result.bias = nn.Parameter(bias.clone(), requires_grad=False)
+    return result.eval()
+
+
+def _prune_text_mlp(policy, calibration, fraction):
+    """Remove the least important hidden channels of every text-decoder MLP."""
+    text = _roots(policy)["text"]
+    keep_map = {}
+    for index, block in enumerate(text.layers):
+        key = f"text.layers.{index}.mlp.down_proj"
+        down = block.mlp.down_proj
+        keep = _keep_channels(down, fraction, calibration["linear_inputs"][key])
+        keep_map[index] = keep
+        for name in ("gate_proj", "up_proj"):
+            setattr(block.mlp, name, _slice_linear(getattr(block.mlp, name), rows=keep))
+        block.mlp.down_proj = _slice_linear(down, columns=keep)
+    return keep_map
+
+
