+
+except Exception:
+    hqq_aten = None
+    hqq_aten_is_available = False
+
+class HQQBackend(Enum):
+    # Name of the forward functions
+    PYTORCH = "forward_pytorch_backprop"
+    PYTORCH_COMPILE = "forward_pytorch_backprop_compile"
+    ATEN = "forward_aten_backprop"
