+def _compact_position_table(action_model: nn.Module) -> None:
+    """Keep only the position rows the fixed chunk length can index (0..chunk_size-1)."""
+    table = getattr(action_model, "position_embedding", None)
+    if not isinstance(table, nn.Embedding) or table.weight.shape[0] <= _POSITION_ROWS:
+        return
+    rows = table.weight.detach()[:_POSITION_ROWS].contiguous()
+    replacement = nn.Embedding(_POSITION_ROWS, rows.shape[1], dtype=rows.dtype, device=rows.device)
+    replacement.weight = nn.Parameter(rows, requires_grad=False)
+    action_model.position_embedding = replacement
+    del table, rows
+    gc.collect()
