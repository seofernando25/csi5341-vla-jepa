+def _compact_embedding(policy, embedding: nn.Embedding) -> nn.Module:
+    """Replace the full token table by the rows the fixed prompts can address."""
+    used = sorted(_prompt_token_ids(policy))
+    weight = embedding.weight.detach()
+    table = weight[torch.tensor(used, device=weight.device, dtype=torch.long)].clone()
+    mapping = torch.zeros(
