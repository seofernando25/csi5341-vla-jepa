+"""Reproduce the evaluator's post-compress walk and find FakeTensor holders."""
+
+from __future__ import annotations
+
+import gc
+import sys
+from pathlib import Path
+
+import torch
+
+from evaluation.compression import calibration as calib
+from evaluation.compression.solution import _workspace_modules, measure
+from evaluation.models import load_policy
+
+import solution
+
+
+def fake_tensors():
+    found = []
+    for obj in gc.get_objects():
+        if not (torch.is_tensor(obj) and obj.is_cuda and obj.layout == torch.strided):
+            continue
+        try:
+            obj.untyped_storage().data_ptr()
+        except RuntimeError:
+            found.append(obj)
+    return found
+
+
+calib.setup()
+calibration = calib.load()
+policy, _ = load_policy("B16")
+returned = solution.compress(policy, calibration)
+print("compress returned", type(returned), flush=True)
+
+found = fake_tensors()
+print("fake tensors", len(found), flush=True)
+for obj in found[:5]:
+    print("FAKE", type(obj), obj.shape, obj.device, flush=True)
+    refs = gc.get_referrers(obj)
+    for ref in refs[:8]:
+        print("  referrer", type(ref), repr(ref)[:300], flush=True)
+
+roots = (vars(solution), *(vars(m) for m in _workspace_modules(Path("/tmp/work"))))
+print("roots", [type(root) for root in roots], flush=True)
+try:
+    print("measure", measure(returned, roots, frozenset()), flush=True)
+except Exception as error:  # noqa: BLE001
+    print("measure failed", type(error).__name__, error, flush=True)
