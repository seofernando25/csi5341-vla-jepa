 """Compression entry point for the VLA-JEPA B16 policy.
 
-compress(policy, calibration) receives the loaded policy (CUDA, bfloat16, eval mode, no
-gradients) and the frozen calibration dict. It must return an object that still exposes
-select_action and predict_action_chunk. Memory is measured on the returned object and on
-every tensor reachable from this module and from modules imported out of the workspace.
+The inference path never touches the JEPA world model, and the tied vocabulary output head
+is never evaluated.  We free both, restrict the token embedding to the prompt vocabulary seen
+during calibration, and apply LLM.int8 to the text decoder and vision tower.  The action head
+stays in bfloat16: quantizing it increased resident memory (bitsandbytes overhead on many
+small Linears) and did not improve the action error.
 """
 
 from __future__ import annotations
 
+import torch
+from torch import nn
+from torch.nn import functional as F
+
+
+class CompactEmbedding(nn.Module):
+    """Embedding restricted to the token ids observed during calibration."""
+
+    def __init__(self, source, token_ids):
+        super().__init__()
+        ids = torch.unique(token_ids.to(source.weight.device)).sort().values
+        lookup = torch.full((source.num_embeddings,), -1, device=ids.device, dtype=torch.int32)
+        lookup[ids] = torch.arange(len(ids), device=ids.device, dtype=torch.int32)
+        self.register_buffer("lookup", lookup)
+        self.register_buffer("original_ids", ids)
+        self.weight = nn.Parameter(source.weight.detach()[ids].clone(), requires_grad=False)
+        self.num_embeddings, self.embedding_dim = self.weight.shape
+
+    def forward(self, input_ids):
+        mapped = self.lookup[input_ids].long()
+        if bool((mapped < 0).any()):
+            raise ValueError("Unseen token ID in restricted LIBERO-Spatial vocabulary")
+        return F.embedding(mapped, self.weight)
+
+
+def _remove_world_model(policy):
+    """The world model is used only by the training loss, never by predict_action_chunk."""
+    policy.model.video_encoder = None
+    policy.model.video_predictor = None
+    policy.model.video_processor = None
+
+
+def _compact_vocabulary(policy, calibration):
+    """Store only the 53 prompt ids and drop the unused, tied output head."""
+    text = policy.model.qwen.model.model.language_model
+    text.embed_tokens = CompactEmbedding(text.embed_tokens, calibration["token_ids"])
+    policy.model.qwen.model.lm_head = nn.Identity()
+
+
+def _quantize_int8(module):
+    """LLM.int8 (bitsandbytes) on every Linear leaf of one module."""
+    import bitsandbytes as bnb
+
+    for name, linear in list(module.named_modules()):
+        if not isinstance(linear, nn.Linear):
+            continue
+        parent_name, _, leaf = name.rpartition(".")
+        parent = module.get_submodule(parent_name) if parent_name else module
+        weight = linear.weight.detach().cpu()
+        replacement = bnb.nn.Linear8bitLt(
+            linear.in_features,
+            linear.out_features,
+            bias=linear.bias is not None,
+            has_fp16_weights=False,
+            threshold=6.0,
+        )
+        replacement.weight = bnb.nn.Int8Params(
+            weight, requires_grad=False, has_fp16_weights=False
+        )
+        if linear.bias is not None:
+            replacement.bias = nn.Parameter(linear.bias.detach().cpu(), requires_grad=False)
+        setattr(parent, leaf, replacement.to(device=linear.weight.device).eval())
+
 
 def compress(policy, calibration):
-    """Return a policy with less resident memory; the identity keeps the baseline."""
+    """Return the same policy object with unused weights released and used ones int8-packed."""
+    _remove_world_model(policy)
+    _compact_vocabulary(policy, calibration)
+    inner = policy.model.qwen.model.model
+    _quantize_int8(inner.language_model)
+    _quantize_int8(inner.visual)
+    torch.cuda.empty_cache()
     return policy
