+"""Combination timing: compile + flow2 + vision skip, and compile modes."""
+
+import collections
+import time
+
+import torch
+
+from evaluation.compression import calibration as calib
+from evaluation.compression.topology import SkipBlock, blocks
+from evaluation.models import load_policy
+from evaluation.pipeline import Pipeline, observation_bank
+from evaluation.fastpath import GraphedPolicy
+
+
+def physical(pipeline, chunk):
+    return pipeline.post(chunk.float().clone()).float()[..., :6]
+
+
+def main():
+    calib.setup()
+    torch.manual_seed(0)
+    bank = observation_bank()
+    refs = torch.load(calib.REFERENCES, weights_only=True)
+    policy, _ = load_policy("B16")
+    pipeline = Pipeline(policy)
+    indices = []
+    seen = collections.Counter()
+    for i, sample in enumerate(bank):
+        task = sample["task_id"]
+        seen[task] += 1
+        if 2 < seen[task] <= 5:
+            indices.append(i)
+
+    text_blocks = blocks(policy, "text")
+    vision_blocks = blocks(policy, "vision")
+    originals_text = list(text_blocks)
+    originals_vision = list(vision_blocks)
+
+    def restore():
+        for i, b in enumerate(originals_text):
+            text_blocks[i] = b
+        for i, b in enumerate(originals_vision):
+            vision_blocks[i] = b
+        policy.model.action_model.num_inference_timesteps = 4
+        policy.graphed = None
+        torch.cuda.empty_cache()
+
+    def skip(which, indices_to_skip):
+        target = text_blocks if which == "text" else vision_blocks
+        for i in indices_to_skip:
+            target[i] = SkipBlock()
+
+    def evaluate(name, use_compile=True, compile_kwargs=None, accuracy=True):
+        started = time.perf_counter()
+        graphed = GraphedPolicy(policy, use_compile=use_compile, dense=True)
+        if compile_kwargs is not None:
+            graphed.compile_kwargs = compile_kwargs
+        policy.predict_action_chunk = graphed.predict_action_chunk
+        maxdiff = 0.0
+        errs = collections.defaultdict(list)
+        if accuracy:
+            with torch.inference_mode(), torch.autocast("cuda", dtype=torch.bfloat16):
+                for index in indices:
+                    policy.reset()
+                    torch.manual_seed(1000 + index)
+                    out = policy.predict_action_chunk(pipeline.sample(bank[index])).float()
+                    ref = refs[index : index + 1].to("cuda")
+                    errs[bank[index]["task_id"]].append(
+                        float((physical(pipeline, out) - physical(pipeline, ref)).square().mean())
+                    )
+                    maxdiff = max(maxdiff, float((out - ref).abs().max()))
+        instruction = bank[indices[0]]["instruction"]
+        batch = pipeline.sample(bank[indices[0]])
+        for _ in range(10):
+            policy.reset()
+            torch.manual_seed(1234)
+            policy.select_action(batch)
+        torch.cuda.synchronize()
+        start = torch.cuda.Event(enable_timing=True)
+        end = torch.cuda.Event(enable_timing=True)
+        start.record()
+        for _ in range(50):
+            policy.reset()
+            torch.manual_seed(1234)
+            policy.select_action(batch)
+        end.record()
+        torch.cuda.synchronize()
+        ms = start.elapsed_time(end) / 50
+        worst = max(sum(v) / len(v) for v in errs.values()) if errs else float("nan")
+        print(
+            f"{name:40s} ms {ms:7.2f} worst {worst:.6f} maxdiff {maxdiff:.4f} "
+            f"total {time.perf_counter()-started:.1f}s",
+            flush=True,
+        )
+        return ms
+
+    variants = [
+        ("compile+flow2+vision", lambda: (skip("vision", range(16, 23)), setattr(policy.model.action_model, "num_inference_timesteps", 2)), True, None),
+        ("compile+flow2+vision+text3", lambda: (skip("vision", range(16, 23)), skip("text", [3]), setattr(policy.model.action_model, "num_inference_timesteps", 2)), True, None),
+        ("compile+flow2+vision+text345", lambda: (skip("vision", range(16, 23)), skip("text", [3, 4, 5]), setattr(policy.model.action_model, "num_inference_timesteps", 2)), True, None),
+        ("compile_flow2_vision_maxautotune", lambda: (skip("vision", range(16, 23)), setattr(policy.model.action_model, "num_inference_timesteps", 2)), True, {"mode": "max-autotune-no-cudagraphs"}),
+    ]
+
+    for name, apply, compiled, kwargs in variants:
+        restore()
+        apply()
+        try:
+            evaluate(name, compiled, kwargs)
+        except Exception as error:
+            print(f"{name}: FAILED {type(error).__name__}: {error}", flush=True)
+        finally:
+            restore()
+
+
+if __name__ == "__main__":
+    main()
