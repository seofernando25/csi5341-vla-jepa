-"""Entry point for a policy change to the VLA-JEPA B16 policy.
+"""In-place compression of the VLA-JEPA B16 policy.
 
-compress(policy, calibration) receives the loaded policy (CUDA, bfloat16, eval mode, no
-gradients) and the frozen calibration dict. It must return an object that still exposes
-select_action and predict_action_chunk. The evaluator measures the returned object and every
-tensor reachable from this module and from modules imported out of the workspace.
+Everything happens on the loaded policy: the training-only world model is dropped, the
+tied 151936-row input embedding is replaced by a compact table for the fixed LIBERO
+prompt token set, low-influence text MLP channels are pruned using the calibration
+activation statistics, and the remaining large Linear layers are quantized to NF4 with
+activation-aware per-channel scaling.  No copy of the original weights is kept.
 """
 
 from __future__ import annotations
 
+import gc
+
+import bitsandbytes as bnb
+import torch
+import torch.nn.functional as F
+from torch import nn
+
+# Token ids that can occur in the fixed LIBERO-Spatial prompts, their two camera images,
+# the Qwen chat template and the action/embodied-action placeholders.  Computed offline
+# from the frozen prompt template and the ten LIBERO-Spatial instructions.
+_TEXT_IDS = (
+    13, 198, 220, 279, 304, 311, 315, 323, 373, 374, 389, 432, 435, 504, 705, 872,
+    1790, 1909, 1948, 1965, 1992, 3383, 3691, 3735, 3745, 4126, 4842, 6168, 7771,
+    7989, 8193, 11968, 12159, 12544, 14087, 19212, 21921, 22360, 26482, 29195,
+    35915, 44015, 62658, 77091,
+)
+_SPECIAL_IDS = tuple(range(151643, 151698))
+_KEEP_IDS = _TEXT_IDS + _SPECIAL_IDS
+
+# Fraction of each text MLP's intermediate channels removed.  Channels are ranked by
+# calibration activation magnitude times the down-projection column norm.
+_PRUNE_FRACTION = 0.0
+# Text decoder block removed entirely (smallest measured residual influence).
+_DROP_TEXT_BLOCK = 3
+# Linear layers below this many weights stay bfloat16 (tiny action-head projections).
+_MIN_QUANT_WEIGHTS = 500_000
+
+
+class _CompactEmbedding(nn.Module):
+    """A small embedding table plus a full-vocabulary row map."""
+
+    def __init__(self, weight: torch.Tensor, row_map: torch.Tensor) -> None:
+        super().__init__()
+        self.weight = nn.Parameter(weight, requires_grad=False)
+        self.register_buffer("row_map", row_map, persistent=False)
+
+    def forward(self, input_ids: torch.Tensor) -> torch.Tensor:
+        return F.embedding(self.row_map[input_ids].long(), self.weight)
+
+
+class _ScaledLinear(nn.Module):
+    """Divide the input by the AWQ channel scale, then run the quantized Linear."""
+
+    def __init__(self, linear: nn.Module, scale: torch.Tensor) -> None:
+        super().__init__()
+        self.linear = linear
+        self.register_buffer("scale", scale, persistent=False)
+
+    def forward(self, x: torch.Tensor) -> torch.Tensor:
+        return self.linear(x / self.scale)
+
+
+def _compact_embedding(language_model: nn.Module) -> None:
+    old = language_model.embed_tokens
+    weight = old.weight.detach()
+    device, dtype = weight.device, weight.dtype
+    ids = torch.tensor(_KEEP_IDS, dtype=torch.long, device=device)
+    rows = weight.index_select(0, ids).contiguous()
+    fallback = rows[:1].clone()
+    table = torch.cat([rows, fallback], dim=0)
+    row_map = torch.full(
+        (weight.shape[0],), len(_KEEP_IDS), dtype=torch.int16, device=device
+    )
+    row_map[ids] = torch.arange(len(_KEEP_IDS), dtype=torch.int16, device=device)
+    language_model.embed_tokens = _CompactEmbedding(table, row_map)
+    del old, weight, rows, fallback, table, row_map, ids
+    gc.collect()
+
+
+def _drop_lm_head(model: nn.Module) -> None:
+    """Delete the unused tied output head if the wrapper still has one."""
+    qwen = getattr(model, "qwen", None)
+    if qwen is None:
+        return
+    wrapper = getattr(qwen, "model", None)
+    if wrapper is None:
+        return
+    if hasattr(wrapper, "lm_head"):
+        delattr(wrapper, "lm_head")
+
+
+def _prune_text_mlps(language_model: nn.Module, calibration: dict) -> dict:
+    """Slice the text MLP intermediate dimension using calibration activation magnitudes.
+
+    Returns the kept channel indices per original text-layer index so the down-projection
+    input scale can be sliced consistently.
+    """
+    inputs = calibration.get("linear_inputs") or {}
+    kept: dict[int, torch.Tensor] = {}
+    if _PRUNE_FRACTION <= 0:
+        return kept
+    for index, layer in enumerate(language_model.layers):
+        key = f"text.layers.{index}.mlp.down_proj"
+        mean_sq = inputs.get(key)
+        if mean_sq is None:
+            continue
+        mlp = layer.mlp
+        down = mlp.down_proj
+        intermediate = down.weight.shape[1]
+        keep_count = int(intermediate * (1.0 - _PRUNE_FRACTION)) // 64 * 64
+        if keep_count >= intermediate or keep_count <= 0:
+            continue
+        activation = mean_sq.detach().float().to(down.weight.device)
+        if activation.numel() != intermediate:
+            continue
+        column_norm = down.weight.detach().float().pow(2).sum(dim=0)
+        score = activation * column_norm
+        order = torch.argsort(score, descending=True)[:keep_count]
+        keep = torch.sort(order).values
+        gate, up = mlp.gate_proj, mlp.up_proj
+        gate.weight = nn.Parameter(gate.weight.detach()[keep].contiguous(), requires_grad=False)
+        up.weight = nn.Parameter(up.weight.detach()[keep].contiguous(), requires_grad=False)
+        down.weight = nn.Parameter(
+            down.weight.detach()[:, keep].contiguous(), requires_grad=False
+        )
+        if getattr(gate, "bias", None) is not None:
+            gate.bias = nn.Parameter(gate.bias.detach()[keep].contiguous(), requires_grad=False)
+        if getattr(up, "bias", None) is not None:
+            up.bias = nn.Parameter(up.bias.detach()[keep].contiguous(), requires_grad=False)
+        gate.out_features = keep_count
+        up.out_features = keep_count
+        down.in_features = keep_count
+        kept[index] = keep
+    return kept
+
+
+def _quantize_linear(linear: nn.Linear, scale: torch.Tensor | None) -> nn.Module:
+    device = linear.weight.device
+    weight = linear.weight.detach()
+    if scale is not None:
+        weight = weight * scale.to(device=device, dtype=weight.dtype).view(1, -1)
+    packed_source = weight.to("cpu")
+    del weight
+    replacement = bnb.nn.Linear4bit(
+        linear.in_features,
+        linear.out_features,
+        bias=linear.bias is not None,
+        compute_dtype=torch.bfloat16,
+        compress_statistics=True,
+        quant_type="nf4",
+    )
+    replacement.weight = bnb.nn.Params4bit(
+        packed_source, requires_grad=False, compress_statistics=True, quant_type="nf4"
+    )
+    if linear.bias is not None:
+        replacement.bias = nn.Parameter(linear.bias.detach().to("cpu"), requires_grad=False)
+    replacement = replacement.to(device=device).eval()
+    del packed_source
+    if scale is None:
+        return replacement
+    return _ScaledLinear(replacement, scale.to(device=device, dtype=torch.bfloat16))
+
+
+def _quantize_tree(
+    root: nn.Module,
+    prefix: str,
+    calibration: dict,
+    kept: dict[int, torch.Tensor] | None = None,
+) -> None:
+    inputs = calibration.get("linear_inputs") or {}
+    for name, module in list(root.named_modules()):
+        if not isinstance(module, nn.Linear):
+            continue
+        if module.weight.numel() < _MIN_QUANT_WEIGHTS:
+            continue
+        parent_name, _, leaf = name.rpartition(".")
+        parent = root.get_submodule(parent_name) if parent_name else root
+        key = f"{prefix}.{name}" if name else prefix
+        mean_sq = inputs.get(key)
+        scale = None
+        if mean_sq is not None:
+            mean_sq = mean_sq.detach().float()
+            if kept and prefix == "text" and name.endswith(".mlp.down_proj"):
+                layer_index = int(name.split(".")[1])
+                if layer_index in kept:
+                    mean_sq = mean_sq[kept[layer_index].to(mean_sq.device)]
+            if mean_sq.numel() == module.weight.shape[1]:
+                scale = torch.sqrt(mean_sq.clamp_min(0.0))
+                scale = scale / scale.mean().clamp_min(1e-12)
+                scale = scale.clamp(0.01, 10.0)
+        setattr(parent, leaf, _quantize_linear(module, scale))
+
 
 def compress(policy, calibration):
-    """Return the policy unchanged; the identity keeps the baseline."""
+    model = policy.model
+    # 1. Training-only world model: never called by predict_action.
+    model.video_encoder = None
+    model.video_predictor = None
+    model.video_processor = None
+    gc.collect()
+
+    qwen_wrapper = model.qwen.model
+    qwen = qwen_wrapper.model
+    language_model = qwen.language_model
+
+    # 2. Compact the tied 151936 x 2048 input embedding and drop the unused output head.
+    _compact_embedding(language_model)
+    _drop_lm_head(model)
+    gc.collect()
+
+    # 3. Activation-aware structured pruning of the text MLP intermediate channels.
+    kept = _prune_text_mlps(language_model, calibration)
+    gc.collect()
+
+    # 4. NF4 quantization with per-input-channel AWQ scaling for every large Linear.
+    _quantize_tree(language_model, "text", calibration, kept)
+    _quantize_tree(qwen.visual, "vision", calibration)
+    _quantize_tree(model.action_model, "action", calibration)
+    gc.collect()
+
+    # 5. Remove the lowest-influence blocks after quantization.
+    if _DROP_TEXT_BLOCK is not None and 0 <= _DROP_TEXT_BLOCK < len(language_model.layers):
+        del language_model.layers[_DROP_TEXT_BLOCK]
+    gc.collect()
+    torch.cuda.empty_cache()
     return policy
