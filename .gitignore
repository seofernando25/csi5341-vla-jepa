.venv/
.venv-*/
.tools/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/

# Models, data, runs, simulator outputs
models/
data/
runs/
outputs/
checkpoints/
*.pt
*.pth
*.safetensors
*.mp4
wandb/

# Experiment-local heavy artifacts
experiments/**/artifacts/
experiments/**/checkpoints/
experiments/**/videos/

.env
.env.*
!.env.example
.DS_Store

# Dream-RSI runtime state (workspaces, checkpoints, logs, replay events)
.rsi/
.rsi-v1*/
.rsi-archive*/
.rsi-retention/

# Keep compact evaluation evidence despite the generic runtime-directory rule.
!studies/evaluation/runs/
!studies/evaluation/runs/*/
!studies/evaluation/runs/*/run.json
!studies/evaluation/runs/*/*.csv
studies/evaluation/report/*.aux
studies/evaluation/report/*.log
studies/evaluation/report/*.out

# Extracted cloud-transfer integrity manifest
/cloud-transfer-manifest.json

# Raw per-batch diagnostic streams stay local; compact summaries are published.
studies/evaluation/training/*/metrics.jsonl
