 tensor reachable from this module and from modules imported out of the workspace.
+
+The change: route action-chunk prediction through a precomputed, bit-exact CUDA graph. The
+stock path is launch-bound (thousands of small kernels plus host synchronizations inside the
+vision tower), so replaying one captured graph per instruction removes most of the per-call
+launch and synchronization cost without changing any arithmetic.
 """
 
 from __future__ import annotations
 
+from fastpath_local import attach
+
 
 def compress(policy, calibration):
-    """Return the policy unchanged; the identity keeps the baseline."""
+    """Attach the bit-exact CUDA-graph execution path and return the policy."""
+    attach(policy)
     return policy
