+                for name, param in self.linear_layer.named_parameters():
+                    setattr(self.linear_layer, name, None)
+                del self.linear_layer
+                torch.cuda.empty_cache()
+
+    @classmethod
+    def from_weights(
+        cls,
+        weight: Tensor,
+        bias: Union[Tensor, None],
+        quant_config: dict,
+        compute_dtype: torch.dtype = float16,
+        device: str = "cuda",
+        del_orig: bool = True,
