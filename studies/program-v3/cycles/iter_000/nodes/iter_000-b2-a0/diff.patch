-"""Compression entry point for the VLA-JEPA B16 policy.
+"""In-place compression for the VLA-JEPA B16 LIBERO policy.
 
-compress(policy, calibration) receives the loaded policy (CUDA, bfloat16, eval mode, no
-gradients) and the frozen calibration dict. It must return an object that still exposes
-select_action and predict_action_chunk. Memory is measured on the returned object and on
-every tensor reachable from this module and from modules imported out of the workspace.
+The policy is mutated in place so the evaluator's original object owns the same modules and
+the removed storages are actually freed.  Three exact removals come first (world model, text
+embedding rows, action-head position rows); then the Qwen text decoder's ``nn.Linear``
+leaves are replaced by bitsandbytes NF4 modules, and the vision tower and action head's
+leaves by weight-only int8 modules with one symmetric scale per output channel.  The int8
+weights are dequantized a layer at a time in ``forward`` and the temporary is released, so no
+bf16 copy of the model is kept.
 """
 
 from __future__ import annotations
 
+import bitsandbytes as bnb
+import torch
+import torch.nn.functional as F
+from torch import nn
+
+# Token ids used by the ten LIBERO-Spatial instructions, the Qwen chat template, the image
+# placeholders and the action / embodied-action tokens.  Collected from the frozen observation
+# bank; the evaluator runs the same ten prompts.  Unknown ids map to a zero row.
+TOKEN_IDS = (
+    13, 198, 220, 279, 304, 311, 315, 323, 373, 374, 389, 432, 435, 504, 705, 872,
+    1790, 1909, 1948, 1965, 1992, 3383, 3691, 3735, 3745, 4126, 4842, 6168, 7771,
+    7989, 8193, 11968, 12159, 12544, 14087, 19212, 21921, 22360, 26482, 29195,
+    35915, 44015, 62658, 77091, 151644, 151645, 151652, 151653, 151655, 151669,
+    151670, 151671, 151697,
+)
+
+
+class CompactEmbedding(nn.Module):
+    """Embedding table with only the rows inference can read, plus a zero fallback row."""
+
+    def __init__(self, old: nn.Embedding, ids: tuple[int, ...]) -> None:
+        super().__init__()
+        self.num_embeddings = len(ids) + 1
+        self.embedding_dim = old.embedding_dim
+        self.padding_idx = None
+        weight = old.weight.data[list(ids)].clone()
+        self.weight = nn.Parameter(weight, requires_grad=False)
+        fallback = len(ids)
+        id_map = torch.full(
+            (old.num_embeddings,), fallback, dtype=torch.int32, device=old.weight.device
+        )
+        id_map[torch.tensor(ids, dtype=torch.long, device=old.weight.device)] = torch.arange(
+            len(ids), dtype=torch.int32, device=old.weight.device
+        )
+        self.register_buffer("id_map", id_map, persistent=False)
+
+    def forward(self, input_ids: torch.Tensor) -> torch.Tensor:
+        return F.embedding(self.id_map[input_ids], self.weight)
+
+
+class Int8Linear(nn.Module):
+    """Weight-only symmetric int8 linear, dequantized per call and never cached."""
+
+    def __init__(self, linear: nn.Linear) -> None:
+        super().__init__()
+        weight = linear.weight.detach()
+        scale = weight.float().abs().amax(dim=1, keepdim=True).clamp_min(1e-8) / 127.0
+        quantized = torch.round(weight.float() / scale).clamp_(-127, 127).to(torch.int8)
+        self.in_features = linear.in_features
+        self.out_features = linear.out_features
+        self.register_buffer("weight", quantized, persistent=False)
+        self.register_buffer("scale", scale.to(torch.float32), persistent=False)
+        if linear.bias is not None:
+            self.register_buffer("bias", linear.bias.detach().clone(), persistent=False)
+        else:
+            self.bias = None
+
+    def forward(self, x: torch.Tensor) -> torch.Tensor:
+        weight = self.weight.to(x.dtype)
+        weight.mul_(self.scale.to(x.dtype))
+        return F.linear(x, weight, self.bias)
+
+
+def _replace_linears_4bit(module: nn.Module, skip: tuple[str, ...] = ()) -> None:
+    """Replace every plain Linear leaf under ``module`` with bitsandbytes NF4."""
+    for name, child in list(module.named_modules()):
+        if not isinstance(child, nn.Linear) or any(name.startswith(p) for p in skip):
+            continue
+        parent_name, _, leaf = name.rpartition(".")
+        parent = module.get_submodule(parent_name) if parent_name else module
+        replacement = bnb.nn.Linear4bit(
+            child.in_features,
+            child.out_features,
+            bias=child.bias is not None,
+            compute_dtype=torch.bfloat16,
+            compress_statistics=True,
+            quant_type="nf4",
+        )
+        replacement.weight = bnb.nn.Params4bit(
+            child.weight.detach().cpu(),
+            requires_grad=False,
+            compress_statistics=True,
+            quant_type="nf4",
+        )
+        if child.bias is not None:
+            replacement.bias = nn.Parameter(child.bias.detach().cpu(), requires_grad=False)
+        replacement = replacement.to(device=child.weight.device).eval()
+        parent._modules[leaf] = replacement
+
+
+def _replace_linears(module: nn.Module, skip: tuple[str, ...] = ()) -> None:
+    """Replace every plain Linear leaf under ``module`` with an Int8Linear."""
+    for name, child in list(module.named_modules()):
+        if not isinstance(child, nn.Linear) or any(name.startswith(p) for p in skip):
+            continue
+        parent_name, _, leaf = name.rpartition(".")
+        parent = module.get_submodule(parent_name) if parent_name else module
+        parent._modules[leaf] = Int8Linear(child)
+
+
+def _compact_embedding(policy) -> None:
+    qwen = policy.model.qwen.model  # Qwen3VLForConditionalGeneration
+    language_model = qwen.model.language_model
+    old = language_model.embed_tokens
+    language_model.embed_tokens = CompactEmbedding(old, TOKEN_IDS)
+    # The tied lm_head is never called by the inference path; dropping it releases the old
+    # 151936 x 2048 storage that the compact table replaced.
+    qwen.lm_head = None
+
+
+def _compact_position_embedding(policy) -> None:
+    head = policy.model.action_model
+    old = head.position_embedding
+    rows = head.action_horizon
+    head.position_embedding = nn.Embedding(
+        rows, old.embedding_dim, _weight=old.weight.data[:rows].clone()
+    )
+
 
 def compress(policy, calibration):
-    """Return a policy with less resident memory; the identity keeps the baseline."""
+    model = policy.model
+
+    # Exact: the JEPA world model is training-only.
+    model.video_encoder = None
+    model.video_predictor = None
+    model.video_processor = None
+
+    # Exact: the fixed prompt vocabulary and the action horizon use a tiny slice of the tables.
+    _compact_embedding(policy)
+    _compact_position_embedding(policy)
+
+    # NF4 for the large text decoder; int8 for the smaller vision tower and action head.
+    qwen = policy.model.qwen.model
+    _replace_linears_4bit(qwen.model.language_model)
+    _replace_linears(qwen.model.visual)
+    # TimestepEncoder reads next(self.parameters()).dtype; keep its two small linears in bf16.
+    _replace_linears(policy.model.action_model, ("model.timestep_encoder",))
+
+    torch.cuda.empty_cache()
     return policy
