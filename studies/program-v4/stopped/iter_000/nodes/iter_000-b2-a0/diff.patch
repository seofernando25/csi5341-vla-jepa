@@ -0,0 +1,63 @@
+"""Check whether the evaluator's live_cuda_bytes can be made safe after torch.compile."""
+
+from __future__ import annotations
+
+import gc
+
+import torch
+
+from evaluation.compression.inventory import live_cuda_bytes
+from evaluation.models import load_policy
+from evaluation.pipeline import observation_bank
+from fastpath_local import GraphedPolicy
+
+
+def check(label):
+    try:
+        print(label, live_cuda_bytes(), flush=True)
+    except Exception as error:  # noqa: BLE001
+        print(label, "FAILED", type(error).__name__, error, flush=True)
+
+
+policy, _ = load_policy("B16")
+bank = observation_bank()
+instruction = bank[0]["instruction"]
+graphed = GraphedPolicy(
+    policy, use_compile=True, allow_capture=False, compiled_instructions={instruction}
+)
+graphed.prewarm([instruction])
+check("after prewarm")
+
+graphed.body_compiled = None
+torch._dynamo.reset()
+gc.collect()
+check("after dynamo reset")
+
+for name in [
+    "torch._inductor.codecache.FxGraphCache",
+    "torch._inductor.codecache.PyCodeCache",
+]:
+    pass
+try:
+    from torch._inductor.codecache import FxGraphCache, PyCodeCache
+
+    FxGraphCache.clear()
+    PyCodeCache.clear()
+except Exception as error:  # noqa: BLE001
+    print("cache clear failed", error, flush=True)
+gc.collect()
+check("after inductor cache clear")
+
+# Replay the captured graph after the cleanup.
+pipeline = None
+from evaluation.pipeline import Pipeline, inference_autocast
+
+pipeline = Pipeline(policy)
+policy.predict_action_chunk = graphed.predict_action_chunk
+with torch.inference_mode(), inference_autocast():
+    policy.reset()
+    torch.manual_seed(1000)
+    action = policy.predict_action_chunk(pipeline.sample(bank[0]))
+torch.cuda.synchronize()
+print("action finite", bool(torch.isfinite(action).all()), action.shape, flush=True)
+check("after replay")
