 """Compression entry point for the VLA-JEPA B16 policy.
 
-compress(policy, calibration) receives the loaded policy (CUDA, bfloat16, eval mode, no
-gradients) and the frozen calibration dict. It must return an object that still exposes
-select_action and predict_action_chunk. Memory is measured on the returned object and on
-every tensor reachable from this module and from modules imported out of the workspace.
+The inference path (`predict_action_chunk` / `select_action`) never touches the V-JEPA
+world model (`video_encoder`, `video_predictor`) nor the Qwen `lm_head` (the decoder is
+called through the inner `Qwen3VLModel`, which stops before the head).  Those are removed
+outright.  The 151936-row token embedding is replaced by a compact embedding over the
+token ids the calibration saw; every LIBERO-Spatial instruction and prompt token is in
+that set, and lookups of the retained ids return exactly the original rows.
+
+The remaining weights are stored losslessly as two compressed byte planes per tensor
+(the little-endian low and high bytes of each bf16 element), and materialised back on
+the GPU on the first forward call.  Decompression is exact, so actions are bit-identical
+to the uncompressed policy.
 """
 
 from __future__ import annotations
 
+import bz2
+import gc
+import os
+import zlib
+from concurrent.futures import ThreadPoolExecutor
+
+import torch
+import torch.nn.functional as F
+from torch import nn
+
+
+class _CompactEmbedding(nn.Module):
+    """Embedding restricted to the token ids seen during calibration."""
+
+    def __init__(self, source, token_ids):
+        super().__init__()
+        ids = torch.unique(token_ids.to(source.weight.device)).sort().values
+        lookup = torch.full((source.num_embeddings,), -1, device=ids.device, dtype=torch.int32)
+        lookup[ids] = torch.arange(len(ids), device=ids.device, dtype=torch.int32)
+        self.register_buffer("lookup", lookup)
+        self.weight = nn.Parameter(source.weight.detach()[ids].clone(), requires_grad=False)
+        self.num_embeddings, self.embedding_dim = self.weight.shape
+
+    def forward(self, ids):
+        mapped = self.lookup[ids].long()
+        if bool((mapped < 0).any()):
+            raise ValueError("Unseen token id in restricted LIBERO-Spatial vocabulary")
+        return F.embedding(mapped, self.weight)
+
+
+def _pack(raw):
+    """Split the byte stream into even/odd planes and compress each (bf16 low/high).
+
+    The even bytes (little-endian mantissa LSBs) are incompressible, so zlib is enough;
+    the odd bytes carry sign and exponent and compress about 5x with bzip2.
+    """
+    return zlib.compress(raw[0::2], 1), bz2.compress(raw[1::2], 1)
+
+
+def _unpack(data, nbytes):
+    even = zlib.decompress(data[0])
+    odd = bz2.decompress(data[1])
+    raw = bytearray(nbytes)
+    raw[0::2] = even
+    raw[1::2] = odd
+    return raw
+
 
 def compress(policy, calibration):
-    """Return a policy with less resident memory; the identity keeps the baseline."""
+    model = policy.model
+
+    # Inference-unused modules: the world model is only used by the training losses, and
+    # the Qwen lm_head is skipped because `_qwen_last_decoder_hidden` calls the inner model.
+    model.video_encoder = None
+    model.video_predictor = None
+    model.video_processor = None
+    qwen = model.qwen.model
+    qwen.lm_head = None
+    language_model = qwen.model.language_model
+    embedding = language_model.embed_tokens
+    language_model.embed_tokens = _CompactEmbedding(embedding, calibration["token_ids"])
+    del embedding
+    model.action_model.beta_dist = None  # training-only sampler; holds CPU tensors
+
+    # Collect every remaining parameter and buffer, copy it to host bytes, and compress.
+    entries = []
+    for module in policy.modules():
+        for kind, store in (("_parameters", module._parameters), ("_buffers", module._buffers)):
+            for name, tensor in list(store.items()):
+                if tensor is None:
+                    continue
+                shape = tuple(tensor.shape)
+                dtype = tensor.dtype
+                nbytes = tensor.numel() * tensor.element_size()
+                raw = (
+                    tensor.detach()
+                    .to("cpu", copy=True)
+                    .contiguous()
+                    .reshape(-1)
+                    .view(torch.uint8)
+                    .numpy()
+                    .tobytes()
+                )
+                entries.append((module, kind, name, shape, dtype, nbytes, raw))
+    del tensor
+
+    workers = min(8, os.cpu_count() or 1)
+    with ThreadPoolExecutor(max_workers=workers) as pool:
+        futures = [pool.submit(_pack, entry[6]) for entry in entries]
+        packed = [
+            (entry[0], entry[1], entry[2], entry[3], entry[4], entry[5], future.result())
+            for entry, future in zip(entries, futures)
+        ]
+    del futures
+
+    # Drop the originals so the CUDA storages are freed before the evaluator measures.
+    for module, kind, name, *_ in entries:
+        getattr(module, kind)[name] = None
+    del entries
+    gc.collect()
+    torch.cuda.empty_cache()
+
+    policy._packed = packed
+
+    original_predict = policy.predict_action_chunk
+    original_select = policy.select_action
+
+    def materialize():
+        packed_now = getattr(policy, "_packed", None)
+        if packed_now is None:
+            return
+        policy._packed = None
+        with torch.inference_mode(False), torch.no_grad():
+            for module, kind, name, shape, dtype, nbytes, data in packed_now:
+                raw = _unpack(data, nbytes)
+                tensor = (
+                    torch.frombuffer(raw, dtype=torch.uint8)
+                    .view(dtype)
+                    .reshape(shape)
+                    .to("cuda")
+                )
+                if kind == "_parameters":
+                    module._parameters[name] = nn.Parameter(tensor, requires_grad=False)
+                else:
+                    module._buffers[name] = tensor
+        del packed_now
+        gc.collect()
+        torch.cuda.empty_cache()
+
+    def predict_action_chunk(batch, *args, **kwargs):
+        materialize()
+        return original_predict(batch, *args, **kwargs)
+
+    def select_action(batch, *args, **kwargs):
+        materialize()
+        return original_select(batch, *args, **kwargs)
+
+    policy.predict_action_chunk = predict_action_chunk
+    policy.select_action = select_action
     return policy
