+"""Prototype: bounded CUDA-graph executor, bit-exactness, latency and peak memory."""
+from __future__ import annotations
+
+import statistics
+import time
+
+import torch
+
+from evaluation.compression import calibration as calib
+from evaluation.models import load_policy
+from evaluation.pipeline import Pipeline, inference_autocast, observation_bank
+import fastpath_local
+
+
+def sync():
+    torch.cuda.synchronize()
+
+
+def call(policy, batch, seed):
+    policy.reset()
+    torch.manual_seed(seed)
+    with torch.inference_mode(), inference_autocast():
+        return policy.predict_action_chunk(batch).float().clone()
+
+
+def bench(policy, batch, seed, warm=3, n=8):
+    for _ in range(warm):
+        call(policy, batch, seed)
+    sync()
+    times = []
+    for _ in range(n):
+        sync()
+        t0 = time.perf_counter()
+        call(policy, batch, seed)
+        sync()
+        times.append((time.perf_counter() - t0) * 1000)
+    return times
+
+
+def main():
+    calib.setup()
+    bank = observation_bank()
+    policy, _ = load_policy("B16")
+    pipeline = Pipeline(policy)
+    indices = [0, 12, 24, 36, 48]
+    batches = [pipeline.sample(bank[i]) for i in indices]
+    seeds = [1000 + i for i in indices]
+    with torch.inference_mode(), inference_autocast():
+        stock = [call(policy, b, s) for b, s in zip(batches, seeds)]
+    print("stock outputs", [tuple(x.shape) for x in stock])
+    torch.cuda.reset_peak_memory_stats()
+    info = fastpath_local.attach(policy, max_plans=3)
+    print("attached", info)
+    with torch.inference_mode(), inference_autocast():
+        fast = [call(policy, b, s) for b, s in zip(batches, seeds)]
+        for i, (a, b) in enumerate(zip(stock, fast)):
+            diff = (a - b).abs().max().item()
+            print(f"frame {indices[i]} task {bank[indices[i]]['task_id']} maxdiff {diff:.3e}")
+        # second pass after plans exist
+        fast2 = [call(policy, b, s) for b, s in zip(batches, seeds)]
+        print("second pass maxdiff", max((a - b).abs().max().item() for a, b in zip(stock, fast2)))
+        for i in range(3):
+            times = bench(policy, batches[i], seeds[i])
+            print(f"graph task {bank[indices[i]]['task_id']} ms", [round(x, 2) for x in times],
+                  "median", round(statistics.median(times), 2))
+        times = bench(policy, batches[3], seeds[3])
+        print(f"stock fallback task {bank[indices[3]]['task_id']} ms",
+              [round(x, 2) for x in times], "median", round(statistics.median(times), 2))
+    print("plans", len(policy.graphed.plans))
+    print("peak allocated", torch.cuda.max_memory_allocated())
+    print("peak reserved", torch.cuda.max_memory_reserved())
+
+
+if __name__ == "__main__":
+    main()
