 from __future__ import annotations
 
+import gc
+
+import torch
+
+import fastpath
+
+
+def _drop_training_parts(policy):
+    """Remove modules inference never calls, before any plan is built."""
+    model = policy.model
+    model.video_encoder = None
+    model.video_predictor = None
+    model.video_processor = None
+    gc.collect()
+    torch.cuda.empty_cache()
+
 
