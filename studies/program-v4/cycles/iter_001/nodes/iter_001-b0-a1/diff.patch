+"""Offline probe: action change of pruned/quantized variants against the frozen references."""
+
+import sys
+import time
+
+import torch
+
+from evaluation.compression import calibration as calib
+from evaluation.models import load_policy
+from evaluation.pipeline import Pipeline, observation_bank
+
+
+def physical(pipeline, chunk):
+    return pipeline.post(chunk.float().clone()).float()[..., :6]
+
+
+def run_variant(policy, pipeline, bank, refs, indices):
+    """Per-task mean physical arm MSE and max normalized diff over `indices`."""
+    import collections
+
+    errs = collections.defaultdict(list)
+    maxdiff = 0.0
+    with torch.inference_mode(), torch.autocast("cuda", dtype=torch.bfloat16):
+        for index in indices:
+            policy.reset()
+            torch.manual_seed(1000 + index)
+            out = policy.predict_action_chunk(pipeline.sample(bank[index])).float()
+            ref = refs[index : index + 1].to("cuda")
+            errs[bank[index]["task_id"]].append(
+                float((physical(pipeline, out) - physical(pipeline, ref)).square().mean())
+            )
+            maxdiff = max(maxdiff, float((out - ref).abs().max()))
+    per_task = {task: sum(v) / len(v) for task, v in sorted(errs.items())}
+    return per_task, maxdiff
+
+
+def main():
+    calib.setup()
+    torch.manual_seed(0)
+    bank = observation_bank()
+    refs = torch.load(calib.REFERENCES, weights_only=True)
+    policy, _ = load_policy("B16")
+    pipeline = Pipeline(policy)
+    # 3 frames per task, skipping the calibration indices (first two of each task).
+    indices = []
+    seen = {}
+    for i, sample in enumerate(bank):
+        task = sample["task_id"]
+        seen[task] = seen.get(task, 0) + 1
+        if seen[task] > 2 and seen[task] <= 5:
+            indices.append(i)
+    print("indices", len(indices), flush=True)
+
+    from evaluation.compression.topology import SkipBlock, blocks
+
+    def reset_model():
+        # reload is too slow; keep a pristine copy of the block lists by restoring saved blocks
+        pass
+
+    # Save originals so variants can be undone.
+    text_blocks = blocks(policy, "text")
+    vision_blocks = blocks(policy, "vision")
+    originals_text = list(text_blocks)
+    originals_vision = list(vision_blocks)
+
+    def restore():
+        for i, b in enumerate(originals_text):
+            text_blocks[i] = b
+        for i, b in enumerate(originals_vision):
+            vision_blocks[i] = b
+        policy.model.action_model.num_inference_timesteps = 4
+
+    def skip(which, indices_to_skip):
+        target = text_blocks if which == "text" else vision_blocks
+        for i in indices_to_skip:
+            target[i] = SkipBlock()
+
+    variants = []
+    variants.append(("stock", lambda: None))
+    variants.append(("flow3", lambda: setattr(policy.model.action_model, "num_inference_timesteps", 3)))
+    variants.append(("flow2", lambda: setattr(policy.model.action_model, "num_inference_timesteps", 2)))
+    variants.append(("text_skip_3_26", lambda: skip("text", range(3, 27))))
+    variants.append(("text_skip_3_20", lambda: skip("text", range(3, 21))))
+    variants.append(("text_skip_3_14", lambda: skip("text", range(3, 15))))
+    variants.append(("text_skip_3_8", lambda: skip("text", range(3, 9))))
+    variants.append(("vision_skip_12_22", lambda: skip("vision", range(12, 23))))
+    variants.append(("vision_skip_16_22", lambda: skip("vision", range(16, 23))))
+    variants.append(("text_skip_3_20+vision_skip_16_22", lambda: (skip("text", range(3, 21)), skip("vision", range(16, 23)))))
+
+    for name, apply in variants:
+        restore()
+        apply()
+        started = time.perf_counter()
+        per_task, maxdiff = run_variant(policy, pipeline, bank, refs, indices)
+        worst = max(per_task.values())
+        print(
+            f"{name:42s} worst {worst:.6f} mean {sum(per_task.values())/len(per_task):.6f} "
+            f"maxdiff {maxdiff:.4f} secs {time.perf_counter()-started:.1f}",
+            flush=True,
+        )
+        print("   ", " ".join(f"{t}:{v:.4f}" for t, v in per_task.items()), flush=True)
+    restore()
+
+
+if __name__ == "__main__":
+    main()
