{
  "id": "deploy-hqq2-vision-text-channels-restricted",
  "family": "joint compression",
  "changes": [
    {
      "method": "world_remove"
    },
    {
      "method": "compact_embedding"
    },
    {
      "method": "channels",
      "scope": "text_mlp",
      "fraction": 0.25
    },
    {
      "method": "channels",
      "scope": "vision_mlp",
      "fraction": 0.5
    },
    {
      "method": "bnb",
      "scope": "text",
      "bits": 4
    },
    {
      "method": "hqq",
      "scope": "vision_blocks",
      "bits": 2,
      "axis": 0,
      "group_size": 64,
      "backend": "pytorch"
    },
    {
      "method": "hqq",
      "scope": "action_mlp",
      "bits": 2,
      "axis": 0,
      "group_size": 64,
      "backend": "pytorch"
    },
    {
      "method": "bnb",
      "scope": "action_attention",
      "bits": 4
    },
    {
      "method": "bnb",
      "scope": "action_interfaces",
      "bits": 4
    },
    {
      "method": "bnb",
      "scope": "merger",
      "bits": 4
    }
  ]
}
