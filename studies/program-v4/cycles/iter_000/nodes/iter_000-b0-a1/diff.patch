+    @torch.inference_mode()
+    def select_action(self, batch, noise=None):
+        """The stock queue semantics without the per-call `eval()` tree walk.
+
+        `VLAJEPAPolicy.select_action` calls `self.eval()` on every call, which walks every
+        module of the 2B backbone and costs about 1.5 ms of CPU before the graph can be
+        launched.  The evaluator loads the policy in eval mode and never trains it, so the
+        walk is redundant.  `populate_queues` only fills the observation queues, which are
+        unused with `n_obs_steps == 1`; `_prepare_model_inputs` reads the batch directly.
+        The action queue is kept exactly as the stock method keeps it, so the sequence of
+        actions over an episode is unchanged.
+        """
+        queue = self.policy._queues["action"]
+        if not queue:
+            actions = self.predict_action_chunk(batch)
+            queue.extend(actions.transpose(0, 1)[: self.policy.config.n_action_steps])
+        return queue.popleft()
+
 
 def attach(policy):
     """Route `policy.predict_action_chunk` (and so `select_action`) through graphed execution."""
     graphed = GraphedPolicy(policy)
     policy.predict_action_chunk = graphed.predict_action_chunk
+    policy.select_action = graphed.select_action
     policy.graphed = graphed
     return graphed
