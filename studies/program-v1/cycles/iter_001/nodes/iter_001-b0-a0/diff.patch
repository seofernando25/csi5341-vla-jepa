-"""Compression entry point for the VLA-JEPA B16 policy.
+"""Memory-only compression for the VLA-JEPA B16 LIBERO policy.
 
-compress(policy, calibration) receives the loaded policy (CUDA, bfloat16, eval mode, no
-gradients) and the frozen calibration dict. It must return an object that still exposes
-select_action and predict_action_chunk. Memory is measured on the returned object and on
-every tensor reachable from this module and from modules imported out of the workspace.
+The inference path of ``VLAJEPAPolicy.predict_action_chunk`` never touches the JEPA
+world model (``video_encoder`` / ``video_predictor`` / ``video_processor``) and never
+touches the tied LM head: ``_qwen_last_decoder_hidden`` calls the inner
+``Qwen3VLModel`` directly and reads the last decoder block's pre-norm output.  The
+text embedding table is only ever indexed by the prompt token ids, which the frozen
+calibration already enumerates for all ten LIBERO-Spatial tasks.
+
+This module removes exactly those unused tensors in place, so the returned policy
+computes bit-identical actions to the untouched policy while holding much less
+resident memory.  No weights are quantised, pruned or otherwise altered.
 """
 
 from __future__ import annotations
 
+import torch
+from torch import nn
+from torch.nn import functional as F
+
+
+class _CompactEmbedding(nn.Module):
+    """Exact row lookup into the subset of the vocabulary the task can emit.
+
+    ``lookup`` maps every original token id to its compact row; ids outside the
+    calibrated set map to an appended zero row instead of raising, so an unexpected
+    token can never abort an episode.  The retained rows are the original bfloat16
+    rows, unchanged.
+    """
+
+    def __init__(self, source: nn.Embedding, token_ids: torch.Tensor) -> None:
+        super().__init__()
+        weight = source.weight.detach()
+        device = weight.device
+        ids = torch.unique(token_ids.to(device=device, dtype=torch.long)).sort().values
+        ids = ids[(ids >= 0) & (ids < source.num_embeddings)]
+        if ids.numel() == 0:
+            raise ValueError("calibration token_ids is empty")
+        lookup = torch.full(
+            (source.num_embeddings,), ids.numel(), dtype=torch.int32, device=device
+        )
+        lookup[ids] = torch.arange(ids.numel(), dtype=torch.int32, device=device)
+        self.register_buffer("lookup", lookup)
+        table = torch.cat(
+            [weight[ids].clone(), torch.zeros(1, weight.shape[1], dtype=weight.dtype, device=device)],
+            dim=0,
+        )
+        self.weight = nn.Parameter(table, requires_grad=False)
+        self.num_embeddings, self.embedding_dim = table.shape
+        self.padding_idx = None
+
+    def forward(self, ids: torch.Tensor) -> torch.Tensor:
+        return F.embedding(self.lookup[ids], self.weight)
+
+
+def _token_ids(policy: object, calibration: dict) -> torch.Tensor:
+    """Calibration ids plus every special/action id the model can put in a prompt."""
+    pieces = [calibration["token_ids"].detach().flatten().to(device="cpu", dtype=torch.long)]
+    model = policy.model
+    action_ids = getattr(model, "action_token_ids", None)
+    if action_ids:
+        pieces.append(torch.tensor(list(action_ids), dtype=torch.long))
+    embodied = getattr(model, "embodied_action_token_id", None)
+    if embodied is not None:
+        pieces.append(torch.tensor([embodied], dtype=torch.long))
+    buffered = getattr(model, "_action_token_ids_t", None)
+    if torch.is_tensor(buffered):
+        pieces.append(buffered.detach().flatten().to(device="cpu", dtype=torch.long))
+    tokenizer = getattr(getattr(model, "qwen", None), "processor", None)
+    tokenizer = getattr(tokenizer, "tokenizer", None)
+    special = getattr(tokenizer, "all_special_ids", None)
+    if special:
+        pieces.append(torch.tensor(list(special), dtype=torch.long))
+    return torch.cat(pieces)
+
 
 def compress(policy, calibration):
-    """Return a policy with less resident memory; the identity keeps the baseline."""
+    """Drop inference-dead world-model and LM-head tensors and compact the embedding."""
+    model = policy.model
+    qwen = model.qwen.model
+    language = qwen.model.language_model
+
+    # 1. The JEPA world model is training-only for this policy: predict_action never
+    #    calls it, and _prepare_model_inputs(training=False) does not assemble videos.
+    model.video_encoder = None
+    model.video_predictor = None
+    model.video_processor = None
+
+    # 2. The vocabulary table and the tied LM head.  The LM head is unused because the
+    #    policy reads the last decoder block directly; the embedding is only indexed by
+    #    the ten fixed LIBERO-Spatial prompts.  Replace the embedding first, then drop
+    #    the head so the shared full-size storage is released exactly once.
+    source = language.embed_tokens
+    language.embed_tokens = _CompactEmbedding(source, _token_ids(policy, calibration))
+    qwen.lm_head = nn.Identity()
+    # Keep any later tie_weights() call from trying to re-tie the now-absent head.
+    if hasattr(qwen, "_tied_weights_keys"):
+        qwen._tied_weights_keys = {}
+    if getattr(qwen, "config", None) is not None:
+        qwen.config.tie_word_embeddings = False
+
     return policy
