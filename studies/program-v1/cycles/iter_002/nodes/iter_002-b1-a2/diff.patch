+def _pack(q: np.ndarray, bits: int, signed: bool = True) -> bytes:
+    """Pack low-bit values (signed two's complement or unsigned indices) densely."""
+    u = q.astype(np.int16) + ((1 << (bits - 1)) if signed else 0)
+    u = u.astype(np.uint8).ravel()
+    if bits == 4:
+        if u.size % 2:
+            u = np.concatenate([u, np.zeros(1, dtype=np.uint8)])
+        return ((u[0::2] << 4) | u[1::2]).astype(np.uint8).tobytes()
+    if bits == 3:
+        pad = (-u.size) % 8
+        if pad:
+            u = np.concatenate([u, np.zeros(pad, dtype=np.uint8)])
+        v = u.reshape(-1, 8).astype(np.uint32)
+        packed = (
+            v[:, 0]
+            | (v[:, 1] << 3)
+            | (v[:, 2] << 6)
+            | (v[:, 3] << 9)
+            | (v[:, 4] << 12)
+            | (v[:, 5] << 15)
+            | (v[:, 6] << 18)
+            | (v[:, 7] << 21)
+        )
+        out = np.empty((packed.size, 3), dtype=np.uint8)
+        out[:, 0] = packed & 0xFF
+        out[:, 1] = (packed >> 8) & 0xFF
+        out[:, 2] = (packed >> 16) & 0xFF
+        return out.tobytes()
+    if bits == 2:
+        pad = (-u.size) % 4
+        if pad:
+            u = np.concatenate([u, np.zeros(pad, dtype=np.uint8)])
+        v = u.reshape(-1, 4).astype(np.uint8)
+        return ((v[:, 0] << 6) | (v[:, 1] << 4) | (v[:, 2] << 2) | v[:, 3]).astype(np.uint8).tobytes()
+    raise ValueError(bits)
+
+
+def _unpack(blob: bytes, bits: int, count: int, signed: bool = True) -> np.ndarray:
+    raw = np.frombuffer(blob, dtype=np.uint8)
+    if bits == 4:
+        out = np.empty(raw.size * 2, dtype=np.uint8)
+        out[0::2] = raw >> 4
+        out[1::2] = raw & 0x0F
+    elif bits == 3:
+        v = raw.reshape(-1, 3).astype(np.uint32)
+        packed = v[:, 0] | (v[:, 1] << 8) | (v[:, 2] << 16)
+        out = np.empty(packed.size * 8, dtype=np.uint8)
+        for i in range(8):
+            out[i::8] = (packed >> (3 * i)) & 0x07
+    elif bits == 2:
+        out = np.empty(raw.size * 4, dtype=np.uint8)
+        out[0::4] = raw >> 6
+        out[1::4] = (raw >> 4) & 0x03
+        out[2::4] = (raw >> 2) & 0x03
+        out[3::4] = raw & 0x03
+    else:
+        raise ValueError(bits)
+    if not signed:
+        return out[:count].astype(np.uint8)
+    return (out[:count].astype(np.int16) - (1 << (bits - 1))).astype(np.int8)
+
