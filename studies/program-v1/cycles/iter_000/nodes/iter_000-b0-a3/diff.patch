+def _pack_3bit(values):
+    """Pack eight 3-bit integers per row into three uint8 bytes (exact)."""
+    out_features, groups = values.shape
+    padded = (-groups) % 8
+    if padded:
+        values = F.pad(values, (0, padded))
+    v = values.to(torch.int16).reshape(out_features, -1, 8)
+    b0 = (v[..., 0] << 5) | (v[..., 1] << 2) | (v[..., 2] >> 1)
+    b1 = ((v[..., 2] & 1) << 7) | (v[..., 3] << 4) | (v[..., 4] << 1) | (v[..., 5] >> 2)
+    b2 = ((v[..., 5] & 3) << 6) | (v[..., 6] << 3) | v[..., 7]
+    return torch.stack((b0, b1, b2), dim=-1).reshape(out_features, -1).to(torch.uint8)
+
+
+def _unpack_3bit(packed, groups):
+    """Inverse of _pack_3bit; returns the first `groups` 3-bit values per row."""
+    out_features = packed.shape[0]
+    b = packed.reshape(out_features, -1, 3).to(torch.int16)
+    v0 = b[..., 0] >> 5
+    v1 = (b[..., 0] >> 2) & 7
+    v2 = ((b[..., 0] & 3) << 1) | (b[..., 1] >> 7)
+    v3 = (b[..., 1] >> 4) & 7
+    v4 = (b[..., 1] >> 1) & 7
+    v5 = ((b[..., 1] & 1) << 2) | (b[..., 2] >> 6)
+    v6 = (b[..., 2] >> 3) & 7
+    v7 = b[..., 2] & 7
+    return torch.stack((v0, v1, v2, v3, v4, v5, v6, v7), dim=-1).reshape(
+        out_features, -1
+    )[:, :groups]
+
