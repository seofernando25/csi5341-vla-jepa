 """Compression entry point for the VLA-JEPA B16 policy.
 
-compress(policy, calibration) receives the loaded policy (CUDA, bfloat16, eval mode, no
-gradients) and the frozen calibration dict. It must return an object that still exposes
-select_action and predict_action_chunk. Memory is measured on the returned object and on
-every tensor reachable from this module and from modules imported out of the workspace.
+The deployed inference path only uses the Qwen text/vision backbone and the action
+head.  The V-JEPA world-model encoder/predictor are training-only, the tied
+``lm_head`` is bypassed by ``_qwen_last_decoder_hidden``, and only the prompt token
+ids present in the frozen calibration vocabulary can ever reach ``embed_tokens``.
+Removing those three payloads is exact for this fixed LIBERO-Spatial policy.
 """
 
 from __future__ import annotations
 
+import torch
+import torch.nn.functional as F
+from torch import nn
+
+
+class CompactEmbedding(nn.Module):
+    """Embedding table restricted to token ids the frozen policy can actually receive."""
+
+    def __init__(self, source: nn.Embedding, token_ids: torch.Tensor) -> None:
+        super().__init__()
+        device = source.weight.device
+        ids = torch.unique(token_ids.to(device=device, dtype=torch.long))
+        if source.padding_idx is not None:
+            ids = torch.unique(
+                torch.cat([ids, torch.tensor([source.padding_idx], device=device, dtype=torch.long)])
+            )
+        ids = ids.sort().values
+        lookup = torch.full(
+            (source.num_embeddings,), -1, device=device, dtype=torch.long
+        )
+        lookup[ids] = torch.arange(len(ids), device=device, dtype=torch.long)
+        self.register_buffer("lookup", lookup)
+        self.weight = nn.Parameter(source.weight.detach()[ids].clone(), requires_grad=False)
+        self.num_embeddings, self.embedding_dim = self.weight.shape
+        self.padding_idx = None
+        if source.padding_idx is not None:
+            position = (ids == source.padding_idx).nonzero(as_tuple=True)[0]
+            if len(position):
+                self.padding_idx = int(position[0])
+
+    def forward(self, ids: torch.Tensor) -> torch.Tensor:
+        # The frozen LIBERO-Spatial prompt vocabulary is closed; an unseen id would be a
+        # harness change, and the lookup's -1 would make F.embedding fail loudly then.
+        return F.embedding(self.lookup[ids], self.weight, self.padding_idx)
+
 
 def compress(policy, calibration):
-    """Return a policy with less resident memory; the identity keeps the baseline."""
+    """Drop training-only / bypassed weights in place and compact the embedding table."""
+    model = policy.model
+
+    # V-JEPA world model is only consumed by the training loss; predict_action never
+    # touches it.  Clear the modules, not just their parameters, so no tensors remain.
+    model.video_encoder = None
+    model.video_predictor = None
+    model.video_processor = None
+
+    # The inner Qwen3VLModel is called directly, so the vocabulary output head is dead.
+    # It is tied to embed_tokens, so it must be dropped before the embedding is compacted.
+    qwen = model.qwen
+    qwen.model.lm_head = nn.Identity()
+
+    text = qwen.model.model.language_model
+    text.embed_tokens = CompactEmbedding(text.embed_tokens, calibration["token_ids"])
+
     return policy
