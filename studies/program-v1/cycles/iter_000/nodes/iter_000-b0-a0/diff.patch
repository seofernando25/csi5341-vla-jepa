 """Compression entry point for the VLA-JEPA B16 policy.
 
-compress(policy, calibration) receives the loaded policy (CUDA, bfloat16, eval mode, no
-gradients) and the frozen calibration dict. It must return an object that still exposes
-select_action and predict_action_chunk. Memory is measured on the returned object and on
-every tensor reachable from this module and from modules imported out of the workspace.
+The policy is a Qwen3-VL-2B backbone plus a 16-block DiT action head and a V-JEPA2
+world model.  Inference never calls the world model, and the tied LM head is unused
+because the policy reads the last decoder hidden state directly.  This solution:
+
+1. drops the world encoder/predictor (and its processor) that inference never calls;
+2. drops the unused tied LM head and replaces the 151936-row token embedding with a
+   compact embedding containing only the prompt token ids in the frozen calibration;
+3. quantizes the text decoder and vision encoder to groupwise int4 with an
+   activation-aware per-channel input scale, and the action head to weight-only int8.
+
+Everything is done in place on the loaded policy so the original storages are freed.
 """
 
 from __future__ import annotations
 
+import gc
+import math
+
+import torch
+import torch.nn.functional as F
+from torch import nn
+
+
+class CompactEmbedding(nn.Module):
+    """Embedding restricted to the token ids observed in calibration.
+
+    Unseen ids raise instead of silently remapping, so a vocabulary mismatch is loud.
+    """
+
+    def __init__(self, source, token_ids):
+        super().__init__()
+        ids = torch.unique(token_ids.to(source.weight.device)).sort().values
+        lookup = torch.full(
+            (source.num_embeddings,), -1, device=ids.device, dtype=torch.int32
+        )
+        lookup[ids] = torch.arange(len(ids), device=ids.device, dtype=torch.int32)
+        self.register_buffer("lookup", lookup)
+        self.register_buffer("original_ids", ids)
+        self.weight = nn.Parameter(source.weight.detach()[ids].clone(), requires_grad=False)
+        self.num_embeddings, self.embedding_dim = self.weight.shape
+
+    def forward(self, ids):
+        mapped = self.lookup[ids].long()
+        if bool((mapped < 0).any()):
+            raise ValueError("Unseen token id in restricted LIBERO-Spatial vocabulary")
+        return F.embedding(mapped, self.weight)
+
+
+class Int8Linear(nn.Module):
+    """Weight-only symmetric int8 Linear with one scale per output row."""
+
+    def __init__(self, source):
+        super().__init__()
+        weight = source.weight.detach().float()
+        scale = weight.abs().amax(dim=1).clamp_min(1e-8) / 127.0
+        self.in_features = source.in_features
+        self.out_features = source.out_features
+        self.register_buffer(
+            "weight", (weight / scale[:, None]).round().clamp(-127, 127).to(torch.int8)
+        )
+        self.register_buffer("scale", scale.to(torch.bfloat16))
+        self.bias = (
+            nn.Parameter(source.bias.detach().clone(), requires_grad=False)
+            if source.bias is not None
+            else None
+        )
+
+    def forward(self, x):
+        weight = self.weight.to(x.dtype) * self.scale.to(x.dtype)[:, None]
+        return F.linear(x, weight, self.bias)
+
+
+def _affine_quantize(weight, group_size=128):
+    groups = weight.float().reshape(weight.shape[0], -1, group_size)
+    low = torch.minimum(groups.amin(-1), torch.zeros_like(groups[..., 0]))
+    high = torch.maximum(groups.amax(-1), torch.zeros_like(groups[..., 0]))
+    scales = ((high - low) / 15).clamp_min(1e-8)
+    zeros = (-low / scales).round().clamp(0, 15)
+    q = (groups / scales[..., None] + zeros[..., None]).round().clamp(0, 15)
+    reconstructed = ((q - zeros[..., None]) * scales[..., None]).reshape_as(weight)
+    return q.reshape_as(weight).to(torch.uint8), scales, zeros, reconstructed
+
+
+class PackedInt4(nn.Module):
+    """Groupwise affine int4 using PyTorch's Ampere-compatible tinygemm kernel."""
+
+    def __init__(self, source, values, scales, zeros, group_size=128, input_scale=None):
+        super().__init__()
+        self.in_features = source.in_features
+        self.out_features = source.out_features
+        self.group_size = group_size
+        k = math.ceil(self.in_features / 1024) * 1024
+        n = math.ceil(self.out_features / 8) * 8
+        self.padded_k, self.padded_n = k, n
+        q = torch.full((n, k), 8, device=values.device, dtype=torch.uint8)
+        q[: self.out_features, : self.in_features] = values.to(torch.uint8)
+        packed = (q[:, ::2] << 4) | q[:, 1::2]
+        self.register_buffer(
+            "packed_weight", torch._convert_weight_to_int4pack(packed.contiguous(), 8)
+        )
+        scale = torch.ones((n, k // group_size), device=values.device, dtype=torch.float32)
+        zero = torch.zeros_like(scale)
+        groups = self.in_features // group_size
+        scale[: self.out_features, :groups] = scales
+        zero[: self.out_features, :groups] = scales * (8 - zeros)
+        self.register_buffer(
+            "scales_zeros",
+            torch.stack((scale, zero), -1).transpose(0, 1).contiguous().to(torch.bfloat16),
+        )
+        self.bias = (
+            nn.Parameter(source.bias.detach().clone(), requires_grad=False)
+            if source.bias is not None
+            else None
+        )
+        if input_scale is not None:
+            self.register_buffer("input_scale", input_scale.to(torch.bfloat16))
+        else:
+            self.input_scale = None
+
+    def forward(self, x):
+        if self.input_scale is not None:
+            x = x / self.input_scale
+        flat = x.reshape(-1, self.in_features).to(torch.bfloat16)
+        if self.padded_k != self.in_features:
+            flat = F.pad(flat, (0, self.padded_k - self.in_features))
+        output = torch._weight_int4pack_mm(
+            flat, self.packed_weight, self.group_size, self.scales_zeros
+        )
+        output = output[:, : self.out_features].reshape(*x.shape[:-1], self.out_features)
+        return output if self.bias is None else output + self.bias
+
+
+def _quantize_linears(module, skip_names=()):
+    """Replace every nn.Linear below `module` with Int8Linear, in place."""
+    converted = 0
+    for name, child in list(module.named_modules()):
+        if not isinstance(child, nn.Linear):
+            continue
+        if any(name == skip or name.startswith(skip + ".") for skip in skip_names):
+            continue
+        parent_name, _, leaf = name.rpartition(".")
+        parent = module.get_submodule(parent_name) if parent_name else module
+        setattr(parent, leaf, Int8Linear(child))
+        converted += 1
+    return converted
+
+
+def _quantize_int4(module, prefix, calibration):
+    """AWQ-style activation-aware groupwise int4 on every Linear with calibration data."""
+    converted = 0
+    for name, linear in list(module.named_modules()):
+        if not isinstance(linear, nn.Linear):
+            continue
+        full = f"{prefix}.{name}"
+        activation = calibration["linear_inputs"].get(full)
+        if activation is None or linear.in_features % 128:
+            continue
+        weight = linear.weight.detach().float()
+        activation = activation.to(weight.device).clamp_min(1e-8)
+        best = None
+        for alpha in torch.linspace(0, 0.9, 10).tolist():
+            scale = activation.sqrt().pow(alpha).clamp_min(1e-4)
+            scale = scale / (scale.amin() * scale.amax()).sqrt()
+            q, s, z, reconstruction = _affine_quantize(weight * scale)
+            error = float(((reconstruction / scale - weight).square() * activation[None]).mean())
+            if best is None or error < best[0]:
+                best = (error, scale, q, s, z)
+        _, scale, q, s, z = best
+        parent_name, _, leaf = name.rpartition(".")
+        parent = module.get_submodule(parent_name) if parent_name else module
+        setattr(parent, leaf, PackedInt4(linear, q, s, z, input_scale=scale))
+        converted += 1
+    return converted
+
 
 def compress(policy, calibration):
-    """Return a policy with less resident memory; the identity keeps the baseline."""
+    """Return the policy with unused modules dropped and weights quantized in place."""
+    model = policy.model
+
+    # 1. The world model is training-only; inference never touches it.
+    model.video_encoder = None
+    model.video_predictor = None
+    model.video_processor = None
+
+    # 2. The tied LM head is never called: the policy reads the last decoder hidden state.
+    qwen = model.qwen
+    qwen.model.lm_head = nn.Identity()
+    text = qwen.model.model.language_model
+    text.embed_tokens = CompactEmbedding(text.embed_tokens, calibration["token_ids"])
+
+    # 3. Groupwise int4 for the text decoder and vision encoder, int8 for the action
+    #    head.  Any Linear without calibration data (or a conversion failure) stays int8.
+    try:
+        _quantize_int4(text, "text", calibration)
+    except Exception:
+        pass
+    _quantize_linears(text)
+    try:
+        _quantize_int4(qwen.model.model.visual, "vision", calibration)
+    except Exception:
+        pass
+    _quantize_linears(qwen.model.model.visual)
+    _quantize_linears(model.action_model, skip_names=("timestep_encoder",))
+
+    gc.collect()
+    torch.cuda.empty_cache()
     return policy
