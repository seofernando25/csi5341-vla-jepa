+"""Local probe: compare stock, eager-graph and compiled-graph execution on bank frames."""
+
+from __future__ import annotations
+
+import argparse
+import statistics
+import time
+
+import torch
+
+from evaluation.models import load_policy
+from evaluation.pipeline import Pipeline, inference_autocast, observation_bank
+from fastpath_local import GraphedPolicy
+
+
+def main():
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--compile", action="store_true")
+    parser.add_argument("--instructions", type=int, default=2)
+    parser.add_argument("--calls", type=int, default=12)
+    args = parser.parse_args()
+
+    policy, _ = load_policy("B16")
+    bank = observation_bank()
+    pipeline = Pipeline(policy)
+    # 10 bank frames per task; use task 0 and task 1 frames for timing.
+    timing_indices = [1, 2, 3, 4, 5, 6, 13, 14, 15, 16, 17, 18]
+    instructions = []
+    for index in timing_indices:
+        instruction = bank[index]["instruction"]
+        if instruction not in instructions:
+            instructions.append(instruction)
+    instructions = instructions[: args.instructions]
+    print("instructions", len(instructions), flush=True)
+
+    # Stock reference actions on the same frames, before patching anything.
+    stock = {}
+    with torch.inference_mode(), inference_autocast():
+        for index in timing_indices:
+            policy.reset()
+            torch.manual_seed(1000 + index)
+            stock[index] = policy.predict_action_chunk(pipeline.sample(bank[index])).float().cpu()
+
+    graphed = GraphedPolicy(policy, use_compile=args.compile)
+    started = time.perf_counter()
+    captured = graphed.prewarm(instructions)
+    torch.cuda.synchronize()
+    print(
+        f"prewarm {len(captured)} plans in {time.perf_counter() - started:.1f} s; "
+        f"peak after prewarm {torch.cuda.max_memory_allocated() / 2**20:.0f} MiB",
+        flush=True,
+    )
+    policy.predict_action_chunk = graphed.predict_action_chunk
+
+    # Action agreement against stock on the same frames and seeds.
+    worst = 0.0
+    for index in timing_indices:
+        if bank[index]["instruction"] not in graphed.plans:
+            continue
+        with torch.inference_mode(), inference_autocast():
+            policy.reset()
+            torch.manual_seed(1000 + index)
+            got = policy.predict_action_chunk(pipeline.sample(bank[index])).float().cpu()
+        worst = max(worst, float((got - stock[index]).abs().max()))
+    print(f"max abs action difference vs stock: {worst:.6g}", flush=True)
+
+    # Timed select_action calls on the prewarmed instructions.
+    torch.cuda.synchronize()
+    torch.cuda.reset_peak_memory_stats()
+    times = []
+    with torch.inference_mode(), inference_autocast():
+        for index in timing_indices[: args.calls]:
+            if bank[index]["instruction"] not in graphed.plans:
+                continue
+            policy.reset()
+            torch.manual_seed(1000 + index)
+            torch.cuda.synchronize()
+            started = time.perf_counter()
+            action = policy.select_action(pipeline.sample(bank[index]))
+            float(action.float().sum().item())
+            torch.cuda.synchronize()
+            times.append((time.perf_counter() - started) * 1000)
+    print(
+        f"timed median {statistics.median(times):.2f} ms, "
+        f"peak {torch.cuda.max_memory_allocated() / 2**20:.0f} MiB, "
+        f"resident {torch.cuda.memory_reserved() / 2**20:.0f} MiB",
+        flush=True,
+    )
+    print("times", [round(value, 2) for value in times], flush=True)
+
+
+if __name__ == "__main__":
+    main()
