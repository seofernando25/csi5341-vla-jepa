+"""Fast bit-exactness check of the cached-K/V flow against the stock path."""
+
+import torch
+
+from evaluation.compression import calibration as calib
+from evaluation.models import load_policy
+from evaluation.pipeline import Pipeline, observation_bank
+
+import graphed
+
+
+def main():
+    calib.setup()
+    policy, _ = load_policy("B16")
+    bank = observation_bank()
+    pipeline = Pipeline(policy)
+    batches = [pipeline.sample(bank[i]) for i in (0, 1, 5, 9)]
+    with torch.inference_mode(), torch.autocast("cuda", dtype=torch.bfloat16):
+        reference = []
+        for batch in batches:
+            policy.reset()
+            torch.manual_seed(1000 + 0)
+            reference.append(policy.predict_action_chunk(batch).float().cpu())
+    for name in ("video_encoder", "video_predictor", "video_processor"):
+        setattr(policy.model, name, None)
+    g = graphed.attach(policy, cache_kv=True)
+    with torch.inference_mode(), torch.autocast("cuda", dtype=torch.bfloat16):
+        for index, batch in enumerate(batches):
+            policy.reset()
+            torch.manual_seed(1000 + 0)
+            got = policy.predict_action_chunk(batch).float().cpu()
+            print(index, float((got - reference[index]).abs().max()))
+    print("plans", len(g.plans))
+
+
+if __name__ == "__main__":
+    main()
