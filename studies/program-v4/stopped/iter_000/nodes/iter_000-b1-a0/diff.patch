+"""Profile the stock VLA-JEPA policy: component latency, prompt shapes, memory."""
+from __future__ import annotations
+
+import gc
+import json
+import statistics
+import time
+
+import torch
+
+from evaluation.compression import calibration as calib
+from evaluation.models import load_policy
+from evaluation.pipeline import Pipeline, inference_autocast, observation_bank
+
+
+def sync():
+    torch.cuda.synchronize()
+
+
+def bench(fn, warm=3, n=10):
+    for _ in range(warm):
+        fn()
+    sync()
+    times = []
+    for _ in range(n):
+        sync()
+        t0 = time.perf_counter()
+        out = fn()
+        sync()
+        times.append((time.perf_counter() - t0) * 1000)
+    return times, out
+
+
+def main():
+    calib.setup()
+    bank = observation_bank()
+    print("bank", len(bank), "tasks", sorted({b["task_id"] for b in bank}))
+    policy, meta = load_policy("B16")
+    print("loaded", meta["logical_parameters"], meta["num_inference_timesteps"])
+    pipeline = Pipeline(policy)
+    batches = [pipeline.sample(bank[i]) for i in range(20)]
+    instructions = [b["task"][0] for b in batches]
+    print("instructions", json.dumps(instructions, indent=0))
+
+    # Prompt shapes for every bank instruction.
+    model = policy.model
+    qwen = model.qwen
+    shapes = {}
+    with torch.inference_mode(), inference_autocast():
+        for i, batch in enumerate(batches):
+            inputs = policy._prepare_model_inputs(batch, training=False)
+            q = qwen.build_inputs(
+                [inputs["images"][0]], [inputs["instructions"][0]],
+                model.replace_prompt, model.embodied_replace_prompt,
+            )
+            key = (tuple(q["input_ids"].shape), int(q["image_grid_thw"].prod()))
+            shapes.setdefault(key, []).append(i)
+    print("prompt shapes", {str(k): v for k, v in shapes.items()})
+
+    batch = batches[0]
+    with torch.inference_mode(), inference_autocast():
+        policy.reset()
+        torch.manual_seed(1000)
+        full_times, _ = bench(lambda: policy.predict_action_chunk(batch))
+        print("full predict_action_chunk ms", [round(x, 2) for x in full_times],
+              "median", round(statistics.median(full_times), 2))
+
+        inputs = policy._prepare_model_inputs(batch, training=False)
+        def encode():
+            return model._encode_qwen(inputs["images"], inputs["instructions"], need_action_tokens=False)
+        enc_times, (tokens, _) = bench(encode)
+        print("encode_qwen ms", [round(x, 2) for x in enc_times],
+              "median", round(statistics.median(enc_times), 2), "tokens", tuple(tokens.shape))
+
+        state = inputs["state"]
+        def head():
+            return model.action_model.predict_action(tokens.float(), state.float())
+        head_times, _ = bench(head)
+        print("action_head ms", [round(x, 2) for x in head_times],
+              "median", round(statistics.median(head_times), 2))
+
+        def prep():
+            return policy._prepare_model_inputs(batch, training=False)
+        prep_times, _ = bench(prep)
+        print("prepare ms", [round(x, 2) for x in prep_times],
+              "median", round(statistics.median(prep_times), 2))
+
+        # Flow loop with prebuilt inputs, one step at a time.
+        headmod = model.action_model
+        actions = torch.randn(1, headmod.action_horizon, headmod.config.action_dim,
+                              dtype=tokens.dtype, device=tokens.device)
+        def one_step(step):
+            value = int(step / 4 * headmod.config.action_num_timestep_buckets)
+            ts = torch.full((1,), value, device=tokens.device, dtype=torch.long)
+            hidden = headmod._build_inputs(actions, state.float(), ts)
+            pred = headmod.model(hidden_states=hidden, encoder_hidden_states=tokens.float(), timestep=ts)
+            return actions + 0.25 * headmod.action_decoder(pred[:, -headmod.action_horizon:])
+        step_times, _ = bench(lambda: [one_step(s) for s in range(4)], warm=3, n=10)
+        print("4 flow steps ms", [round(x, 2) for x in step_times],
+              "median", round(statistics.median(step_times), 2))
+
+    print("peak allocated", torch.cuda.max_memory_allocated())
+    print("peak reserved", torch.cuda.max_memory_reserved())
+
+
+if __name__ == "__main__":
+    main()
