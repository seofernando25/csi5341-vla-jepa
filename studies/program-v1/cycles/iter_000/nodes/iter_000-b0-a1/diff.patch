+class PackedInt3(nn.Module):
+    """Groupwise affine int3 with real 3-bit packing, dequantized per forward.
 
+    Eight consecutive input columns are packed into three uint8 bytes.  The kernel is
+    an unpack + bf16 matmul; latency is higher than the int4 tinygemm kernel but the
+    stored weight is 3/8 byte per parameter.
