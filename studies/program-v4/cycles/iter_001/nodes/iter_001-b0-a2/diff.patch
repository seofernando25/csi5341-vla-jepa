+"""Timing breakdown, direct select override, equivalence shapes, and kernel profile."""
+
+from __future__ import annotations
+
+import statistics
+import time
+
+import torch
+
+from evaluation.compression import calibration as calib
+from evaluation.compression.latency_guards import equivalence
+from evaluation.compression.latency_timing import Limits
+from evaluation.models import load_policy
+from evaluation.pipeline import Pipeline, observation_bank
+from fastpath import GraphedPolicy
+
+
+def timed(fn, count=30, warm=5):
+    for _ in range(warm):
+        fn()
+    torch.cuda.synchronize()
+    wall = []
+    gpu = []
+    for _ in range(count):
+        start = torch.cuda.Event(enable_timing=True)
+        end = torch.cuda.Event(enable_timing=True)
+        torch.cuda.synchronize()
+        start.record()
+        t0 = time.perf_counter_ns()
+        fn()
+        torch.cuda.synchronize()
+        wall.append((time.perf_counter_ns() - t0) / 1e6)
+        end.record()
+        torch.cuda.synchronize()
+        gpu.append(start.elapsed_time(end))
+    return round(statistics.median(wall), 3), round(statistics.median(gpu), 3)
+
+
+def main():
+    calib.setup()
+    torch.manual_seed(0)
+    bank = observation_bank()
+    policy, _ = load_policy("B16")
+    pipeline = Pipeline(policy)
+    sample = bank[3]
+    batch = pipeline.sample(sample)
+    instruction = batch["task"][0]
+
+    model = policy.model
+    model.video_encoder = None
+    model.video_predictor = None
+    model.video_processor = None
+    policy.model.qwen.model.lm_head = torch.nn.Identity()
+    model.action_model.num_inference_timesteps = 2
+
+    graphed = GraphedPolicy(policy, use_compile=True, dense=True)
+    policy.predict_action_chunk = graphed.predict_action_chunk
+    policy.graphed = graphed
+
+    def select():
+        policy.reset()
+        torch.manual_seed(1000)
+        return policy.select_action(batch)
+
+    def chunk():
+        policy.reset()
+        torch.manual_seed(1000)
+        return policy.predict_action_chunk(batch)
+
+    def direct():
+        policy.reset()
+        torch.manual_seed(1000)
+        return policy.predict_action_chunk(batch)[:, 0]
+
+    chunk()
+    plan = graphed.plans[instruction]
+    print("plan images", tuple(plan.images.shape), plan.images.dtype)
+    print("select_action  wall/gpu", timed(select))
+    print("predict_chunk  wall/gpu", timed(chunk))
+    print("direct_select  wall/gpu", timed(direct))
+
+    with torch.inference_mode():
+        inputs = policy._prepare_model_inputs(batch, training=False)
+        images, state = inputs["images"][0], inputs["state"]
+
+        def copies():
+            plan.images.copy_(torch.stack(images))
+            plan.state.copy_(state)
+            plan.noise.copy_(
+                torch.randn(1, plan.noise.shape[1], plan.noise.shape[2], dtype=torch.float32, device=plan.noise.device)
+            )
+
+        print("copies+noise   wall/gpu", timed(copies))
+
+    # Equivalence check on three bank frames of task 0 (same call shape as the evaluator).
+    import json
+
+    with open("/tmp/repo/studies/program-v4/protocol.json", encoding="utf-8") as handle:
+        protocol = json.load(handle)
+    limits = Limits.from_protocol(protocol, "check")
+    frames = [pipeline.sample(bank[i]) for i in range(3)]
+    eq = equivalence(policy, frames, limits, 1000)
+    print("equivalence", {k: v for k, v in eq.items() if k != "violations"}, eq["violations"])
+    first = policy.select_action(frames[0])
+    chunk_value = policy.predict_action_chunk(frames[0])
+    print("select shape", tuple(first.shape), "chunk shape", tuple(chunk_value.shape))
+
+    # Kernel profile of one replay.
+    with torch.inference_mode():
+        for _ in range(3):
+            plan.graph.replay()
+        torch.cuda.synchronize()
+        from torch.profiler import ProfilerActivity, profile
+
+        with profile(activities=[ProfilerActivity.CUDA]) as prof:
+            for _ in range(5):
+                plan.graph.replay()
+            torch.cuda.synchronize()
+    rows = []
+    for event in prof.key_averages():
+        if event.device_time_total > 0:
+            rows.append((event.device_time_total / 5.0, event.key, event.count // 5))
+    rows.sort(reverse=True)
+    print("top kernels (us per replay):")
+    for us, key, count in rows[:25]:
+        print(f"  {us:9.1f}  x{count:<4d} {key[:90]}")
+
+
+if __name__ == "__main__":
+    main()
