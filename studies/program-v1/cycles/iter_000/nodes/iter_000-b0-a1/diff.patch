+    def __init__(self, source, values, scales, zeros, group_size=128, input_scale=None):
+        super().__init__()
+        self.in_features = source.in_features
+        self.out_features = source.out_features
+        self.group_size = group_size
+        q = values.to(torch.uint8).reshape(self.out_features, self.in_features // 8, 8)
+        q0, q1, q2, q3, q4, q5, q6, q7 = (q[..., i].to(torch.int16) for i in range(8))
+        b0 = (q0 << 5) | (q1 << 2) | (q2 >> 1)
+        b1 = ((q2 & 1) << 7) | (q3 << 4) | (q4 << 1) | (q5 >> 2)
+        b2 = ((q5 & 3) << 6) | (q6 << 3) | q7
+        packed = torch.stack((b0, b1, b2), dim=-1).reshape(
+            self.out_features, self.in_features * 3 // 8
+        )
+        self.register_buffer("packed_weight", packed.to(torch.uint8).contiguous())
+        self.register_buffer("scales", scales.to(torch.bfloat16))
+        self.register_buffer("zeros", zeros.to(torch.bfloat16))
+        self.bias = (
+            nn.Parameter(source.bias.detach().clone(), requires_grad=False)
+            if source.bias is not None
+            else None
+        )
+        if input_scale is not None:
+            self.register_buffer("input_scale", input_scale.to(torch.bfloat16))
+        else:
+            self.input_scale = None
+
+    def _unpack(self):
+        b = self.packed_weight.reshape(self.out_features, self.in_features // 8, 3)
+        b0 = b[..., 0].to(torch.int16)
+        b1 = b[..., 1].to(torch.int16)
+        b2 = b[..., 2].to(torch.int16)
+        q0 = b0 >> 5
+        q1 = (b0 >> 2) & 7
+        q2 = ((b0 & 3) << 1) | (b1 >> 7)
+        q3 = (b1 >> 4) & 7
+        q4 = (b1 >> 1) & 7
+        q5 = ((b1 & 1) << 2) | (b2 >> 6)
+        q6 = (b2 >> 3) & 7
+        q7 = b2 & 7
+        return torch.stack((q0, q1, q2, q3, q4, q5, q6, q7), dim=-1).reshape(
+            self.out_features, self.in_features
+        )
