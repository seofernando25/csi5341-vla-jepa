+class PackedLinear(nn.Module):
+    """Weight-only uniform 2/3-bit Linear with one bf16 scale per 64 input channels.
+
+    The weight is stored as ``bits`` bit-planes over groups of eight values, so a 3-bit
+    weight costs 3/8 byte plus 2/64 byte of scale.  The forward dequantizes one output-row
+    chunk at a time to keep the temporary small.
+    """
+
+    def __init__(
+        self, in_features: int, out_features: int, bias: bool = True, bits: int = 3,
+        group_size: int = 64,
+    ) -> None:
+        super().__init__()
+        self.in_features = in_features
+        self.out_features = out_features
+        self.bits = bits
+        self.group_size = group_size
+        pad_unit = group_size * 8
+        self.padded_in = ((in_features + pad_unit - 1) // pad_unit) * pad_unit
+        self.n_groups = self.padded_in // group_size
+        self.n_bytes = self.padded_in // 8
+        self.levels = 1 << bits
+        self.step = 2.0 / (self.levels - 1)
+        device = torch.device("cuda")
+        self.register_buffer(
+            "qweight",
+            torch.zeros(bits, out_features, self.n_bytes, dtype=torch.uint8, device=device),
+            persistent=False,
+        )
+        self.register_buffer(
+            "scales",
+            torch.zeros(out_features, self.n_groups, dtype=torch.bfloat16, device=device),
+            persistent=False,
+        )
+        self.register_buffer(
+            "shifts",
+            torch.arange(8, dtype=torch.uint8, device=device),
+            persistent=False,
+        )
+        if bias:
+            self.bias = nn.Parameter(
+                torch.zeros(out_features, dtype=torch.bfloat16, device=device),
+                requires_grad=False,
+            )
+        else:
+            self.register_parameter("bias", None)
+
+    @classmethod
+    def from_linear(cls, linear: nn.Linear, bits: int = 3, group_size: int = 64):
+        module = cls(
+            linear.in_features, linear.out_features, linear.bias is not None, bits, group_size
+        )
+        device = linear.weight.device
+        weight = linear.weight.detach().to(device=device, dtype=torch.float32)
+        out_features, in_features = weight.shape
+        if module.padded_in > in_features:
+            weight = F.pad(weight, (0, module.padded_in - in_features))
+        groups = weight.reshape(out_features, module.n_groups, group_size)
+        scale = groups.abs().amax(-1, keepdim=True).clamp_min(1e-8)
+        levels, step = module.levels, module.step
+        for _ in range(2):
+            index = torch.round((groups / scale + 1.0) / step).clamp(0, levels - 1)
+            level = index * step - 1.0
+            numerator = (groups * level).sum(-1, keepdim=True)
+            denominator = (level * level).sum(-1, keepdim=True).clamp_min(1e-8)
+            scale = (numerator / denominator).clamp_min(1e-8)
+        index = (
+            torch.round((groups / scale + 1.0) / step).clamp(0, levels - 1).to(torch.uint8)
+        )
+        codes = index.reshape(out_features, module.padded_in)
+        bytes_view = codes.reshape(out_features, module.n_bytes, 8)
+        powers = (1 << torch.arange(8, device=device, dtype=torch.int64)).to(torch.uint8)
+        planes = []
+        for bit in range(bits):
+            plane = ((bytes_view >> bit) & 1).to(torch.uint8)
+            planes.append((plane * powers).sum(-1).to(torch.uint8))
+        module.qweight.copy_(torch.stack(planes, 0))
+        module.scales.copy_(scale.squeeze(-1).to(torch.bfloat16))
+        if linear.bias is not None:
+            module.bias.data.copy_(linear.bias.detach().to(device=device, dtype=torch.bfloat16))
+        return module
+
+    def _dequantize(self) -> torch.Tensor:
+        out_features = self.out_features
+        weight = torch.empty(
+            out_features, self.padded_in, dtype=torch.bfloat16, device=self.qweight.device
+        )
+        shifts = self.shifts
+        chunk = 512
+        for start in range(0, out_features, chunk):
+            end = min(start + chunk, out_features)
+            packed = self.qweight[:, start:end]
+            codes = (packed[0].unsqueeze(-1) >> shifts) & 1
+            for bit in range(1, self.bits):
+                codes = codes | (((packed[bit].unsqueeze(-1) >> shifts) & 1) << bit)
+            codes = codes.reshape(end - start, self.padded_in)
+            level = codes.to(torch.bfloat16) * self.step - 1.0
+            scale = self.scales[start:end].unsqueeze(-1)
+            weight[start:end] = (
+                level.reshape(end - start, self.n_groups, self.group_size) * scale
+            ).reshape(end - start, self.padded_in)
+        return weight[:, : self.in_features]
+
+    def forward(self, inputs: torch.Tensor) -> torch.Tensor:
+        return F.linear(inputs, self._dequantize(), self.bias)
+
