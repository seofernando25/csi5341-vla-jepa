+
+_META_TYPE = {
+    "scale": torch.Tensor,
+    "zero": torch.Tensor,
+    "zero_scale": torch.Tensor,
+    "compute_dtype": torch.dtype,
+    "quant_zero": bool,
+    "quant_scale": bool,
+    "view_as_float": bool,
+    "unpack_view_dtype": torch.dtype,
+    "packing": str,
+    "axis": int,
+    "group_size": int,
+    "nbits": int,
+    "shape": torch.Size,
+    "channel_wise": bool,
+    "optimize": bool,
+    "round_zero": bool,
