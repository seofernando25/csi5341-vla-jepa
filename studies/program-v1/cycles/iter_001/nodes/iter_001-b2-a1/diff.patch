+                        (self.meta["zero"], self.meta["scale"])
+                    ).to(self.compute_dtype)
+                    del self.meta["scale"], self.meta["zero"]
+
+            self.meta["zero_scale"] = (
+                self.meta["zero_scale"].contiguous().cpu().pin_memory()
+            )
