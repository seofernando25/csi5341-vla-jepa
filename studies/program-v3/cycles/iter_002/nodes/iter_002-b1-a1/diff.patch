 The published policy is loaded in bfloat16 on CUDA.  ``compress`` removes the training-only
 world model, compacts the tied Qwen input embedding to the fixed LIBERO prompts, drops the
-lowest-influence text decoder block, and replaces the large Linear leaves with bitsandbytes
-Q8/Q4 modules.  Q4 is used only for MLP weights and is preceded by activation-aware
-per-input-channel scaling derived from the calibration ``linear_inputs``.
+lowest-influence text decoder block, drops two nearly inert action-head DiT blocks, shrinks
+the action position table to the rows inference uses, and replaces the large Linear leaves
+with bitsandbytes NF4 modules.  NF4 is preceded by activation-aware per-input-channel scaling
+derived from the calibration ``linear_inputs``.
 """
 
 from __future__ import annotations
@@ -38,6 +39,7 @@ VISION_MLP_BITS = 4
 ACTION_BITS = 4
 AWQ_ALPHA = 0.5
 DROP_TEXT_BLOCKS = (3,)
+DROP_ACTION_BLOCKS = (7, 9)
 MIN_ACTION_WEIGHTS = 500_000
 
 
@@ -234,6 +236,21 @@ def compress(policy, calibration):
         min_weights=MIN_ACTION_WEIGHTS,
     )
 
+    keep = [
+        block
+        for index, block in enumerate(model.action_model.model.transformer_blocks)
+        if index not in DROP_ACTION_BLOCKS
+    ]
+    model.action_model.model.transformer_blocks = nn.ModuleList(keep)
+    del keep
+
+    # The action head only indexes the first chunk_size rows of its 1024-row position table.
+    old_position = model.action_model.position_embedding
+    compact_position = nn.Embedding(8, old_position.embedding_dim, device=old_position.weight.device, dtype=old_position.weight.dtype)
+    compact_position.weight.data.copy_(old_position.weight.data[:8])
+    model.action_model.position_embedding = compact_position
+    del old_position
+
     gc.collect()
     torch.cuda.empty_cache()
     return policy
